# bench is the support the benchmark programs share: the percentile rule of
# the method volume and the sorting it needs.
#
# The rule is the nearest rank: the sample at ceil(count * num / den) of the
# ascending samples, counted from one. The C support applies the same rule,
# so the two sides of a scenario report the same numbers.
#
# The value read from the array is assigned to a variable that is declared
# first, because a declaration that reads an index borrows the array until
# the end of the block.

# Swap exchanges two elements of one array.
def swap(xs: mut Array<u64>, left: i32, right: i32) {
    var leftValue: u64 = 0u64
    var rightValue: u64 = 0u64
    leftValue = xs[usize(left)]
    rightValue = xs[usize(right)]
    xs[usize(left)] = rightValue
    xs[usize(right)] = leftValue
}

# Sift restores the max-heap property below root.
def sift(xs: mut Array<u64>, root: i32, count: i32) {
    var at: i32 = root
    while True {
        var child: i32 = 2i32 * at + 1i32
        if child >= count {
            break
        }
        var leftValue: u64 = 0u64
        var rightValue: u64 = 0u64
        var atValue: u64 = 0u64
        var childValue: u64 = 0u64
        if child + 1i32 < count {
            leftValue = xs[usize(child)]
            rightValue = xs[usize(child + 1i32)]
            if leftValue < rightValue {
                child += 1i32
            }
        }
        atValue = xs[usize(at)]
        childValue = xs[usize(child)]
        if atValue >= childValue {
            break
        }
        swap(xs, at, child)
        at = child
    }
}

# SortSamples sorts the samples in ascending order with an in-place heapsort.
def sort_samples(xs: mut Array<u64>) {
    var n: i32 = i32(xs.len())
    var i: i32 = n / 2i32 - 1i32
    while True {
        if i < 0 {
            break
        }
        sift(xs, i, n)
        i -= 1i32
    }
    var end: i32 = n - 1i32
    while True {
        if end <= 0 {
            break
        }
        swap(xs, 0i32, end)
        sift(xs, 0i32, end)
        end -= 1i32
    }
}

# Percentile returns the nearest rank percentile of ascending samples.
def percentile(xs: Array<u64>, num: i64, den: i64) -> u64 {
    var count: i64 = i64(xs.len())
    if count == 0i64 {
        return 0u64
    }
    var rank: i64 = (count * num + den - 1i64) / den
    if rank < 1i64 {
        rank = 1i64
    }
    if rank > count {
        rank = count
    }
    var index: i64 = rank - 1i64
    return xs[usize(index)]
}

# Max returns the largest sample.
def max(xs: Array<u64>) -> u64 {
    var out: u64 = 0u64
    for x in xs {
        if x > out {
            out = x
        }
    }
    return out
}
