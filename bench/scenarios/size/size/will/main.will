import c "bench_clock.h" {
    bench_now_ns
    bench_rss_bytes
    bench_sink
}

# The program does nothing, so the tool measures the size of the executable.
# The metric line keeps the shape of the other scenarios.
def main() -> i32 {
    var start: u64 = c.bench_now_ns()
    var stop: u64 = c.bench_now_ns()
    c.bench_sink(stop - start)
    print("bench metric empty 1 program\n")
    return 0
}
