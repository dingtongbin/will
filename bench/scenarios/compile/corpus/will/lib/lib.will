# The library is the part of the compile corpus that lives in another
# package. The corpus measures the time the compiler needs, so the code
# has to be ordinary code of a few hundred lines.

# Count counts the values that are not negative.
def count(values: list[i64]) -> i64 {
    var total: i64 = 0i64
    for v in values {
        if v >= 0i64 {
            total += 1i64
        }
    }
    return total
}

# Sum adds the values.
def sum(values: list[i64]) -> i64 {
    var total: i64 = 0i64
    for v in values {
        total += v
    }
    return total
}

# Max returns the largest value, or zero for an empty slice.
def max(values: list[i64]) -> i64 {
    var best: i64 = 0i64
    var first: bool = True
    for v in values {
        if first or v > best {
            best = v
            first = False
        }
    }
    return best
}

# Min returns the smallest value, or zero for an empty slice.
def min(values: list[i64]) -> i64 {
    var best: i64 = 0i64
    var first: bool = True
    for v in values {
        if first or v < best {
            best = v
            first = False
        }
    }
    return best
}

# Mean returns the mean of the values, or zero for an empty slice.
def mean(values: list[i64]) -> i64 {
    if values.len() == 0usize {
        return 0i64
    }
    return sum(values) / i64(values.len())
}

# Histogram counts how many values fall into each bucket of the given width.
def histogram(values: list[i64], width: i64) -> list[i64] {
    var buckets: list[i64] = list[i64](0)
    if width <= 0i64 {
        return buckets
    }
    for v in values {
        var bucket: i64 = v / width
        if bucket < 0i64 {
            bucket = -bucket
        }
        var index: i32 = i32(bucket)
        var filled: i32 = i32(buckets.len())
        while True {
            if filled > index {
                break
            }
            buckets.push(0i64)
            filled += 1
        }
        var count: i64 = 0i64
        count = buckets[usize(index)]
        buckets.set(usize(index), count + 1i64)
    }
    return buckets
}

# Rolling returns the mean of every window of the given size.
def rolling(values: list[i64], size: i32) -> list[i64] {
    var out: list[i64] = list[i64](0)
    if size <= 0 {
        return out
    }
    var total: i64 = 0i64
    var index: i32 = 0
    for v in values {
        total += v
        index += 1
        if index > size {
            var old: i64 = 0i64
            old = values[usize(index - size - 1)]
            total -= old
        }
        if index >= size {
            out.push(total / i64(size))
        }
    }
    return out
}
