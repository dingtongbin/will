import "std/time"

struct Box {
    value: i64
}

# Consume runs as a state machine, so its capture goes through the async
# constructor and the crossing must share the handle there.
async def consume(b: rc<Box>) -> i64 {
    _ = await time.sleep(1ms)!
    return b.value
}

# MakeSlow returns an owned handle from a state machine, so the result copy
# crosses to the joiner through the task result.
async def make_slow() -> rc<Box> {
    _ = await time.sleep(1ms)!
    return new rc<Box>(Box { value: 5 })
}

# Pass runs as a plain spawn step; its capture shares in the spawn frame.
def pass(b: rc<Box>) -> i64 {
    return b.value
}

async def main() -> i32 {
    var box: rc<Box> = new rc<Box>(Box { value: 7 })
    region {
        var task: Task<i64> = spawn consume(box)
        if await task.join()! != 7i64 {
            return 1
        }
    }
    region {
        var maker: Task<rc<Box>> = spawn make_slow()
        var got: rc<Box> = await maker.join()!
        if got.value != 5i64 {
            return 2
        }
    }
    region {
        var other: Task<i64> = spawn pass(box)
        if await other.join()! != 7i64 {
            return 3
        }
    }
    var pipe: chan<rc<Box>> = new chan<rc<Box>>(4)
    var sent: Result<(), Error> = await pipe.send(box)
    match sent {
        Err(_) => {
            return 4
        }
        _ => {}
    }
    var taken: Option<rc<Box>> = await pipe.recv()
    match taken {
        Some(b) => {
            if b.value != 7i64 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    return 0
}
