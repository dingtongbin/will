import "std/os/exec"

async def run(cmd: exec.Cmd) -> Result<exec.ExitStatus, Error> {
    var status: Result<exec.ExitStatus, Error> = await cmd.async_run()
    return status
}

async def main() -> i32 {
    var code: i32 = 1
    region {
        var task: Task<Result<exec.ExitStatus, Error>> =
            spawn run(exec.command("cmd", "/C", "exit 3"))
        var status: Result<exec.ExitStatus, Error> = await task.join()!
        match status {
            Ok(value) => {
                if value.code == 3 {
                    code = 0
                }
            }
            Err(_) => {}
        }
    }
    return code
}
