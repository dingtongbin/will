import "std/os/exec"

async func Run(cmd: exec.Cmd) -> Result<exec.ExitStatus, Error> {
    var status: Result<exec.ExitStatus, Error> = await cmd.AsyncRun()
    return status
}

func main() -> i32 {
    var code: i32 = 1
    region {
        var task: Task<Result<exec.ExitStatus, Error>> =
            spawn Run(exec.Command("cmd", "/C", "exit 3"))
        var status: Result<exec.ExitStatus, Error> = task.Join()!
        match status {
            Ok(value) => {
                if value.code == 3 {
                    code = 0
                }
            }
            Err(_) => {}
        }
    }
    return code
}
