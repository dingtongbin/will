import "std/time"

# Slow suspends inside a generic body that also names another package, so the
# instance document must carry the import and the mark must see the clone.
async def slow<T>(v: T) -> T {
    _ = await time.sleep(1ms)!
    return v
}

async def main() -> i32 {
    var v: i64 = await slow(9i64)
    if v != 9i64 {
        return 1
    }
    region {
        var t: Task<i64> = spawn slow(4i64)
        if await t! != 4i64 {
            return 2
        }
    }
    var s: str = await slow("ok")
    if s != "ok" {
        return 3
    }
    return 0
}
