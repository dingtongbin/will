import "std/sync"

struct Counter {
    n: i32
}

# Bump takes the write side, changes the value, and lets the guard release at
# the return. Two of these run at the same time.
async def bump(m: sync.Mutex<Counter>) -> i32 {
    var g: sync.Guard<Counter> = await m.lock()
    g.n += 1
    return g.n
}

# WaitFor takes the write side only after the caller's guard is gone.
async def wait_for(m: sync.Mutex<Counter>, entered: chan<i32>) -> i32 {
    _ = await entered.send(1)
    var g: sync.Guard<Counter> = await m.lock()
    g.n += 10
    return g.n
}

async def main() -> i32 {
    var m: sync.Mutex<Counter> = new sync.Mutex<Counter>(Counter { n: 0 })
    region {
        var t1: Task<i32> = spawn bump(m)
        var t2: Task<i32> = spawn bump(m)
        _ = await t1!
        _ = await t2!
    }
    var two: i32 = 0
    if True {
        var g: sync.Guard<Counter> = m.try_lock()!
        two = g.n
    }
    if two != 2 {
        return 1
    }

    var entered: chan<i32> = new chan<i32>(1)
    region {
        var waiter: Task<i32>
        if True {
            var g: sync.Guard<Counter> = m.try_lock()!
            g.n += 100
            waiter = spawn wait_for(m, entered)
        }
        _ = await entered.recv()!
        _ = await waiter!
    }
    var after: i32 = 0
    if True {
        var g: sync.Guard<Counter> = m.try_lock()!
        after = g.n
    }
    if after != 112 {
        return 3
    }

    var rw: sync.RwLock<Counter> = new sync.RwLock<Counter>(Counter { n: 0 })
    var shared: i32 = 0
    if True {
        var r1: sync.ReadGuard<Counter> = rw.try_rlock()!
        var r2: sync.ReadGuard<Counter> = rw.try_rlock()!
        shared = r1.n + r2.n
        if rw.try_wlock().is_some() {
            return 4
        }
    }
    if shared != 0 {
        return 5
    }
    var exclusive: i32 = 0
    if True {
        var w: sync.Guard<Counter> = rw.try_wlock()!
        w.n = 7
        exclusive = w.n
    }
    if exclusive != 7 {
        return 6
    }
    var final: i32 = 0
    if True {
        var r: sync.ReadGuard<Counter> = rw.try_rlock()!
        final = r.n
    }
    if final != 7 {
        return 7
    }
    return 0
}
