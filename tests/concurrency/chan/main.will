async def Producer(ch: chan<i32>) {
    _ = await ch.Send(7)
    ch.Close()
}

async def main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1)
    var value: i32 = 0
    region {
        var task: Task<()> = spawn Producer(ch)
        var item: Option<i32> = await ch.Recv()
        match item {
            Some(v) => {
                value = v
            }
            None => {
                return 1
            }
        }
        _ = await task.Join()!
    }
    return value - 7
}
