import "std/os/fs"

async func ReadFile(path: str) -> Result<usize, Error> {
    var bytes: Array<u8> = await fs.AsyncReadFile(path)?
    return Ok(bytes.Len())
}

async func main() -> i32 {
    var path: str = "will-concurrency-async.tmp"
    var text: str = "worker"
    var written: Result<(), Error> = fs.WriteFile(path, text[Range(0, 6)])
    match written {
        Err(_) => {
            return 1
        }
        _ => {}
    }
    var size: usize = 0
    region {
        var task: Task<Result<usize, Error>> = spawn ReadFile(path)
        size = await task.Join()!!
    }
    _ = fs.Remove(path)
    if size != 6usize {
        return 2
    }
    return 0
}
