import "std/os/fs"
import "std/time"

async def fill(path: str) -> Result<(), Error> {
    var one: str = "a"
    _ = await fs.write_file(path, one[Range(0, 1)])?
    _ = await time.sleep(1ms)!
    _ = await fs.append(path, one[Range(0, 1)])?
    return Ok(())
}

async def main() -> i32 {
    var path: str = "will-concurrency-multiasync.tmp"
    var result: Result<(), Error> = Ok(())
    region {
        var task: Task<Result<(), Error>> = spawn fill(path.clone())
        result = await task!
    }
    if result.is_err() {
        _ = await fs.remove(path)
        return 1
    }
    var loaded: Result<list[u8], Error> = await fs.read_file(path)
    _ = await fs.remove(path)
    match loaded {
        Ok(bytes) => {
            if bytes.len() != 2usize {
                return 2
            }
        }
        Err(_) => {
            return 3
        }
    }
    return 0
}
