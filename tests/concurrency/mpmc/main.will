lane L0 struct L0Marker {
}

lane L1 struct L1Marker {
}

lane L2 struct L2Marker {
}

lane L3 struct L3Marker {
}

lane L4 struct L4Marker {
}

lane L5 struct L5Marker {
}

lane L6 struct L6Marker {
}

lane L7 struct L7Marker {
}

func Produce(ch: chan<i32>, n: i32) {
    for i in Range(0, n) {
        _ = ch.Send(i)
    }
}

func Consume(ch: chan<i32>) -> i32 {
    var sum: i32 = 0
    for {
        var item: Option<i32> = ch.Recv()
        match item {
            Some(value) => {
                sum += value
            }
            None => {
                break
            }
        }
    }
    return sum
}

func main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1024)
    var total: i32 = 0
    region {
        var p1: Task<()> = spawn on L0 Produce(ch, 20000)
        var p2: Task<()> = spawn on L1 Produce(ch, 20000)
        var p3: Task<()> = spawn on L2 Produce(ch, 20000)
        var p4: Task<()> = spawn on L3 Produce(ch, 20000)
        var c1: Task<i32> = spawn on L4 Consume(ch)
        var c2: Task<i32> = spawn on L5 Consume(ch)
        var c3: Task<i32> = spawn on L6 Consume(ch)
        var c4: Task<i32> = spawn on L7 Consume(ch)
        _ = p1.Join()!
        _ = p2.Join()!
        _ = p3.Join()!
        _ = p4.Join()!
        ch.Close()
        var s1: i32 = c1.Join()!
        var s2: i32 = c2.Join()!
        var s3: i32 = c3.Join()!
        var s4: i32 = c4.Join()!
        total = s1 + s2 + s3 + s4
    }
    return total - 799960000
}
