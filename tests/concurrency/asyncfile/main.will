import "std/os/fs"

# Checksum reads the whole file through the completion engine and sums every
# byte, so a short or reordered read cannot pass.
async def checksum(path: str) -> Result<i64, Error> {
    var bytes: list[u8] = await fs.read_file(path)?
    var sum: i64 = 0
    for b in bytes {
        sum += i64(b)
    }
    return Ok(sum)
}

# AppendTail proves that a second write task can extend the file that two
# readers just finished with.
async def append_tail(path: str) -> Result<(), Error> {
    var text: str = "end"
    return await fs.append(path, text[Range(0, 3)])
}

async def main() -> i32 {
    var path: str = "will-concurrency-asyncfile.tmp"
    var n: usize = 262144
    var data: list[u8] = list[u8](n)
    for i in Range(0, 262144) {
        data.push(u8(i % 251))
    }
    var expected: i64 = 0
    for b in data {
        expected += i64(b)
    }
    var written: Result<(), Error> = await fs.write_file(path, data[Range(0, n)])
    match written {
        Err(_) => {
            return 1
        }
        _ => {}
    }
    var first: i64 = 0
    var second: i64 = 0
    region {
        var t1: Task<Result<i64, Error>> = spawn checksum(path.clone())
        var t2: Task<Result<i64, Error>> = spawn checksum(path.clone())
        var r1: Result<i64, Error> = await t1!
        var r2: Result<i64, Error> = await t2!
        match r1 {
            Ok(v) => {
                first = v
            }
            Err(_) => {
                _ = await fs.remove(path)
                return 2
            }
        }
        match r2 {
            Ok(v) => {
                second = v
            }
            Err(_) => {
                _ = await fs.remove(path)
                return 3
            }
        }
    }
    if first != expected or second != expected {
        _ = await fs.remove(path)
        return 4
    }
    var extended: Result<(), Error> = Ok(())
    region {
        var t: Task<Result<(), Error>> = spawn append_tail(path.clone())
        extended = await t!
    }
    match extended {
        Err(_) => {
            _ = await fs.remove(path)
            return 5
        }
        _ => {}
    }
    var back: Result<list[u8], Error> = await fs.read_file(path)
    match back {
        Ok(bytes) => {
            if bytes.len() != n + 3 {
                _ = await fs.remove(path)
                return 6
            }
            if bytes.get(n) != u8(101) or bytes.get(n + 1) != u8(110) or bytes.get(n + 2) != u8(100) {
                _ = await fs.remove(path)
                return 7
            }
        }
        Err(_) => {
            _ = await fs.remove(path)
            return 8
        }
    }
    _ = await fs.remove(path)
    return 0
}
