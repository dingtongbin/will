import "std/time"

async def wait(ch: chan<i32>) -> i32 {
    var value: i32 = 0
    select {
        item = ch.recv() => {
            match item {
                Some(v) => {
                    value = v
                }
                None => {
                    value = -1
                }
            }
        }
    }
    return value
}

async def main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1)
    var result: i32 = 0
    region {
        var task: Task<i32> = spawn wait(ch)
        _ = await time.sleep(1ms)!
        _ = await ch.send(7)
        result = await task!
    }
    if result != 7 {
        return 1
    }
    return 0
}
