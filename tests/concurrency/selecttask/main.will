import "std/time"

async func Wait(ch: chan<i32>) -> i32 {
    var value: i32 = 0
    select {
        item = ch.Recv() => {
            match item {
                Some(v) => {
                    value = v
                }
                None => {
                    value = -1
                }
            }
        }
    }
    return value
}

async func main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1)
    var result: i32 = 0
    region {
        var task: Task<i32> = spawn Wait(ch)
        _ = await time.Sleep(1ms)!
        _ = await ch.Send(7)
        result = await task.Join()!
    }
    if result != 7 {
        return 1
    }
    return 0
}
