async def fill(ch: chan<i32>) -> Result<(), Error> {
    for i in Range(0, 4) {
        await ch.send(i)?
    }
    return Ok(())
}

async def main() -> i32 {
    var ch: chan<i32> = new chan<i32>(4)
    ch.close()
    region {
        var task: Task<Result<(), Error>> = spawn fill(ch)
        match await task! {
            Ok(_) => {
                return 1
            }
            Err(e) => {
                if e.status() != 4 {
                    return 2
                }
            }
        }
    }
    return 0
}
