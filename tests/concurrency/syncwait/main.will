import "std/sync"

async def wait_for(sem: sync.Semaphore, ready: chan<i32>, done: chan<i32>) -> i32 {
    _ = await ready.send(1)
    var permit: sync.Permit = await sem.acquire()!
    _ = await done.send(1)
    permit.release()
    return 0
}

async def worker(count: sync.count, done: chan<i32>) {
    _ = await done.send(1)
    count.add(-1i64)
}

async def main() -> i32 {
    var sem: sync.Semaphore = new sync.Semaphore(1i64)
    var first: sync.Permit = sem.try_acquire()!
    match sem.try_acquire() {
        Some(extra) => {
            extra.release()
            first.release()
            return 1
        }
        None => {
        }
    }
    var ready: chan<i32> = new chan<i32>(1)
    var done: chan<i32> = new chan<i32>(1)
    region {
        var task: Task<i32> = spawn wait_for(sem, ready, done)
        _ = await ready.recv()
        match done.try_recv() {
            Some(early) => {
                _ = early
                return 2
            }
            None => {
            }
        }
        first.release()
        _ = await done.recv()
        _ = await task.join()!
    }
    var count: sync.count = new sync.count(2i64)
    var finished: chan<i32> = new chan<i32>(2)
    region {
        var w1: Task<()> = spawn worker(count, finished)
        var w2: Task<()> = spawn worker(count, finished)
        _ = await count.wait()!
        _ = await finished.recv()
        _ = await finished.recv()
        _ = await w1.join()!
        _ = await w2.join()!
    }
    return 0
}
