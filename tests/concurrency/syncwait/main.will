import "std/sync"

async def WaitFor(sem: sync.Semaphore, ready: chan<i32>, done: chan<i32>) -> i32 {
    _ = await ready.Send(1)
    var permit: sync.Permit = await sem.Acquire()!
    _ = await done.Send(1)
    permit.Release()
    return 0
}

async def Worker(count: sync.Count, done: chan<i32>) {
    _ = await done.Send(1)
    count.Add(-1i64)
}

async def main() -> i32 {
    var sem: sync.Semaphore = new sync.Semaphore(1i64)
    var first: sync.Permit = sem.TryAcquire()!
    match sem.TryAcquire() {
        Some(extra) => {
            extra.Release()
            first.Release()
            return 1
        }
        None => {
        }
    }
    var ready: chan<i32> = new chan<i32>(1)
    var done: chan<i32> = new chan<i32>(1)
    region {
        var task: Task<i32> = spawn WaitFor(sem, ready, done)
        _ = await ready.Recv()
        match done.TryRecv() {
            Some(early) => {
                _ = early
                return 2
            }
            None => {
            }
        }
        first.Release()
        _ = await done.Recv()
        _ = await task.Join()!
    }
    var count: sync.Count = new sync.Count(2i64)
    var finished: chan<i32> = new chan<i32>(2)
    region {
        var w1: Task<()> = spawn Worker(count, finished)
        var w2: Task<()> = spawn Worker(count, finished)
        _ = await count.Wait()!
        _ = await finished.Recv()
        _ = await finished.Recv()
        _ = await w1.Join()!
        _ = await w2.Join()!
    }
    return 0
}
