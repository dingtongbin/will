async def wait(ch: chan<i32>) -> i32 {
    var value: i32 = -1
    select {
        item = ch.recv() => {
            match item {
                Some(v) => {
                    value = v
                }
                None => {
                    value = -2
                }
            }
        }
        timeout 1ms => {
            value = 9
        }
    }
    return value
}

async def main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1)
    var result: i32 = 0
    region {
        var task: Task<i32> = spawn wait(ch)
        result = await task.join()!
    }
    if result != 9 {
        return 1
    }
    return 0
}
