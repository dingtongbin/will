import "std/os/fs"

func Mix(ch: chan<i32>, path: str) -> Result<(), Error> {
    var one: str = "m"
    _ = fs.AsyncAppend(path, one[Range(0, 1)])?
    _ = ch.Send(7)
    return Ok(())
}

func main() -> i32 {
    var path: str = "will-concurrency-mixasync.tmp"
    _ = fs.Remove(path)
    var ch: chan<i32> = new chan<i32>(1)
    var result: Result<(), Error> = Ok(())
    var value: i32 = 0
    region {
        var task: Task<Result<(), Error>> = spawn Mix(ch, path)
        var item: Option<i32> = ch.Recv()
        match item {
            Some(v) => {
                value = v
            }
            None => {
                return 1
            }
        }
        result = task.Join()!
    }
    _ = fs.Remove(path)
    if value != 7 {
        return 2
    }
    if result.IsErr() {
        return 3
    }
    return 0
}
