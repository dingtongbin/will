lane P0 struct P0Marker {
}

lane P1 struct P1Marker {
}

lane P2 struct P2Marker {
}

lane P3 struct P3Marker {
}

lane StageLane struct StageMarker {
}

lane Sink struct SinkMarker {
}

async def Produce(ch: chan<i32>, n: i32) {
    for i in Range(0, n) {
        _ = await ch.Send(i)
    }
}

async def Stage(inp: chan<i32>, out: chan<i32>) {
    for {
        var item: Option<i32> = await inp.Recv()
        match item {
            Some(value) => {
                _ = await out.Send(value * 2)
            }
            None => {
                break
            }
        }
    }
    out.Close()
}

async def Consume(ch: chan<i32>) -> i32 {
    var sum: i32 = 0
    for {
        var item: Option<i32> = await ch.Recv()
        match item {
            Some(value) => {
                sum += value
            }
            None => {
                break
            }
        }
    }
    return sum
}

async def main() -> i32 {
    var first: chan<i32> = new chan<i32>(64)
    var second: chan<i32> = new chan<i32>(64)
    var total: i32 = 0
    region {
        var p0: Task<()> = spawn on P0 Produce(first, 10000)
        var p1: Task<()> = spawn on P1 Produce(first, 10000)
        var p2: Task<()> = spawn on P2 Produce(first, 10000)
        var p3: Task<()> = spawn on P3 Produce(first, 10000)
        var stage: Task<()> = spawn on StageLane Stage(first, second)
        var sink: Task<i32> = spawn on Sink Consume(second)
        _ = await p0.Join()!
        _ = await p1.Join()!
        _ = await p2.Join()!
        _ = await p3.Join()!
        first.Close()
        _ = await stage.Join()!
        total = await sink.Join()!
    }
    return total - 399960000
}
