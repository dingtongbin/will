import "std/time"

async def pick(ch: chan<i32>) -> i32 {
    var result: i32 = 0
    select {
        item = ch.recv() => {
            match item {
                Some(v) => {
                    result = v
                }
                None => {
                    result = -1
                }
            }
            _ = await time.sleep(1ms)!
        }
        default => {
            result = 9
        }
    }
    return result
}

async def main() -> i32 {
    var ch: chan<i32> = new chan<i32>(1)
    _ = await ch.send(7)
    var ready: i32 = await pick(ch)
    if ready != 7 {
        return 1
    }
    var empty: i32 = await pick(ch)
    if empty != 9 {
        return 2
    }
    return 0
}
