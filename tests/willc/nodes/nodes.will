struct Box {
    v: i64

    def value(self) -> i64 {
        return self.v
    }
}



enum Shape {
    Dot
    Line
}

def unit() -> Result<(), Error> {
    return Ok(())
}

def use(b: Box, s: Shape) -> i64 {
    var here: usize = 0usize
    var text: str = f"v={b.v} end"
    var p: Box = b
    var n: i64 = p.value()
    var ch: chan<i64> = chan<i64>(4)
    var kind: i64 = match s {
        Dot | Line => n
    }
    _ = here
    _ = text
    _ = ch
    return kind
}
