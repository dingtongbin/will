import "example.com/app/http"

const Limit: i32 = 100

struct Point {
    x: i32
    y: i32 = 0

    def move(self, dx: i32, dy: i32) {
        self.x += dx
        self.y += dy
    }
}

enum Shape {
    Circle(f64)
    Square
}

interface Showable {
    def show() -> str
}

def work(n: i32) -> i32 {
    return n
}



def max<T: Show>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

async def run(n: i32) -> i32 {
    var xs: list[i32] = list[i32](0)
    var total: i32 = 0
    for i, x in xs {
        total += i32(i) + x
    }
    var p: Point = Point { x: 1, y: n }
    p.move(n, 2)
    var shape: Shape = Circle(1.5)
    _ = shape
    match total {
        0 => { total = 1 }
        9 if total > 2 => { total = 3 }
        _ => { total = 4 }
    }
    var text: str = f"value {n} {{ok}}"
    _ = text
    var ch: chan<i32> = chan<i32>(8)
    var t: Task<i32> = spawn work(n)
    _ = await t
    select {
        v = ch.recv() => { total = v }
        timeout 5ms => { total = -1 }
        default => { total = 0 }
    }
    deadline 3ms {
        total += 1
    }
    region {
        work(n)
    }
    if total == 0 {
        return 0
    }
    return http.status(200) + total + Limit
}
