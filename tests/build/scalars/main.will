def sum(a: i64, b: i64) -> i64 {
    return a + b
}

def below(a: usize, b: usize) -> bool {
    return a < b
}

def half(n: u64) -> u64 {
    return n >> 1
}

def mid(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

def main() -> i32 {
    if below(1, 2) {
        return 0
    }
    return 1
}
