interface Value {
    def get(self) -> i32
}

class Node {
    value: i32
    next: Node

    def init(self, value: i32) {
        self.value = value
    }

    def get(self) -> i32 {
        return self.value
    }

    def link(self, other: Node) {
        self.next = other
    }
}

def main() -> i32 {
    var first: Node = Node(3)
    var second: Node = Node(4)
    first.link(second)
    var iface: Value = first
    if iface.get() != 3 or first.next.get() != 4 {
        return 1
    }
    return 0
}
