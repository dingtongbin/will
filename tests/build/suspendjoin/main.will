func Inner() -> i32 {
    return 7
}

async func Wait(task: Task<i32>) -> i32 {
    return await task.Join()!
}

async func main() -> i32 {
    var value: i32 = 0
    region {
        var inner: Task<i32> = spawn Inner()
        var waiter: Task<i32> = spawn Wait(inner)
        value = await waiter.Join()!
    }
    if value != 7 {
        return 1
    }
    return 0
}
