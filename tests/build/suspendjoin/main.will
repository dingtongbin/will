def inner() -> i32 {
    return 7
}

async def wait(task: Task<i32>) -> i32 {
    return await task!
}

async def main() -> i32 {
    var value: i32 = 0
    region {
        var inner: Task<i32> = spawn inner()
        var waiter: Task<i32> = spawn wait(inner)
        value = await waiter!
    }
    if value != 7 {
        return 1
    }
    return 0
}
