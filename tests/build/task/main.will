def compute(x: i32) -> i32 {
    return x + 1
}

def make_text(n: i32) -> str {
    return f"value={n}"
}

async def main() -> i32 {
    var sum: i32 = 0
    region {
        var a: Task<i32> = spawn compute(20)
        var b: Task<i32> = spawn compute(21)
        var first: i32 = await a.join()!
        var second: i32 = await b.join()!
        sum = first + second
    }
    var text: str = ""
    region {
        var t: Task<str> = spawn make_text(sum)
        text = await t.join()!
    }
    print(text, "\n")
    return sum + i32(text.len())
}
