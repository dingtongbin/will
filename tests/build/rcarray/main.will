struct C {
    n: i32
}

def pick(xs: Array<rc<C>>) -> rc<C> {
    return xs.get(0)
}

def main() -> i32 {
    var xs: Array<rc<C>> = new Array<rc<C>>(0)
    var a: rc<C> = new rc<C>(C { n: 1 })
    xs.push(a)
    var b: rc<C> = xs.get(0)
    xs.set(0, a)
    var c: rc<C> = pick(xs)
    var total: i32 = b.n + c.n + xs.get(0).n
    _ = a
    return total
}
