def Inner() -> i32 {
    return 7
}

async def Work(t: Task<i32>) -> i32 {
    return await t.Join()!
}

async def WorkLocal(t: Task<i32>) -> i32 {
    var x: i32 = await t.Join()!
    return x + 1
}

async def WorkPure(t: Task<i32>) -> i32 {
    var a: i32 = 1 + 2
    var b: i32 = a + 3
    var x: i32 = await t.Join()!
    return a + b + x
}

async def main() -> i32 {
    var inner: Task<i32> = spawn Inner()
    var work: Task<i32> = spawn Work(inner)
    var got: i32 = await work.Join()!
    if got != 7 {
        return 1
    }
    var local: Task<i32> = spawn WorkLocal(inner)
    var gotLocal: i32 = await local.Join()!
    if gotLocal != 8 {
        return 2
    }
    var pure: Task<i32> = spawn WorkPure(inner)
    var gotPure: i32 = await pure.Join()!
    if gotPure != 16 {
        return 3
    }
    return 0
}
