def lookup(m: dict[i32, i32], k: i32) -> i32 {
    return match m.get(k) {
        Some(v) => v
        None => 0 - 1
    }
}

def main() -> i32 {
    var m: dict[i32, i32] = dict[i32, i32](2)
    m.set(1, 10)
    m.set(2, 20)
    m.set(1, 11)
    var s: i32 = lookup(m, 2)
    var t: i32 = lookup(m, 3)
    var keys: list[i32] = m.keys()
    var values: list[i32] = m.values()
    var n: i32 = 0
    for x in keys {
        n = n + x
    }
    for x in values {
        n = n + x
    }
    if m.has(2) {
        s = s + 100
    }
    if m.delete(2) {
        s = s + 1000
    }
    return s + t + n
}
