def apply(f: func(i32) -> i32, x: i32) -> i32 {
    return f(x)
}

def twice(f: func(i32) -> i32, x: i32) -> i32 {
    return f(f(x))
}

def inc(x: i32) -> i32 {
    return x + 1
}

def make_adder(n: i32) -> func(i32) -> i32 {
    return func(x: i32) -> i32 {
        return x + n
    }
}

def counter() -> func() -> i32 {
    var n: i32 = 0
    return func() -> i32 {
        n += 1
        return n
    }
}

def main() -> i32 {
    var inc: func(i32) -> i32 = func(x: i32) -> i32 { return x + 1 }
    var dbl: func(i32) -> i32 = func(x: i32) -> i32 { return x * 2 }
    var add: func(i32) -> i32 = make_adder(3)
    var c: func() -> i32 = counter()
    var a: i32 = c()
    return apply(inc, 1) + twice(dbl, 2) + add(4) + a + apply(inc, 1)
}
