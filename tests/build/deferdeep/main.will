struct Packet {
    name: str
    values: Array<i32>
}

def show_packet(p: Packet) {
    print(p.name, " ", p.values.len(), " ", p.values.get(0usize), "\n")
}

def show_map(m: dict[str, i32]) {
    print(m.len(), "\n")
}

def show_nested(xs: Array<Array<i32>>) {
    print(xs.len(), " ", xs.get(0usize).len(), "\n")
}

def main() -> i32 {
    var p: Packet = Packet {
        name: "old" + "!",
        values: new Array<i32>(1usize),
    }
    p.values.push(1)
    defer show_packet(p)
    p.name = "new" + "?"
    p.values.push(2)

    var m: dict[str, i32] = dict[str, i32](0usize)
    m.set("first", 1)
    defer show_map(m)
    m.set("second", 2)

    var inner: Array<i32> = new Array<i32>(0usize)
    inner.push(7)
    var xs: Array<Array<i32>> = new Array<Array<i32>>(0usize)
    xs.push(inner.clone())
    defer show_nested(xs)
    inner.push(8)

    return 0
}
