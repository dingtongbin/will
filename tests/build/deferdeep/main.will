struct Packet {
    name: str
    values: list[i32]
}

def show_packet(p: Packet) {
    print(p.name, " ", p.values.len(), " ", p.values.get(0usize), "\n")
}

def show_map(m: dict[str, i32]) {
    print(m.len(), "\n")
}

def show_nested(xs: list[list[i32]]) {
    print(xs.len(), " ", xs.get(0usize).len(), "\n")
}

def main() -> i32 {
    var p: Packet = Packet {
        name: "old" + "!",
        values: list[i32](1usize),
    }
    p.values.push(1)
    defer show_packet(p)
    p.name = "new" + "?"
    p.values.push(2)

    var m: dict[str, i32] = dict[str, i32](0usize)
    m.set("first", 1)
    defer show_map(m)
    m.set("second", 2)

    var inner: list[i32] = list[i32](0usize)
    inner.push(7)
    var xs: list[list[i32]] = list[list[i32]](0usize)
    xs.push(inner.clone())
    defer show_nested(xs)
    inner.push(8)

    return 0
}
