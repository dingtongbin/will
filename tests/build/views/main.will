func Sum(xs: []i32) -> i32 {
    var total: i32 = 0
    for i, x in xs {
        total += x
        if i > 100 {
            break
        }
    }
    return total
}

func Count(xs: Array<i32>) -> i64 {
    var n: i64 = 0
    for x in xs {
        if x > 0 {
            n += 1
        }
    }
    return n
}

func main() -> i32 {
    return 0
}
