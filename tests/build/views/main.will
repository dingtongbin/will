def sum(xs: []i32) -> i32 {
    var total: i32 = 0
    for i, x in xs {
        total += x
        if i > 100 {
            break
        }
    }
    return total
}

def count(xs: Array<i32>) -> i64 {
    var n: i64 = 0
    for x in xs {
        if x > 0 {
            n += 1
        }
    }
    return n
}

def mid(xs: [4]i32) -> i32 {
    var v: []i32 = xs[Range(1, 3)]
    return sum(v) + sum(xs[Range(0, 2)])
}

def main() -> i32 {
    return 0
}
