async def main() -> i32 {
    var ch: chan<i32> = chan<i32>(1)
    var got: bool = False
    deadline 1ms {
        var item: Option<i32> = await ch.recv()
        match item {
            Some(_) => {
                got = True
            }
            None => {}
        }
    }
    if got {
        return 1
    }
    return 0
}
