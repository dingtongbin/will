struct Node {
    value: i32
    next: weak<Node>
}

func (mut n: Node) init(value: i32) {
    n.value = value
}

func main() -> i32 {
    var a: rc<Node> = new rc<Node>(1)
    var b: rc<Node> = new rc<Node>(2)
    a.next = b.Weak()
    b.next = a.Weak()
    var v: i32 = 0
    match a.next.Upgrade() {
        Some(x) => {
            v = x.value
        }
        None => {
        }
    }
    return v
}
