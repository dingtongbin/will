struct Node {
    value: i32
    next: weak<Node>
}

def (mut n: Node) init(value: i32) {
    n.value = value
}

def main() -> i32 {
    var a: rc<Node> = new rc<Node>(1)
    var b: rc<Node> = new rc<Node>(2)
    a.next = b.weak()
    b.next = a.weak()
    var v: i32 = 0
    match a.next.upgrade() {
        Some(x) => {
            v = x.value
        }
        None => {
        }
    }
    return v
}
