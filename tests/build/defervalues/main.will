# A deferred str and a deferred list must keep the value they had at the
# defer statement even when the local is reassigned or grows afterwards.
def show(s: str) {
    print(s, "\n")
}

def show_array(a: list[i32]) {
    print(a.len(), " ", a.get(0usize), "\n")
}

def main() -> i32 {
    var s: str = "old" + "!"
    defer Show(s)
    s = "new" + "?"

    var a: list[i32] = list[i32](1usize)
    a.push(7)
    defer show_array(a)
    a.push(8)
    a.push(9)
    return 0
}
