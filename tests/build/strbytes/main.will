def main() -> i32 {
    var text: str = "hello world"
    var view: []u8 = text[Range(0, 11)]
    var word: []u8 = text[Range(6, 11)]
    var same: bool = view.equal(view)
    var cmp: i32 = view.compare(word)
    var pre: bool = view.has_prefix(word)
    var suf: bool = view.has_suffix(word)
    var idx: Option<usize> = view.index(word)
    var copy: list[u8] = view.clone()
    var head: str = str(text[Range(0, 2)])
    var letter: str = str(65u32)
    _ = idx
    if same and not pre and suf and cmp > 0 and copy.len() == 11 {
        print(head, letter, "\n")
        return 1
    }
    return 0
}
