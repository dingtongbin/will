func main() -> i32 {
    var s: Set<i32> = new Set<i32>()
    if s.Add(1) {
        s.Add(2)
    }
    if s.Add(1) {
        return 0
    }
    if !s.Has(2) {
        return 0
    }
    var sum: i32 = 0
    for v in s {
        sum = sum + v
    }
    if s.Delete(1) {
        sum = sum + 10
    }
    return sum
}
