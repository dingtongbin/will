def main() -> i32 {
    var s: Set<i32> = new Set<i32>()
    if s.add(1) {
        s.add(2)
    }
    if s.add(1) {
        return 0
    }
    if !s.has(2) {
        return 0
    }
    var sum: i32 = 0
    for v in s {
        sum = sum + v
    }
    if s.delete(1) {
        sum = sum + 10
    }
    return sum
}
