struct Counter {
    n: i32
}

struct Holder {
    c: rc<Counter>
    back: weak_rc<Counter>
}

def (c: mut Counter) add(d: i32) {
    c.n += d
}

def identity(c: rc<Counter>) -> rc<Counter> {
    return c
}

def main() -> i32 {
    var c: rc<Counter> = new rc<Counter>(Counter { n: 1 })
    c.add(4)
    c.n += 1
    var d: rc<Counter> = c
    var w: weak_rc<Counter> = c.weak()
    var u: Option<rc<Counter>> = w.upgrade()
    var e: rc<Counter> = identity(d)
    var h: Holder = Holder { c: e, back: w }
    var v: i32 = 0
    match u {
        Some(x) => {
            v = x.n
        }
        None => {
        }
    }
    _ = d
    return v + h.c.n
}
