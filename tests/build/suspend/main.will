async def worker(ch: chan<i32>) -> i32 {
    var sum: i32 = 0
    while True {
        var item: Option<i32> = await ch.recv()
        match item {
            Some(value) => {
                sum += value
            }
            None => {
                break
            }
        }
    }
    return sum
}

async def main() -> i32 {
    var ch: chan<i32> = chan<i32>(4)
    var result: i32 = 0
    region {
        var worker: Task<i32> = spawn worker(ch)
        _ = await ch.send(3)
        _ = await ch.send(4)
        ch.close()
        result = await worker!
    }
    return result - 7
}
