enum Shape {
    Empty
    Circle(i32)
    Box(i32, i32)
}

struct Holder {
    shape: Shape
    n: i32
}

def area(s: Shape) -> i32 {
    return match s {
        Circle(r) => r * r
        Box(a, b) => a * b
        Empty => 0
    }
}

def count(h: Holder) -> i32 {
    match h.shape {
        Circle(r) => {
            return r + h.n
        }
        _ => {
            return 0
        }
    }
}

def pick(n: i32) -> i32 {
    return match n {
        0 => 10
        x if x > 0 => x
        _ => -1
    }
}

def main() -> i32 {
    var h: Holder = Holder { shape: Shape.Circle(3), n: 2 }
    return area(Shape.Circle(3)) + count(h) + pick(4)
}
