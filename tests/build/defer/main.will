struct C {
    n: i32
}

struct E {
    m: str

    def message(self) -> str {
        return self.m.clone()
    }

    def status(self) -> i32 {
        return 1
    }
}





def maybe(ok: bool) -> Result<i32, E> {
    if ok {
        return Ok(1)
    }
    return Err(E { m: "no" })
}

def order() -> i32 {
    defer print("one\n")
    defer print("two\n")
    print("body\n")
    return 5
}

def early(c: bool) -> i32 {
    defer print("early\n")
    if c {
        return 1
    }
    return 2
}

def loop() -> i32 {
    for i in Range(0, 4) {
        defer print("loop\n")
        if i == 1 {
            continue
        }
        if i == 3 {
            break
        }
        print("body\n")
    }
    return 0
}

def held(c: bool) -> Result<i32, E> {
    var x: C = C { n: 7 }
    defer print("held\n")
    var v: i32 = maybe(c)?
    return Ok(v + x.n)
}

def tail(c: bool) -> Result<i32, E> {
    var x: C = C { n: 9 }
    defer print("tail\n")
    return Ok(maybe(c)? + x.n)
}

def main() -> i32 {
    _ = order()
    _ = early(False)
    _ = loop()
    match held(True) {
        Ok(v) => {
            _ = v
        }
        Err(e) => {
            _ = e
        }
    }
    match held(False) {
        Ok(v) => {
            _ = v
        }
        Err(e) => {
            _ = e
        }
    }
    match tail(False) {
        Ok(v) => {
            _ = v
        }
        Err(e) => {
            _ = e
        }
    }
    return 0
}
