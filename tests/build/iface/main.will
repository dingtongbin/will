interface Counter {
    def get() -> i32
    def add(n: i32) -> i32
}

struct C {
    n: i32

    def get(self) -> i32 {
        return self.n
    }

    def add(self, n: i32) -> i32 {
        self.n += n
        return self.n
    }
}





def use(x: Counter) -> i32 {
    return x.get() + x.add(2)
}

interface Actor {
    async def step(n: i32) -> i32
}

struct A {
    n: i32

    async def step(self, n: i32) -> i32 {
        return self.n + n
    }
}



async def actor_value() -> i32 {
    var a: A = A { n: 1 }
    var x: Actor = a
    return await x.step(2)
}

def main() -> i32 {
    var c: C = C { n: 3 }
    var x: Counter = c
    return use(c) + x.get()
}
