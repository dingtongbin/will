interface Counter {
    def get() -> i32
    def add(n: i32) -> i32
}

struct C {
    n: i32
}

def (c: C) get() -> i32 {
    return c.n
}

def (mut c: C) add(n: i32) -> i32 {
    c.n += n
    return c.n
}

def use(x: Counter) -> i32 {
    return x.get() + x.add(2)
}

def main() -> i32 {
    var c: C = C { n: 3 }
    var x: Counter = c
    return use(c) + x.get()
}
