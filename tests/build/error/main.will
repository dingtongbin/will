struct E {
    msg: str

    def message(self) -> str {
        return self.msg.clone()
    }

    def status(self) -> i32 {
        return 7
    }
}





def use() -> i32 {
    var e: E = E { msg: "bad" }
    var r: Result<i32, Error> = Err(e)
    return match r {
        Ok(v) => v
        Err(x) => x.status()
    }
}

def main() -> i32 {
    return use()
}
