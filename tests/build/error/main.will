struct E {
    msg: str
}

def (e: E) Message() -> str {
    return e.msg.Clone()
}

def (e: E) Status() -> i32 {
    return 7
}

def Use() -> i32 {
    var e: E = E { msg: "bad" }
    var r: Result<i32, Error> = Err(e)
    return match r {
        Ok(v) => v
        Err(x) => x.Status()
    }
}

def main() -> i32 {
    return Use()
}
