def find(x: i32) -> Option<i32> {
    if x > 0 {
        return Some(x)
    }
    return None
}

def use_opt(x: i32) -> i32 {
    return match find(x) {
        Some(v) => v
        None => 0
    }
}

def divide(x: i32) -> Result<i32, i32> {
    if x == 0 {
        return Err(1)
    }
    return Ok(x / 2)
}

def use_res(x: i32) -> Result<i32, i32> {
    var v: i32 = divide(x)?
    return Ok(v + 1)
}

def pick(r: Result<i32, i32>) -> i32 {
    return match r {
        Ok(v) => v
        Err(e) => e
    }
}

def main() -> i32 {
    return use_opt(3) + pick(use_res(4))
}
