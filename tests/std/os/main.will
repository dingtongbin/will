import "std/os"

func CheckEnv() -> i32 {
    var set: Result<(), Error> = os.Setenv("WILL_OS_PROBE", "value")
    match set {
        Err(e) => {
            if e.Status() != 7 {
                return 1
            }
            return 2
        }
        _ => {}
    }

    var got: Option<str> = os.Getenv("WILL_OS_PROBE")
    match got {
        Some(value) => {
            if value != "value" {
                return 3
            }
        }
        None => {
            return 4
        }
    }

    var environ: Map<str, str> = os.Environ()
    if !environ.Has("WILL_OS_PROBE") {
        return 5
    }

    var invalid: Result<(), Error> = os.Setenv("A\0B", "x")
    match invalid {
        Err(e) => {
            if e.Status() != 2 {
                return 7
            }
        }
        _ => {
            return 6
        }
    }
    return 0
}

func CheckCwd() -> i32 {
    var cwd: Result<str, Error> = os.Cwd()
    match cwd {
        Ok(path) => {
            if path.Len() == 0usize {
                return 8
            }
        }
        Err(e) => {
            if e.Status() != 7 {
                return 9
            }
            return 10
        }
    }

    var here: Result<(), Error> = os.Chdir(".")
    match here {
        Err(e) => {
            if e.Status() != 7 {
                return 11
            }
            return 12
        }
        _ => {}
    }

    var missing: Result<(), Error> = os.Chdir("will-no-such-directory")
    match missing {
        Err(e) => {
            if e.Status() != 7 {
                return 14
            }
        }
        _ => {
            return 13
        }
    }
    return 0
}

func main() -> i32 {
    var args: []str = os.Args()
    if args.Len() == 0usize {
        return 15
    }
    var code: i32 = CheckEnv()
    if code != 0 {
        return code
    }
    return CheckCwd()
}
