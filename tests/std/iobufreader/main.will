import "std/io/buf"

// source hands out at most two bytes per read, so the buffered reader has to
// keep its place across calls instead of throwing the rest of a chunk away.
struct source {
    data: Array<u8>
    pos: usize
}

def (mut s: source) read(mut out: Array<u8>) -> Result<usize, Error> {
    if s.pos >= s.data.len() {
        return Ok(0usize)
    }
    out.push(s.data.get(s.pos))
    s.pos += 1usize
    if s.pos < s.data.len() {
        out.push(s.data.get(s.pos))
        s.pos += 1usize
    }
    return Ok(2usize)
}

def main() -> i32 {
    var src: source = source { data: new Array<u8>(0), pos: 0usize }
    src.data.push(104u8)
    src.data.push(101u8)
    src.data.push(108u8)
    src.data.push(108u8)
    src.data.push(111u8)
    var reader: buf.ReaderBuf = new buf.ReaderBuf(src, 3usize)
    var first: Array<u8> = new Array<u8>(0)
    if reader.read(first)! != 2usize {
        return 1
    }
    if first.get(0) != 104u8 || first.get(1) != 101u8 {
        return 2
    }
    var second: Array<u8> = new Array<u8>(0)
    if reader.read(second)! != 2usize {
        return 3
    }
    if second.get(0) != 108u8 || second.get(1) != 108u8 {
        return 4
    }
    var third: Array<u8> = new Array<u8>(0)
    if reader.read(third)! != 1usize {
        return 5
    }
    if third.get(0) != 111u8 {
        return 6
    }
    var end: Array<u8> = new Array<u8>(0)
    if reader.read(end)! != 0usize {
        return 7
    }
    return 0
}
