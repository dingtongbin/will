import "std/io/buf"

# source hands out at most two bytes per read, so the buffered reader has to
# keep its place across calls instead of throwing the rest of a chunk away.
struct source {
    data: list[u8]
    pos: usize

    async def read(self, out: list[u8]) -> Result<usize, Error> {
        if self.pos >= self.data.len() {
            return Ok(0usize)
        }
        out.push(self.data.get(self.pos))
        self.pos += 1usize
        if self.pos < self.data.len() {
            out.push(self.data.get(self.pos))
            self.pos += 1usize
        }
        return Ok(2usize)
    }
}



async def main() -> i32 {
    var src: source = source { data: list[u8](0), pos: 0usize }
    src.data.push(104u8)
    src.data.push(101u8)
    src.data.push(108u8)
    src.data.push(108u8)
    src.data.push(111u8)
    var reader: buf.ReaderBuf = buf.ReaderBuf(src, 3usize)
    var first: list[u8] = list[u8](0)
    if await reader.read(first)! != 2usize {
        return 1
    }
    if first.get(0) != 104u8 or first.get(1) != 101u8 {
        return 2
    }
    var second: list[u8] = list[u8](0)
    if await reader.read(second)! != 2usize {
        return 3
    }
    if second.get(0) != 108u8 or second.get(1) != 108u8 {
        return 4
    }
    var third: list[u8] = list[u8](0)
    if await reader.read(third)! != 1usize {
        return 5
    }
    if third.get(0) != 111u8 {
        return 6
    }
    var end: list[u8] = list[u8](0)
    if await reader.read(end)! != 0usize {
        return 7
    }
    return 0
}
