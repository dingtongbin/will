import "std/errors"

struct probeError {
    status: i32
}

def (e: ref probeError) message() -> str {
    return "probe"
}

def (e: ref probeError) status() -> i32 {
    return e.status
}

def class_of_status(status: i32) -> errors.ErrorClass {
    var v: probeError = probeError { status: status }
    var e: Error = v
    return errors.class_of(e)
}

def main() -> i32 {
    var total: i32 = 0
    var c: errors.ErrorClass = class_of_status(1)
    match c {
        NotFound => {
            total += 1
        }
        Deadline => {
            total += 2
        }
        Busy => {
            total += 3
        }
        Upstream => {
            total += 4
        }
        Bug => {
            total += 5
        }
    }
    var busy: errors.ErrorClass = class_of_status(3)
    total += match busy {
        NotFound => 10
        Deadline => 20
        Busy => 30
        Upstream => 40
        Bug => 50
    }
    return total
}
