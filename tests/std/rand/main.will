import "std/math/rand"

// Two streams with one seed must stay identical, different seeds must diverge,
// and NextF64 must stay in [0, 1). The published SplitMix64 values pin the
// state update and the three wrapping multiplies.
func main() -> i32 {
    var r: rand.Rand = new rand.Rand(42u64)
    var a: u64 = r.NextU64()
    var b: u64 = r.NextU64()
    var f: f64 = r.NextF64()
    if a != 13679457532755275413u64 {
        return 1
    }
    if b != 2949826092126892291u64 {
        return 2
    }
    if a == b {
        return 3
    }
    if f < 0.0 || f >= 1.0 {
        return 4
    }

    var same: rand.Rand = new rand.Rand(42u64)
    if same.NextU64() != a {
        return 5
    }
    if same.NextU64() != b {
        return 6
    }

    var other: rand.Rand = new rand.Rand(43u64)
    if other.NextU64() == a {
        return 7
    }

    var zero: rand.Rand = new rand.Rand(0u64)
    var zeroAgain: rand.Rand = new rand.Rand(0u64)
    if zero.NextU64() != zeroAgain.NextU64() {
        return 8
    }
    return 0
}
