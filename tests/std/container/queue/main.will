import "std/container/queue"

// Push must fill the back stack, Pop must drain it in FIFO order, and a new
// Push after a partial drain must still go behind the older values.
def main() -> i32 {
    var q: queue.Queue<i32> = new queue.Queue<i32>()
    if q.len() != 0usize {
        return 1
    }
    q.push(1)
    q.push(2)
    q.push(3)
    if q.len() != 3usize {
        return 2
    }
    match q.peek() {
        Some(v) => {
            if v != 1 {
                return 3
            }
        }
        None => {
            return 4
        }
    }
    match q.pop() {
        Some(v) => {
            if v != 1 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    q.push(4)
    match q.pop() {
        Some(v) => {
            if v != 2 {
                return 7
            }
        }
        None => {
            return 8
        }
    }
    match q.pop() {
        Some(v) => {
            if v != 3 {
                return 9
            }
        }
        None => {
            return 10
        }
    }
    match q.pop() {
        Some(v) => {
            if v != 4 {
                return 11
            }
        }
        None => {
            return 12
        }
    }
    match q.pop() {
        Some(v) => {
            _ = v
            return 13
        }
        None => {
        }
    }
    if q.len() != 0usize {
        return 14
    }
    q.push(5)
    q.clear()
    if q.len() != 0usize {
        return 15
    }
    return 0
}
