import "std/container/heap"

def main() -> i32 {
    var h: heap.Heap<i32> = heap.Heap<i32>(0usize)
    if h.len() != 0usize {
        return 1
    }
    h.push(7)
    h.push(3)
    h.push(9)
    h.push(1)
    h.push(5)
    if h.len() != 5usize {
        return 2
    }
    match h.peek() {
        Some(v) => {
            if v != 9 {
                return 3
            }
        }
        None => {
            return 4
        }
    }
    var expected: list[i32] = list[i32](5usize)
    expected.push(9)
    expected.push(7)
    expected.push(5)
    expected.push(3)
    expected.push(1)
    var i: usize = 0usize
    while i < 5usize {
        match h.pop() {
            Some(v) => {
                if v != expected.get(i) {
                    return 5
                }
            }
            None => {
                return 6
            }
        }
        i += 1usize
    }
    match h.pop() {
        Some(v) => {
            _ = v
            return 7
        }
        None => {
        }
    }
    h.clear()
    if h.len() != 0usize {
        return 8
    }
    return 0
}
