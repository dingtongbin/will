import "std/container/heap"

def less(a: i32, b: i32) -> bool {
    return a < b
}

// Heap must keep the root smallest through every Push and Pop, including the
// sift-down path with two children.
def main() -> i32 {
    var h: heap.Heap<i32> = new heap.Heap<i32>(less)
    if h.len() != 0usize {
        return 1
    }
    h.push(7)
    h.push(3)
    h.push(9)
    h.push(1)
    h.push(5)
    if h.len() != 5usize {
        return 2
    }
    match h.peek() {
        Some(v) => {
            if v != 1 {
                return 3
            }
        }
        None => {
            return 4
        }
    }
    var expected: Array<i32> = new Array<i32>(0)
    expected.push(1)
    expected.push(3)
    expected.push(5)
    expected.push(7)
    expected.push(9)
    var i: usize = 0usize
    for {
        if i >= 5usize {
            break
        }
        match h.pop() {
            Some(v) => {
                if v != expected.get(i) {
                    return 5
                }
            }
            None => {
                return 6
            }
        }
        i += 1usize
    }
    match h.pop() {
        Some(v) => {
            _ = v
            return 7
        }
        None => {
        }
    }
    return 0
}
