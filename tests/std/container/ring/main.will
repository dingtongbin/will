import "std/container/ring"

def main() -> i32 {
    var r: ring.Ring<i32> = ring.Ring<i32>(3usize)
    if r.len() != 0usize {
        return 1
    }
    match r.push(1) {
        Some(v) => {
            _ = v
            return 2
        }
        None => {
        }
    }
    match r.push(2) {
        Some(v) => {
            _ = v
            return 3
        }
        None => {
        }
    }
    match r.push(3) {
        Some(v) => {
            _ = v
            return 4
        }
        None => {
        }
    }
    match r.push(4) {
        Some(v) => {
            if v != 1 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    if r.len() != 3usize {
        return 7
    }
    match r.peek() {
        Some(v) => {
            if v != 2 {
                return 8
            }
        }
        None => {
            return 9
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 2 {
                return 10
            }
        }
        None => {
            return 11
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 3 {
                return 12
            }
        }
        None => {
            return 13
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 4 {
                return 14
            }
        }
        None => {
            return 15
        }
    }
    match r.pop() {
        Some(v) => {
            _ = v
            return 16
        }
        None => {
        }
    }
    r.clear()
    if r.len() != 0usize {
        return 17
    }
    return 0
}
