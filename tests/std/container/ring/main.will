import "std/container/ring"

# A ring must stop at its capacity, preserve FIFO order, and free a slot when
# Pop removes a value so a later Push can use it again.
def main() -> i32 {
    var r: ring.Ring<i32> = ring.Ring<i32>(3usize)!
    if r.len() != 0usize or r.full() {
        return 1
    }
    if not r.push(1) or not r.push(2) or not r.push(3) {
        return 2
    }
    if not r.full() or r.len() != 3usize {
        return 3
    }
    if r.push(4) {
        return 4
    }
    match r.pop() {
        Some(v) => {
            if v != 1 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    if not r.push(4) or r.len() != 3usize {
        return 7
    }
    match r.peek() {
        Some(v) => {
            if v != 2 {
                return 8
            }
        }
        None => {
            return 9
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 2 {
                return 10
            }
        }
        None => {
            return 11
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 3 {
                return 12
            }
        }
        None => {
            return 13
        }
    }
    match r.pop() {
        Some(v) => {
            if v != 4 {
                return 14
            }
        }
        None => {
            return 15
        }
    }
    match r.pop() {
        Some(v) => {
            _ = v
            return 16
        }
        None => {
        }
    }
    if not r.push(5) or not r.push(6) {
        return 17
    }
    r.clear()
    if r.len() != 0usize or r.full() {
        return 18
    }
    match ring.Ring<i32>(0usize) {
        Ok(bad) => {
            _ = bad
            return 19
        }
        Err(e) => {
            if e.status() != 2 {
                return 20
            }
        }
    }
    return 0
}
