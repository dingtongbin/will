# Set keeps insertion order, Add reports whether the value was new, and Delete
# removes it.
def main() -> i32 {
    var s: Set<i32> = new Set<i32>(0usize)
    if not s.add(3) or not s.add(1) or s.add(3) {
        return 1
    }
    if s.len() != 2usize {
        return 2
    }
    if not s.has(1) or s.has(2) {
        return 3
    }
    if not s.delete(3) or s.len() != 1usize {
        return 4
    }
    if s.delete(3) {
        return 5
    }
    s.add(7)
    s.clear()
    if s.len() != 0usize or s.has(7) {
        return 6
    }
    return 0
}
