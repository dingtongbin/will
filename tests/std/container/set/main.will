// Set keeps insertion order, Add reports whether the value was new, and Delete
// removes it.
def main() -> i32 {
    var s: Set<i32> = new Set<i32>(0usize)
    if !s.add(3) || !s.add(1) || s.add(3) {
        return 1
    }
    if s.len() != 2usize {
        return 2
    }
    if !s.has(1) || s.has(2) {
        return 3
    }
    if !s.delete(3) || s.len() != 1usize {
        return 4
    }
    if s.delete(3) {
        return 5
    }
    s.add(7)
    s.clear()
    if s.len() != 0usize || s.has(7) {
        return 6
    }
    return 0
}
