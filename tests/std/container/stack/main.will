import "std/container/stack"

def main() -> i32 {
    var s: stack.Stack<i32> = new stack.Stack<i32>()
    s.push(1)
    s.push(2)
    s.push(3)
    s.reserve(8usize)
    if s.len() != 3usize {
        return 1
    }
    match s.peek() {
        Some(v) => {
            if v != 3 {
                return 2
            }
        }
        None => {
            return 3
        }
    }
    match s.pop() {
        Some(v) => {
            if v != 3 {
                return 4
            }
        }
        None => {
            return 5
        }
    }
    var copy: stack.Stack<i32> = s.clone()
    copy.push(9)
    if s.len() != 2usize or copy.len() != 3usize {
        return 6
    }
    copy.clear()
    if copy.len() != 0usize {
        return 7
    }
    return 0
}
