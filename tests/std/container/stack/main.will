import "std/container/stack"

def main() -> i32 {
    var s: stack.Stack<i32> = new stack.Stack<i32>()
    s.Push(1)
    s.Push(2)
    s.Push(3)
    s.Reserve(8usize)
    if s.Len() != 3usize {
        return 1
    }
    match s.Peek() {
        Some(v) => {
            if v != 3 {
                return 2
            }
        }
        None => {
            return 3
        }
    }
    match s.Pop() {
        Some(v) => {
            if v != 3 {
                return 4
            }
        }
        None => {
            return 5
        }
    }
    var copy: stack.Stack<i32> = s.Clone()
    copy.Push(9)
    if s.Len() != 2usize || copy.Len() != 3usize {
        return 6
    }
    copy.Clear()
    if copy.Len() != 0usize {
        return 7
    }
    return 0
}
