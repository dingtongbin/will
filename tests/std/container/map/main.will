# Map is insertion ordered in this implementation. Set replaces a value,
# Delete removes one entry, and Keys/Values copy the live entries.
def main() -> i32 {
    var m: dict[str, i32] = dict[str, i32](0usize)
    if m.len() != 0usize {
        return 1
    }
    m.set("a", 1)
    m.set("b", 2)
    m.set("a", 3)
    if m.len() != 2usize {
        return 2
    }
    if not m.has("a") or m.has("c") {
        return 3
    }
    match m.get("a") {
        Some(v) => {
            if v != 3 {
                return 4
            }
        }
        None => {
            return 5
        }
    }
    match m.get("c") {
        Some(v) => {
            _ = v
            return 6
        }
        None => {
        }
    }
    var keys: list[str] = m.keys()
    if keys.len() != 2usize or keys.get(0usize) != "a" or keys.get(1usize) != "b" {
        return 7
    }
    var values: list[i32] = m.values()
    if values.len() != 2usize or values.get(0usize) != 3 or values.get(1usize) != 2 {
        return 8
    }
    if not m.delete("a") or m.len() != 1usize {
        return 9
    }
    if m.delete("a") {
        return 10
    }
    m.set("c", 4)
    m.clear()
    if m.len() != 0usize or m.has("c") {
        return 11
    }
    var nested: dict[str, Array<i32>] = dict[str, Array<i32>](0usize)
    var nestedValues: Array<i32> = new Array<i32>(0usize)
    nestedValues.push(1)
    nested.set("a", nestedValues)
    nestedValues.push(2)
    match nested.get("a") {
        Some(copy) => {
            if copy.len() != 1usize or copy.get(0usize) != 1 {
                return 12
            }
        }
        None => {
            return 13
        }
    }
    nested.clear()
    return 0
}
