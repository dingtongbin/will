import "std/container/tree"

func Less(a: i32, b: i32) -> bool {
    return a < b
}

// Tree must keep ordered lookups correct through rotations and through both
// one-child and two-child deletion.
func main() -> i32 {
    var t: tree.Tree<i32, i32> = new tree.Tree<i32, i32>(Less)
    if t.Len() != 0usize {
        return 1
    }
    t.Set(5, 50)
    t.Set(2, 20)
    t.Set(8, 80)
    t.Set(1, 10)
    t.Set(3, 30)
    t.Set(7, 70)
    t.Set(9, 90)
    t.Set(2, 21)
    if t.Len() != 7usize {
        return 2
    }
    match t.Get(2) {
        Some(v) => {
            if v != 21 {
                return 3
            }
        }
        None => {
            return 4
        }
    }
    match t.Get(4) {
        Some(v) => {
            _ = v
            return 5
        }
        None => {
        }
    }
    match t.Min() {
        Some(p) => {
            if p.first != 1 || p.second != 10 {
                return 6
            }
        }
        None => {
            return 7
        }
    }
    match t.Max() {
        Some(p) => {
            if p.first != 9 || p.second != 90 {
                return 8
            }
        }
        None => {
            return 9
        }
    }
    match t.Floor(6) {
        Some(p) => {
            if p.first != 5 {
                return 10
            }
        }
        None => {
            return 11
        }
    }
    match t.Ceil(6) {
        Some(p) => {
            if p.first != 7 {
                return 12
            }
        }
        None => {
            return 13
        }
    }
    if !t.Delete(8) || t.Len() != 6usize {
        return 14
    }
    if t.Delete(8) {
        return 15
    }
    match t.Get(8) {
        Some(v) => {
            _ = v
            return 16
        }
        None => {
        }
    }
    if !t.Delete(5) || t.Len() != 5usize {
        return 17
    }
    match t.Min() {
        Some(p) => {
            if p.first != 1 {
                return 18
            }
        }
        None => {
            return 19
        }
    }
    return 0
}
