import "std/container/tree"

def main() -> i32 {
    var t: tree.Tree<i32, i32> = tree.Tree<i32, i32>()
    if t.len() != 0usize {
        return 1
    }
    t.set(5, 50)
    t.set(2, 20)
    t.set(8, 80)
    t.set(1, 10)
    t.set(3, 30)
    t.set(7, 70)
    t.set(9, 90)
    match t.set(2, 21) {
        Some(v) => {
            if v != 20 {
                return 2
            }
        }
        None => {
            return 3
        }
    }
    if t.len() != 7usize {
        return 4
    }
    match t.get(2) {
        Some(v) => {
            if v != 21 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    match t.get(4) {
        Some(v) => {
            _ = v
            return 7
        }
        None => {
        }
    }
    var wantKeys: list[i32] = list[i32](7usize)
    wantKeys.push(1)
    wantKeys.push(2)
    wantKeys.push(3)
    wantKeys.push(5)
    wantKeys.push(7)
    wantKeys.push(8)
    wantKeys.push(9)
    var keys: list[i32] = t.keys()
    if keys.len() != 7usize {
        return 8
    }
    var values: list[i32] = t.values()
    if values.len() != 7usize {
        return 9
    }
    var i: usize = 0usize
    while i < 7usize {
        if keys.get(i) != wantKeys.get(i) {
            return 10
        }
        i += 1usize
    }
    match t.delete(2) {
        Some(v) => {
            if v != 21 {
                return 11
            }
        }
        None => {
            return 12
        }
    }
    if t.len() != 6usize {
        return 13
    }
    match t.delete(4) {
        Some(v) => {
            _ = v
            return 14
        }
        None => {
        }
    }
    t.clear()
    if t.len() != 0usize {
        return 15
    }
    return 0
}
