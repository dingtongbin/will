import "std/container/tree"

def less(a: i32, b: i32) -> bool {
    return a < b
}

# Tree must keep ordered lookups correct through rotations and through both
# one-child and two-child deletion.
def main() -> i32 {
    var t: tree.Tree<i32, i32> = new tree.Tree<i32, i32>(less)
    if t.len() != 0usize {
        return 1
    }
    t.set(5, 50)
    t.set(2, 20)
    t.set(8, 80)
    t.set(1, 10)
    t.set(3, 30)
    t.set(7, 70)
    t.set(9, 90)
    t.set(2, 21)
    if t.len() != 7usize {
        return 2
    }
    match t.get(2) {
        Some(v) => {
            if v != 21 {
                return 3
            }
        }
        None => {
            return 4
        }
    }
    match t.get(4) {
        Some(v) => {
            _ = v
            return 5
        }
        None => {
        }
    }
    match t.min() {
        Some(p) => {
            if p.first != 1 or p.second != 10 {
                return 6
            }
        }
        None => {
            return 7
        }
    }
    match t.max() {
        Some(p) => {
            if p.first != 9 or p.second != 90 {
                return 8
            }
        }
        None => {
            return 9
        }
    }
    match t.floor(6) {
        Some(p) => {
            if p.first != 5 {
                return 10
            }
        }
        None => {
            return 11
        }
    }
    match t.ceil(6) {
        Some(p) => {
            if p.first != 7 {
                return 12
            }
        }
        None => {
            return 13
        }
    }
    if not t.delete(8) or t.len() != 6usize {
        return 14
    }
    if t.delete(8) {
        return 15
    }
    match t.get(8) {
        Some(v) => {
            _ = v
            return 16
        }
        None => {
        }
    }
    if not t.delete(5) or t.len() != 5usize {
        return 17
    }
    match t.min() {
        Some(p) => {
            if p.first != 1 {
                return 18
            }
        }
        None => {
            return 19
        }
    }
    return 0
}
