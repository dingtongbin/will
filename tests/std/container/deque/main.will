import "std/container/deque"

def main() -> i32 {
    var d: deque.Deque<i32> = deque.Deque<i32>(4usize)
    if d.len() != 0usize {
        return 1
    }
    d.push_back(3)
    d.push_back(4)
    d.push_front(2)
    d.push_front(1)
    if d.len() != 4usize {
        return 2
    }
    if d.get(0usize) != 1 or d.get(3usize) != 4 {
        return 3
    }
    d.set(1usize, 5)
    if d.get(1usize) != 5 {
        return 4
    }
    match d.pop_back() {
        Some(v) => {
            if v != 4 {
                return 5
            }
        }
        None => {
            return 6
        }
    }
    match d.pop_front() {
        Some(v) => {
            if v != 1 {
                return 7
            }
        }
        None => {
            return 8
        }
    }
    d.push_back(9)
    d.push_front(8)
    if d.len() != 4usize or d.get(0usize) != 8 or d.get(3usize) != 9 {
        return 9
    }
    d.clear()
    if d.len() != 0usize {
        return 10
    }
    return 0
}
