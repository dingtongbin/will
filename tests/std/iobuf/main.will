import "std/io/buf"

def main() -> i32 {
    var b: buf.Buffer = new buf.Buffer()
    b.data.push(65u8)
    b.data.push(66u8)
    if b.len() != 2usize {
        return 1
    }
    var view: []u8 = b.bytes()
    if view.get(0) != 65u8 || view.get(1) != 66u8 {
        return 2
    }
    b.clear()
    if b.len() != 0usize {
        return 3
    }

    var p: buf.PooledBuffer = buf.pooled(8usize)
    p.data.push(67u8)
    if p.len() != 1usize || p.array().get(0) != 67u8 {
        return 4
    }
    p.release()
    return 0
}
