import "std/fmt"
import "std/io"

# NullWriter counts the bytes it is asked to write and discards them.
struct NullWriter {
    n: usize
}

def (w: NullWriter) write(buf: []u8) -> Result<(), Error> {
    return Ok(())
}

def (w: NullWriter) sync() -> Result<(), Error> {
    return Ok(())
}

# Wrap holds a Writer as a field and forwards both methods, so the method set
# of the field type is reached from another package.
struct Wrap {
    inner: io.Writer
}

def (w: Wrap) write(buf: []u8) -> Result<(), Error> {
    return w.inner.write(buf)
}

def (w: Wrap) sync() -> Result<(), Error> {
    return w.inner.sync()
}

# sink takes the interface and calls a method whose result is an enum.
def sink(w: io.Writer) -> Result<(), Error> {
    var storage: Array<u8> = new Array<u8>(0)
    var bytes: []u8 = storage[Range(0, storage.len())]
    _ = w.write(bytes)?
    _ = w.sync()?
    return Ok(())
}

# Recorder notes the first and last byte it was handed and how many there
# were, so a formatted write can be checked without keeping the bytes.
var written: usize = 0
var first: u8 = 0u8
var last: u8 = 0u8

struct Recorder {
    pad: usize
}

def (w: Recorder) write(buf: []u8) -> Result<(), Error> {
    var i: usize = 0
    while True {
        if i >= buf.len() {
            break
        }
        if written == 0usize and i == 0usize {
            first = buf[i]
        }
        last = buf[i]
        i += 1
    }
    written += buf.len()
    return Ok(())
}

def (w: Recorder) sync() -> Result<(), Error> {
    return Ok(())
}

def check_printf() -> i32 {
    written = 0usize
    first = 0u8
    last = 0u8
    match fmt.printf(Recorder{pad: 0usize}, "ab", 42i32) {
        Ok(_) => {}
        Err(_) => {
            return 3
        }
    }
    if written != 4usize {
        return 4
    }
    if first != 97u8 or last != 50u8 {
        return 5
    }
    return 0
}

def main() -> i32 {
    fmt.println("writer", 1i32)
    var null: NullWriter = NullWriter{n: 0}
    var wrapped: Wrap = Wrap{inner: null}
    match sink(wrapped) {
        Ok(_) => {}
        Err(_) => {
            return 1
        }
    }
    var code: i32 = check_printf()
    if code != 0 {
        return code
    }
    return 0
}
