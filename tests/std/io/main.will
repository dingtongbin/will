import "std/io"
import "std/os/fs"

async def check_read_all() -> i32 {
    var path: str = "will-io-probe.tmp"
    var made: Result<fs.File, Error> = await fs.create(path, 420u32)
    match made {
        Ok(file) => {
            var text: str = "abc"
            _ = await file.write(text[Range(0, 3)])
            _ = await file.seek(0i64, 0)
            var buf: Array<u8> = new Array<u8>(0)
            var count: usize = (await io.read_all(file, buf))!
            _ = file.close()
            _ = await fs.remove(path)
            if count != 3usize or buf.len() != 3usize {
                return 5
            }
        }
        Err(_) => {
            return 6
        }
    }
    return 0
}

async def main() -> i32 {
    var readCode: i32 = await check_read_all()
    if readCode != 0 {
        return readCode
    }
    var poller: io.Poller = io.new_poller()
    var out: Array<usize> = new Array<usize>(0)
    var next: Result<usize, Error> = poller.next_blocking(0ns, out)
    match next {
        Ok(count) => {
            if count != 0usize {
                return 1
            }
        }
        Err(_) => {
            return 2
        }
    }

    var asyncNext: Result<usize, Error> = await poller.next(0ns, out)
    match asyncNext {
        Ok(count) => {
            if count != 0usize {
                return 7
            }
        }
        Err(_) => {
            return 8
        }
    }

    var bad: Result<(), Error> = poller.add(-1i64, 1usize)
    match bad {
        Err(e) => {
            if e.status() != 2 {
                return 3
            }
        }
        _ => {
            return 4
        }
    }
    return 0
}
