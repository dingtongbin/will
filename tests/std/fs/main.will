import "std/os/fs"

async def check_file() -> i32 {
    var path: str = "will-fs-probe.tmp"
    var data: str = "hello"
    var bytes: []u8 = data[Range(0, 5)]
    var created: Result<fs.File, Error> = await fs.create(path, 420u32)
    match created {
        Ok(file) => {
            var wrote: Result<(), Error> = await file.write(bytes)
            match wrote {
                Err(e) => {
                    if e.status() != 7 {
                        return 1
                    }
                    return 2
                }
                _ => {}
            }
            var synced: Result<(), Error> = await file.sync()
            match synced {
                Err(e) => {
                    if e.status() != 7 {
                        return 3
                    }
                    return 4
                }
                _ => {}
            }
            var seeked: Result<i64, Error> = await file.seek(0i64, 0)
            match seeked {
                Err(e) => {
                    if e.status() != 7 {
                        return 5
                    }
                    return 6
                }
                _ => {}
            }
            var buf: Array<u8> = new Array<u8>(16)
            var read: Result<usize, Error> = await file.read(buf)
            match read {
                Ok(count) => {
                    if count != 5usize or buf.len() != 5usize {
                        return 7
                    }
                    if buf.get(0) != 104u8 or buf.get(4) != 111u8 {
                        return 8
                    }
                }
                Err(e) => {
                    if e.status() != 7 {
                        return 9
                    }
                    return 10
                }
            }
            var closed: Result<(), Error> = file.close()
            match closed {
                Err(e) => {
                    if e.status() != 7 {
                        return 11
                    }
                    return 12
                }
                _ => {}
            }
        }
        Err(e) => {
            if e.status() != 7 {
                return 13
            }
            return 14
        }
    }

    var flags: fs.OpenFlags = fs.OpenFlags { read: True, write: False, create: False, append: False, truncate: False, exclusive: False }
    var opened: Result<fs.File, Error> = await fs.open(path, flags)
    match opened {
        Ok(file) => {
            _ = file.close()
        }
        Err(_) => {
            return 28
        }
    }

    var info: Result<fs.StatInfo, Error> = await fs.stat(path)
    match info {
        Ok(stat) => {
            if stat.size != 5i64 or stat.isDir {
                return 15
            }
        }
        Err(e) => {
            if e.status() != 7 {
                return 16
            }
            return 17
        }
    }

    var renamed: Result<(), Error> = await fs.rename(path, "will-fs-probe2.tmp")
    match renamed {
        Err(e) => {
            if e.status() != 7 {
                return 18
            }
            return 19
        }
        _ => {}
    }
    var removed: Result<(), Error> = await fs.remove("will-fs-probe2.tmp")
    match removed {
        Err(e) => {
            if e.status() != 7 {
                return 20
            }
            return 21
        }
        _ => {}
    }
    return 0
}

async def check_dir() -> i32 {
    var first: str = "will-fs-a.tmp"
    var second: str = "will-fs-b.tmp"
    var a: Result<fs.File, Error> = await fs.create(first, 420u32)
    match a {
        Ok(file) => {
            _ = file.close()
        }
        Err(_) => {
            return 26
        }
    }
    var b: Result<fs.File, Error> = await fs.create(second, 420u32)
    match b {
        Ok(file) => {
            _ = file.close()
        }
        Err(_) => {
            _ = await fs.remove(first)
            return 27
        }
    }

    var dir: Result<Array<fs.DirEntry>, Error> = await fs.read_dir(".")
    match dir {
        Ok(entries) => {
            var aPos: i32 = -1
            var bPos: i32 = -1
            for i in Range(0, i32(entries.len())) {
                var entry: fs.DirEntry = entries.get(usize(i)).clone()
                if entry.name == first {
                    aPos = i
                }
                if entry.name == second {
                    bPos = i
                }
            }
            _ = await fs.remove(first)
            _ = await fs.remove(second)
            if aPos < 0 or bPos < 0 or aPos > bPos {
                return 23
            }
        }
        Err(e) => {
            _ = await fs.remove(first)
            _ = await fs.remove(second)
            if e.status() != 7 {
                return 24
            }
            return 25
        }
    }
    return 0
}

async def check_async() -> i32 {
    var path: str = "will-fs-async.tmp"
    var text: str = "async"
    var data: []u8 = text[Range(0, 5)]
    var written: Result<(), Error> = await fs.write_file(path, data)
    match written {
        Err(_) => {
            return 30
        }
        _ => {}
    }
    var loaded: Result<Array<u8>, Error> = await fs.read_file(path)
    match loaded {
        Ok(bytes) => {
            if bytes.len() != 5usize or bytes.get(0) != 97u8 {
                _ = await fs.remove(path)
                return 31
            }
            _ = await fs.remove(path)
        }
        Err(_) => {
            return 32
        }
    }
    return 0
}

async def main() -> i32 {
    var code: i32 = await check_file()
    if code != 0 {
        return code
    }
    code = await check_dir()
    if code != 0 {
        return code
    }
    return await check_async()
}
