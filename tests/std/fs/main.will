import "std/os/fs"

func CheckFile() -> i32 {
    var path: str = "will-fs-probe.tmp"
    var data: str = "hello"
    var bytes: []u8 = data[Range(0, 5)]
    var created: Result<fs.File, Error> = fs.Create(path, 420u32)
    match created {
        Ok(file) => {
            var wrote: Result<(), Error> = file.Write(bytes)
            match wrote {
                Err(e) => {
                    if e.Status() != 7 {
                        return 1
                    }
                    return 2
                }
                _ => {}
            }
            var synced: Result<(), Error> = file.Sync()
            match synced {
                Err(e) => {
                    if e.Status() != 7 {
                        return 3
                    }
                    return 4
                }
                _ => {}
            }
            var seeked: Result<i64, Error> = file.Seek(0i64, 0)
            match seeked {
                Err(e) => {
                    if e.Status() != 7 {
                        return 5
                    }
                    return 6
                }
                _ => {}
            }
            var buf: Array<u8> = new Array<u8>(16)
            var read: Result<usize, Error> = file.Read(buf)
            match read {
                Ok(count) => {
                    if count != 5usize || buf.Len() != 5usize {
                        return 7
                    }
                    if buf.Get(0) != 104u8 || buf.Get(4) != 111u8 {
                        return 8
                    }
                }
                Err(e) => {
                    if e.Status() != 7 {
                        return 9
                    }
                    return 10
                }
            }
            var closed: Result<(), Error> = file.Close()
            match closed {
                Err(e) => {
                    if e.Status() != 7 {
                        return 11
                    }
                    return 12
                }
                _ => {}
            }
        }
        Err(e) => {
            if e.Status() != 7 {
                return 13
            }
            return 14
        }
    }

    var flags: fs.OpenFlags = fs.OpenFlags { read: true, write: false, create: false, append: false, truncate: false, exclusive: false }
    var opened: Result<fs.File, Error> = fs.Open(path, flags)
    match opened {
        Ok(file) => {
            _ = file.Close()
        }
        Err(_) => {
            return 28
        }
    }

    var info: Result<fs.StatInfo, Error> = fs.Stat(path)
    match info {
        Ok(stat) => {
            if stat.size != 5i64 || stat.isDir {
                return 15
            }
        }
        Err(e) => {
            if e.Status() != 7 {
                return 16
            }
            return 17
        }
    }

    var renamed: Result<(), Error> = fs.Rename(path, "will-fs-probe2.tmp")
    match renamed {
        Err(e) => {
            if e.Status() != 7 {
                return 18
            }
            return 19
        }
        _ => {}
    }
    var removed: Result<(), Error> = fs.Remove("will-fs-probe2.tmp")
    match removed {
        Err(e) => {
            if e.Status() != 7 {
                return 20
            }
            return 21
        }
        _ => {}
    }
    return 0
}

func CheckDir() -> i32 {
    var first: str = "will-fs-a.tmp"
    var second: str = "will-fs-b.tmp"
    var a: Result<fs.File, Error> = fs.Create(first, 420u32)
    match a {
        Ok(file) => {
            _ = file.Close()
        }
        Err(_) => {
            return 26
        }
    }
    var b: Result<fs.File, Error> = fs.Create(second, 420u32)
    match b {
        Ok(file) => {
            _ = file.Close()
        }
        Err(_) => {
            _ = fs.Remove(first)
            return 27
        }
    }

    var dir: Result<Array<fs.DirEntry>, Error> = fs.ReadDir(".")
    match dir {
        Ok(entries) => {
            var aPos: i32 = -1
            var bPos: i32 = -1
            for i in Range(0, i32(entries.Len())) {
                var entry: fs.DirEntry = entries.Get(usize(i))
                if entry.name == first {
                    aPos = i
                }
                if entry.name == second {
                    bPos = i
                }
            }
            _ = fs.Remove(first)
            _ = fs.Remove(second)
            if aPos < 0 || bPos < 0 || aPos > bPos {
                return 23
            }
        }
        Err(e) => {
            _ = fs.Remove(first)
            _ = fs.Remove(second)
            if e.Status() != 7 {
                return 24
            }
            return 25
        }
    }
    return 0
}

func CheckAsync() -> i32 {
    var path: str = "will-fs-async.tmp"
    var text: str = "async"
    var data: []u8 = text[Range(0, 5)]
    var written: Result<(), Error> = fs.AsyncWriteFile(path, data)
    match written {
        Err(_) => {
            return 30
        }
        _ => {}
    }
    var loaded: Result<Array<u8>, Error> = fs.AsyncReadFile(path)
    match loaded {
        Ok(bytes) => {
            if bytes.Len() != 5usize || bytes.Get(0) != 97u8 {
                _ = fs.Remove(path)
                return 31
            }
            _ = fs.Remove(path)
        }
        Err(_) => {
            return 32
        }
    }
    return 0
}

func main() -> i32 {
    var code: i32 = CheckFile()
    if code != 0 {
        return code
    }
    code = CheckDir()
    if code != 0 {
        return code
    }
    return CheckAsync()
}
