import "std/encoding/base64"

def sum(b: list[u8]) -> i32 {
    var total: i32 = 0
    var i: usize = 0
    for v in b {
        total += i32(v) * i32(i + 1)
        i += 1
    }
    return total
}

def main() -> i32 {
    var total: i32 = 0
    var plain: Result<list[u8], Error> = base64.decode("SGVsbG8=")
    match plain {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    var url: Result<list[u8], Error> = base64.decode_url("_-8=")
    match url {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    var bad: Result<list[u8], Error> = base64.decode("SGVsbG8")
    match bad {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    return total
}
