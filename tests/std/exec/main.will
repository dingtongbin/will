import "std/os/exec"

async def main() -> i32 {
    var command: exec.Cmd = exec.command("cmd", "/C", "echo hi")
    var out: Result<exec.Output, Error> = await command.output()
    match out {
        Ok(value) => {
            if value.status.code != 0 {
                return 1
            }
            if value.stdout.len() == 0usize {
                return 2
            }
        }
        Err(_) => {
            return 3
        }
    }

    var failing: exec.Cmd = exec.command("cmd", "/C", "exit 3")
    var status: Result<exec.ExitStatus, Error> = await failing.run()
    match status {
        Ok(value) => {
            if value.code != 3 {
                return 4
            }
        }
        Err(_) => {
            return 5
        }
    }
    return 0
}
