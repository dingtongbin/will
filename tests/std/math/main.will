import "std/math"

def main() -> i32 {
    var ok: i32 = 0
    if math.abs(-2.5) == 2.5 {
        ok += 1
    }
    if math.abs(3.5) == 3.5 {
        ok += 1
    }
    if math.min(1.0, 2.0) == 1.0 {
        ok += 1
    }
    if math.max(1.0, 2.0) == 2.0 {
        ok += 1
    }
    if math.clamp(5.0, 0.0, 3.0) == 3.0 {
        ok += 1
    }
    if math.clamp(-5.0, 0.0, 3.0) == 0.0 {
        ok += 1
    }
    if math.sign(-2.0) == -1.0 {
        ok += 1
    }
    if math.sign(0.0) == 0.0 {
        ok += 1
    }
    if !math.is_na_n(1.0) {
        ok += 1
    }
    if !math.is_inf(1.0) {
        ok += 1
    }
    if math.is_finite(1.0) {
        ok += 1
    }
    var negative: i64 = -3i64
    if math.abs_i64(negative) == 3i64 {
        ok += 1
    }
    if math.abs_i32(-4) == 4 {
        ok += 1
    }
    if math.min_i64(1i64, 2i64) == 1i64 {
        ok += 1
    }
    if math.max_i64(1i64, 2i64) == 2i64 {
        ok += 1
    }
    if math.min_u64(1u64, 2u64) == 1u64 {
        ok += 1
    }
    if math.max_u64(1u64, 2u64) == 2u64 {
        ok += 1
    }
    if math.clamp_i64(5i64, 0i64, 3i64) == 3i64 {
        ok += 1
    }
    var negativeSign: i64 = -9i64
    if math.sign_i64(negativeSign) == -1i64 {
        ok += 1
    }
    if math.pop_count64(255u64) == 8u32 {
        ok += 1
    }
    if math.trailing_zeros64(8u64) == 3u32 {
        ok += 1
    }
    if math.leading_zeros64(1u64) == 63u32 {
        ok += 1
    }
    if math.rotate_left64(1u64, 1u64) == 2u64 {
        ok += 1
    }
    if math.rotate_right64(2u64, 1u64) == 1u64 {
        ok += 1
    }
    if math.I64Max > 0i64 {
        ok += 1
    }
    if math.U64Max > 0u64 {
        ok += 1
    }
    if math.f64_bits(1.0) == 0x3ff0000000000000u64 {
        ok += 1
    }
    if math.f64_from_bits(0x3ff0000000000000u64) == 1.0 {
        ok += 1
    }
    var one32: f32 = 1.0
    if math.f32_bits(one32) == 0x3f800000u32 {
        ok += 1
    }
    if math.f32_from_bits(0x3f800000u32) == one32 {
        ok += 1
    }
    return ok
}
