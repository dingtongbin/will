import "std/os/path"

# The expected text is built from Separator so this corpus passes on every
# target. Both slash spellings are accepted as input; output uses the host one.
def main() -> i32 {
    var sep: str = str(u32(path.separator()))
    if path.clean("a/./b") != "a" + sep + "b" {
        return 1
    }
    if path.clean("a\\b") != "a" + sep + "b" {
        return 2
    }
    if path.clean("a/../b") != "b" {
        return 3
    }
    if path.join("a", "b") != "a" + sep + "b" {
        return 4
    }
    if path.join("", "") != "" {
        return 5
    }
    if path.base("a/b/") != "b" {
        return 6
    }
    if path.ext("a/b.txt") != ".txt" {
        return 7
    }
    if not path.is_abs(sep + "a") {
        return 8
    }
    if path.is_abs("a" + sep + "b") {
        return 9
    }
    var abs: str = path.abs("a")!
    if not path.is_abs(abs) {
        return 10
    }
    if not path.glob("*.txt", "a.txt") {
        return 11
    }
    if path.glob("*.txt", "a/b.txt") {
        return 12
    }
    if path.separator() == 92u8 {
        if path.clean("C:\\a\\..\\b") != "C:" + sep + "b" {
            return 13
        }
        if path.base("C:\\") != sep {
            return 14
        }
        if path.dir("C:\\a\\b") != "C:" + sep + "a" {
            return 15
        }
        if not path.is_abs("C:\\a") {
            return 16
        }
    }
    return 0
}
