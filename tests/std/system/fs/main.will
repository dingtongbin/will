import "std/os/fs"

def main() -> i32 {
    var path: str = "will-fs-contract.bin"
    var data: Array<u8> = new Array<u8>(0)
    data.push(65u8)
    data.push(66u8)
    var wrote: Result<(), Error> = fs.write_file(path, data[Range(0, data.len())])
    _ = wrote
    var read: Result<Array<u8>, Error> = fs.read_file(path)
    var got: Array<u8> = new Array<u8>(0)
    match read {
        Ok(v) => { got = v }
        Err(e) => { _ = e }
    }
    if got.len() != 2usize {
        return 1
    }
    if got.get(0) != 65u8 or got.get(1) != 66u8 {
        return 2
    }
    return 0
}
