import "std/os/fs"

async def main() -> i32 {
    var path: str = "will-fs-contract.bin"
    var data: list[u8] = list[u8](0)
    data.push(65u8)
    data.push(66u8)
    var wrote: Result<(), Error> = await fs.write_file(path, data[Range(0, data.len())])
    _ = wrote
    var read: Result<list[u8], Error> = await fs.read_file(path)
    var got: list[u8] = list[u8](0)
    match read {
        Ok(v) => { got = v.clone() }
        Err(e) => { _ = e }
    }
    if got.len() != 2usize {
        return 1
    }
    if got.get(0) != 65u8 or got.get(1) != 66u8 {
        return 2
    }
    return 0
}
