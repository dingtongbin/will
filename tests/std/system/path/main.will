import "std/os/path"

# Clean must drop empty and dot elements, resolve dot-dot where it can, keep a
# leading dot-dot on a relative path, and name the empty result "." or "/".
def main() -> i32 {
    if path.clean("") != "." {
        return 1
    }
    if path.clean(".") != "." {
        return 2
    }
    if path.clean("..") != ".." {
        return 3
    }
    if path.clean("a/./b") != "a/b" {
        return 4
    }
    if path.clean("a//b") != "a/b" {
        return 5
    }
    if path.clean("a/../b") != "b" {
        return 6
    }
    if path.clean("a/..") != "." {
        return 7
    }
    if path.clean("../a") != "../a" {
        return 8
    }
    if path.clean("/") != "/" {
        return 9
    }
    if path.clean("//") != "/" {
        return 10
    }
    if path.clean("/..") != "/" {
        return 11
    }
    if path.clean("/../a") != "/a" {
        return 12
    }
    if path.clean("a/") != "a" {
        return 13
    }
    if path.clean("/a/b/../c/") != "/a/c" {
        return 14
    }
    if path.clean("/h\xc3\xa9llo/") != "/h\xc3\xa9llo" {
        return 15
    }
    # A zero-part path join is written as Join("", ""), which also returns "".
    if path.join("", "") != "" {
        return 16
    }
    if path.join("a") != "a" {
        return 17
    }
    if path.join("a", "b") != "a/b" {
        return 18
    }
    if path.join("a/", "/b") != "a/b" {
        return 19
    }
    if path.join("a", "..") != "." {
        return 20
    }
    if path.join("/", "a") != "/a" {
        return 21
    }
    if path.join("", "a", "") != "a" {
        return 22
    }
    # Dir keeps everything before the last separator and cleans it.
    if path.dir("") != "." {
        return 23
    }
    if path.dir("/") != "/" {
        return 24
    }
    if path.dir("/a") != "/" {
        return 25
    }
    if path.dir("a") != "." {
        return 26
    }
    if path.dir("a/b") != "a" {
        return 27
    }
    if path.dir("a/b/") != "a/b" {
        return 28
    }
    if path.dir("//a") != "/" {
        return 29
    }
    if path.dir("/h\xc3\xa9llo/x") != "/h\xc3\xa9llo" {
        return 30
    }
    # Base is the last element after trailing separators are dropped.
    if path.base("") != "." {
        return 31
    }
    if path.base("/") != "/" {
        return 32
    }
    if path.base("//") != "/" {
        return 33
    }
    if path.base("a/") != "a" {
        return 34
    }
    if path.base("/a") != "a" {
        return 35
    }
    if path.base("a/b/") != "b" {
        return 36
    }
    if path.base("/h\xc3\xa9llo") != "h\xc3\xa9llo" {
        return 37
    }
    # Ext starts at the final dot of the last element; a dotfile has one.
    if path.ext("") != "" {
        return 38
    }
    if path.ext("a") != "" {
        return 39
    }
    if path.ext("a.") != "." {
        return 40
    }
    if path.ext(".txt") != ".txt" {
        return 41
    }
    if path.ext("a.txt") != ".txt" {
        return 42
    }
    if path.ext("a.b/c") != "" {
        return 43
    }
    if path.ext("a/b.c") != ".c" {
        return 44
    }
    if path.ext("/h\xc3\xa9llo/x.txt") != ".txt" {
        return 45
    }
    if path.is_abs("") {
        return 46
    }
    if not path.is_abs("/") {
        return 47
    }
    if not path.is_abs("/a") {
        return 48
    }
    if path.is_abs("a") {
        return 49
    }
    if path.is_abs("./a") {
        return 50
    }
    # Match is anchored, and neither wildcard crosses the separator.
    if not path.match("*.txt", "a.txt") {
        return 51
    }
    if path.match("*.txt", "a.txt.bak") {
        return 52
    }
    if not path.match("a?c", "abc") {
        return 53
    }
    if path.match("a?c", "ac") {
        return 54
    }
    if not path.match("*", "abc") {
        return 55
    }
    if not path.match("*", "") {
        return 56
    }
    if path.match("*", "a/b") {
        return 57
    }
    if not path.match("a/*", "a/b") {
        return 58
    }
    if path.match("a/*", "a/b/c") {
        return 59
    }
    if not path.match("", "") {
        return 60
    }
    if path.match("", "a") {
        return 61
    }
    if not path.match("a*b*c", "aXbYc") {
        return 62
    }
    if path.match("a*b*c", "aXbY") {
        return 63
    }
    if path.match("a?b", "a/b") {
        return 64
    }
    if not path.match("/a/*", "/a/b") {
        return 65
    }
    if not path.match("src-?-main.will", "src-a-main.will") {
        return 66
    }
    if path.ext("a.tar.gz") != ".gz" {
        return 67
    }
    if path.clean("./..") != ".." {
        return 68
    }
    if path.base("...") != "..." {
        return 69
    }
    if not path.match("*", ".") {
        return 70
    }
    if not path.is_abs("//a") {
        return 71
    }
    if path.clean("a/./") != "a" {
        return 72
    }
    # A long name exercises the star loop without recursion.
    if not path.match("*", "a".repeat(1000usize)) {
        return 73
    }
    if path.match("*", "a".repeat(1000usize) + "/b") {
        return 74
    }
    return 0
}
