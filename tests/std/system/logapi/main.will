import "std/log"

// The level values and the enabled filter are the parts of std/log this corpus
// can exercise. A logger would call a sink method that has no result, and such
// a call still lowers to LLVM that llvm-as rejects.
func main() -> i32 {
    if !log.Enabled(log.Level.Warn(), log.Level.Info()) {
        return 1
    }
    if log.Enabled(log.Level.Debug(), log.Level.Info()) {
        return 2
    }
    if !log.Enabled(log.Level.Error(), log.Level.Error()) {
        return 3
    }
    if !log.Enabled(log.Level.Info(), log.Level.Debug()) {
        return 4
    }
    return 0
}
