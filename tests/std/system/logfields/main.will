import "std/log"

func main() -> i32 {
    var a: log.FieldValue = log.Str("path")
    var b: log.FieldValue = log.Int(7)
    var c: log.FieldValue = log.Uint(8)
    var d: log.FieldValue = log.Float(1.5)
    var e: log.FieldValue = log.Bool(true)
    var f: log.Field = log.Field { key: "k", value: a }
    _ = b
    _ = c
    _ = d
    _ = e
    _ = f
    return 0
}
