import "std/time"

# The named formats are pure functions of an instant, so a corpus can pin
# every field of the calendar and clock they write.
def main() -> i32 {
    var t: time.Instant = time.from_unix(1700000000i64)
    if time.rfc3339(t) != "2023-11-14T22:13:20Z" {
        return 1
    }
    if time.rfc3339_nano(t) != "2023-11-14T22:13:20Z" {
        return 2
    }
    if time.rfc1123(t) != "Tue, 14 Nov 2023 22:13:20 GMT" {
        return 3
    }
    if time.date(t) != "2023-11-14" {
        return 4
    }
    if time.clock(t) != "22:13:20" {
        return 5
    }
    var east: time.Instant = time.in_zone(t, time.fixed(3600))
    if time.rfc3339(east) != "2023-11-14T23:13:20+01:00" {
        return 6
    }
    if time.date(east) != "2023-11-14" {
        return 7
    }
    if time.clock(east) != "23:13:20" {
        return 8
    }
    var west: time.Instant = time.in_zone(t, time.fixed(-18000))
    if time.rfc3339(west) != "2023-11-14T17:13:20-05:00" {
        return 9
    }
    # One second before the epoch belongs to the previous day in UTC.
    var before: time.Instant = time.from_unix(-1i64)
    if time.rfc3339(before) != "1969-12-31T23:59:59Z" {
        return 10
    }
    if time.date(before) != "1969-12-31" {
        return 11
    }
    # A leap day is the day a plain four-year rule would miss.
    var leap: time.Instant = time.from_unix(1709164800i64)
    if time.date(leap) != "2024-02-29" {
        return 12
    }
    if time.rfc1123(leap) != "Thu, 29 Feb 2024 00:00:00 GMT" {
        return 13
    }
    return 0
}
