import "std/task"

def main() -> i32 {
    var values: Array<i32> = new Array<i32>(4)
    values.push(1)
    values.push(2)
    values.push(3)
    values.push(4)

    var view: []i32 = values[Range(0, values.len())]
    var doubled: Array<i32> = task.parallel_map(view, func(x: i32) -> i32 {
        return x * 2
    })
    if doubled.len() != 4usize {
        return 1
    }
    if doubled.get(0) != 2 || doubled.get(3) != 8 {
        return 2
    }

    task.parallel_for(4usize, func(i: usize) {
        _ = i
    })

    var cancel: task.cancel = new task.cancel()
    if cancel.canceled() {
        return 4
    }
    cancel.cancel()
    if !cancel.canceled() {
        return 5
    }
    return 0
}
