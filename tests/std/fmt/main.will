import "std/fmt"

import "std/math"

// eq reports whether got equals want. A mismatch prints both values once, so a
// failing case names itself without a table of expected text.
def eq(got: str, want: str) -> i32 {
    if got == want {
        return 1
    }
    print("got [", got, "] want [", want, "]\n")
    return 0
}

def main() -> i32 {
    var passed: i32 = 0
    passed += eq(fmt.int(0i64, 10, 0, 48u8).show(), "0")
    passed += eq(fmt.int(-5i64, 10, 4, 48u8).show(), "-005")
    passed += eq(fmt.int(42i64, 10, 5, 32u8).show(), "   42")
    passed += eq(fmt.int(-3i64, 10, 2, 32u8).show(), "-3")
    passed += eq(fmt.int(7i64, 10, -3, 48u8).show(), "7")
    passed += eq(fmt.int(9223372036854775807i64, 10, 0, 48u8).show(), "9223372036854775807")
    passed += eq(fmt.int(-9223372036854775807i64 - 1i64, 10, 0, 48u8).show(), "-9223372036854775808")
    passed += eq(fmt.int(255i64, 2, 10, 48u8).show(), "0011111111")
    passed += eq(fmt.int(-255i64, 16, 0, 48u8).show(), "-ff")
    passed += eq(fmt.uint(255u64, 16, 4, 48u8).show(), "00ff")
    passed += eq(fmt.uint(5u64, 2, 8, 48u8).show(), "00000101")
    passed += eq(fmt.uint(35u64, 36, 0, 48u8).show(), "z")
    passed += eq(fmt.uint(0u64, 10, 3, 32u8).show(), "  0")
    passed += eq(fmt.uint(18446744073709551615u64, 10, 0, 48u8).show(), "18446744073709551615")
    passed += eq(fmt.hex(255u64).show(), "ff")
    passed += eq(fmt.hex(0u64).show(), "0")
    passed += eq(fmt.pad("ab", 4, 46u8, false).show(), "ab..")
    passed += eq(fmt.pad("ab", 4, 46u8, true).show(), "..ab")
    passed += eq(fmt.pad("abcd", 2, 46u8, false).show(), "abcd")
    passed += eq(fmt.pad("", 3, 120u8, false).show(), "xxx")
    passed += eq(fmt.int(255i64, 16, 6, 48u8).show(), "0000ff")
    passed += eq(fmt.int(-1i64, 2, 0, 48u8).show(), "-1")
    passed += eq(fmt.uint(8u64, 8, 0, 48u8).show(), "10")
    passed += eq(fmt.hex(3735928559u64).show(), "deadbeef")
    passed += eq(fmt.float(3.14159, 2, 0, 48u8).show(), "3.14")
    passed += eq(fmt.float(-3.14159, 2, 0, 48u8).show(), "-3.14")
    passed += eq(fmt.float(0.0, 2, 0, 48u8).show(), "0.00")
    passed += eq(fmt.float(-0.0, 2, 0, 48u8).show(), "-0.00")
    passed += eq(fmt.float(2.675, 2, 0, 48u8).show(), "2.67")
    passed += eq(fmt.float(1.005, 2, 0, 48u8).show(), "1.00")
    passed += eq(fmt.float(2.5, 0, 0, 48u8).show(), "2")
    passed += eq(fmt.float(3.5, 0, 0, 48u8).show(), "4")
    passed += eq(fmt.float(0.5, 0, 0, 48u8).show(), "0")
    passed += eq(fmt.float(1.5, 0, 0, 48u8).show(), "2")
    passed += eq(fmt.float(-2.5, 0, 0, 48u8).show(), "-2")
    passed += eq(fmt.float(9.99, 1, 0, 48u8).show(), "10.0")
    passed += eq(fmt.float(0.005, 2, 0, 48u8).show(), "0.01")
    passed += eq(fmt.float(0.004, 2, 0, 48u8).show(), "0.00")
    passed += eq(fmt.float(1.0 / 3.0, 3, 0, 48u8).show(), "0.333")
    passed += eq(fmt.float(1e20, 0, 0, 48u8).show(), "100000000000000000000")
    passed += eq(fmt.float(1e-7, 9, 0, 48u8).show(), "0.000000100")
    passed += eq(fmt.float(1152921504606846976.0, 0, 0, 48u8).show(), "1152921504606846976")
    passed += eq(fmt.float(42.0, 0, 0, 48u8).show(), "42")
    passed += eq(fmt.float(-3.5, 1, 7, 48u8).show(), "-0003.5")
    passed += eq(fmt.float(3.5, 1, 6, 32u8).show(), "   3.5")
    passed += eq(fmt.float(math.f64_from_bits(0x7ff0000000000000u64), 2, 0, 48u8).show(), "inf")
    passed += eq(fmt.float(math.f64_from_bits(0xfff0000000000000u64), 2, 0, 48u8).show(), "-inf")
    passed += eq(fmt.float(math.f64_from_bits(0x7ff8000000000000u64), 2, 0, 48u8).show(), "nan")
    passed += eq(fmt.float(math.f64_from_bits(0xfff8000000000000u64), 2, 0, 48u8).show(), "nan")
    passed += eq(fmt.float(0.125, 2, 0, 48u8).show(), "0.12")
    passed += eq(fmt.float(-0.5, 0, 0, 48u8).show(), "-0")
    passed += eq(fmt.float(1.25, 5, 0, 48u8).show(), "1.25000")
    passed += eq(fmt.float(1.0, 3, 2, 48u8).show(), "1.000")
    if passed != 53 {
        print("passed=", passed, "\n")
        return 1
    }
    return 0
}
