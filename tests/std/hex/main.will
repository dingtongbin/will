import "std/encoding/hex"

def sum(b: Array<u8>) -> i32 {
    var total: i32 = 0
    for v in b {
        total += i32(v)
    }
    return total
}

def main() -> i32 {
    var total: i32 = 0
    var plain: Result<Array<u8>, Error> = hex.decode("48656c6C6f")
    match plain {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    var odd: Result<Array<u8>, Error> = hex.decode("abc")
    match odd {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    var bad: Result<Array<u8>, Error> = hex.decode("zz")
    match bad {
        Ok(v) => {
            total += sum(v)
        }
        Err(e) => {
            total += e.status()
        }
    }
    return total
}
