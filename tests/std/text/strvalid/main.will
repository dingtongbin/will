import "std/str"

// Valid builds one byte sequence and asks IsValid about it. The cases cover
// the boundary scalars and every rejected shape: stray continuation, overlong
// form, surrogate, truncated sequence, and a value past U+10FFFF.
def Valid(values: ...u8) -> bool {
    var data: Array<u8> = new Array<u8>(0)
    for v in values {
        data.Push(v)
    }
    return str.IsValid(data[Range(0, data.Len())])
}

def main() -> i32 {
    if !Valid() {
        return 1
    }
    if !Valid(0u8) || !Valid(127u8) {
        return 2
    }
    if !Valid(0xc3u8, 0xa9u8) {
        return 3
    }
    if !Valid(0xe2u8, 0x82u8, 0xacu8) {
        return 4
    }
    if !Valid(0xf0u8, 0x9fu8, 0x98u8, 0x80u8) {
        return 5
    }
    if !Valid(0xe0u8, 0xa0u8, 0x80u8) {
        return 6
    }
    if !Valid(0xedu8, 0x9fu8, 0xbfu8) {
        return 7
    }
    if !Valid(0xeeu8, 0x80u8, 0x80u8) {
        return 8
    }
    if !Valid(0xf0u8, 0x90u8, 0x80u8, 0x80u8) {
        return 9
    }
    if !Valid(0xf4u8, 0x8fu8, 0xbfu8, 0xbfu8) {
        return 10
    }
    if Valid(0x80u8) {
        return 11
    }
    if Valid(0xc0u8, 0xafu8) {
        return 12
    }
    if Valid(0xc1u8, 0xbfu8) {
        return 13
    }
    if Valid(0xe0u8, 0x80u8, 0x80u8) {
        return 14
    }
    if Valid(0xedu8, 0xa0u8, 0x80u8) {
        return 15
    }
    if Valid(0xf4u8, 0x90u8, 0x80u8, 0x80u8) {
        return 16
    }
    if Valid(0xf5u8, 0x80u8, 0x80u8, 0x80u8) {
        return 17
    }
    if Valid(0xe2u8, 0x82u8) {
        return 18
    }
    if Valid(0xf0u8, 0x9fu8, 0x98u8) {
        return 19
    }
    if Valid(0xc3u8, 0x28u8) {
        return 20
    }
    if Valid(0xfeu8) {
        return 21
    }
    return 0
}
