import "std/encoding/base64"

# Encode must pad whole groups, read every byte value, and feed Decode back the
# same bytes. 251 and 255 are the two values whose URL characters differ.
def main() -> i32 {
    var hello: str = "Hello"
    if base64.encode(hello[Range(0, 5)]) != "SGVsbG8=" {
        return 1
    }
    var short: str = "hi"
    if base64.encode(short[Range(0, 2)]) != "aGk=" {
        return 2
    }
    var empty: str = ""
    if base64.encode(empty[Range(0, 0)]) != "" {
        return 3
    }
    var utf8: str = "\xe4\xbd\xa0\xe5\xa5\xbd"
    if base64.encode(utf8[Range(0, 6)]) != "5L2g5aW9" {
        return 4
    }
    var bytesIn: list[u8] = list[u8](2)
    bytesIn.push(u8(251))
    bytesIn.push(u8(255))
    if base64.encode(bytesIn[Range(0, 2)]) != "+/8=" {
        return 5
    }
    if base64.encode_url(bytesIn[Range(0, 2)]) != "-_8=" {
        return 6
    }
    var back: Result<list[u8], Error> = base64.decode(base64.encode(utf8[Range(0, 6)]))
    match back {
        Ok(v) => {
            if v.len() != usize(6) {
                return 7
            }
            if v.get(0) != u8(228) {
                return 8
            }
            if v.get(5) != u8(189) {
                return 9
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    return 0
}
