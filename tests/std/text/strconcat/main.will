import "std/str"

// Concat must join zero, one, or many parts in order and keep every byte,
// including a UTF-8 text whose bytes must survive the copy. The corpus uses
// literals because the import shadows the predeclared str type, so a str
// variable cannot be named here.
func main() -> i32 {
    if str.Concat() != "" {
        return 1
    }
    if str.Concat("abc") != "abc" {
        return 2
    }
    if str.Concat("a", "b", "c") != "abc" {
        return 3
    }
    if str.Concat("", "x", "") != "x" {
        return 4
    }
    if str.Concat("a", "b", "c", "d", "e", "f") != "abcdef" {
        return 5
    }
    if str.Concat("\xe4\xbd\xa0\xe5\xa5\xbd", "\xe4\xbd\xa0\xe5\xa5\xbd") != "\xe4\xbd\xa0\xe5\xa5\xbd\xe4\xbd\xa0\xe5\xa5\xbd" {
        return 6
    }
    if str.Concat("\xe4\xbd\xa0\xe5\xa5\xbd", "!") != "\xe4\xbd\xa0\xe5\xa5\xbd!" {
        return 7
    }
    if str.Concat("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef") != "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" {
        return 8
    }
    return 0
}
