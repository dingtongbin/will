import "std/encoding/hex"

# Encode must use two lowercase digits per byte, keep every byte value, and
# feed Decode back the same bytes. 251 and 255 are above the ASCII range.
def main() -> i32 {
    var short: str = "Hi"
    if hex.encode(short[Range(0, 2)]) != "4869" {
        return 1
    }
    var utf8: str = "\xe4\xbd\xa0\xe5\xa5\xbd"
    if hex.encode(utf8[Range(0, 6)]) != "e4bda0e5a5bd" {
        return 2
    }
    var empty: str = ""
    if hex.encode(empty[Range(0, 0)]) != "" {
        return 3
    }
    var bytesIn: Array<u8> = new Array<u8>(2)
    bytesIn.push(u8(251))
    bytesIn.push(u8(255))
    if hex.encode(bytesIn[Range(0, 2)]) != "fbff" {
        return 4
    }
    var back: Result<Array<u8>, Error> = hex.decode(hex.encode(utf8[Range(0, 6)]))
    match back {
        Ok(v) => {
            if v.len() != usize(6) {
                return 5
            }
            if v.get(0) != u8(228) {
                return 6
            }
            if v.get(5) != u8(189) {
                return 7
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    var none: Result<Array<u8>, Error> = hex.decode(hex.encode(empty[Range(0, 0)]))
    match none {
        Ok(v) => {
            if v.len() != usize(0) {
                return 8
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    return 0
}
