import "std/encoding/base64"

# Decode must give back the exact bytes of a UTF-8 text, treat empty text as an
# empty result, read the URL alphabet, and reject a group that is short.
def main() -> i32 {
    var plain: Result<Array<u8>, Error> = base64.decode("5L2g5aW9")
    match plain {
        Ok(v) => {
            if v.len() != usize(6) {
                return 1
            }
            if v.get(0) != u8(228) {
                return 2
            }
            if v.get(1) != u8(189) {
                return 3
            }
            if v.get(2) != u8(160) {
                return 4
            }
            if v.get(3) != u8(229) {
                return 5
            }
            if v.get(4) != u8(165) {
                return 6
            }
            if v.get(5) != u8(189) {
                return 7
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    var empty: Result<Array<u8>, Error> = base64.decode("")
    match empty {
        Ok(v) => {
            if v.len() != usize(0) {
                return 8
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    var url: Result<Array<u8>, Error> = base64.decode_url("-_8=")
    match url {
        Ok(v) => {
            if v.len() != usize(2) {
                return 9
            }
            if v.get(0) != u8(251) {
                return 10
            }
            if v.get(1) != u8(255) {
                return 11
            }
        }
        Err(e) => {
            return e.status()
        }
    }
    var bad: Result<Array<u8>, Error> = base64.decode("SGVsbG8")
    match bad {
        Ok(v) => {
            return 12 + i32(v.len())
        }
        Err(e) => {
            if e.status() != 2 {
                return 13
            }
        }
    }
    return 0
}
