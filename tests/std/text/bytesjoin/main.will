import "std/bytes"

// one returns a byte array holding a single byte.
def one(value: u8) -> Array<u8> {
    var p: Array<u8> = new Array<u8>(1)
    p.Push(value)
    return p
}

// empty returns a byte array with no bytes.
def empty() -> Array<u8> {
    var p: Array<u8> = new Array<u8>(0)
    return p
}

// Join must place the separator only between parts, keep an empty part in
// place, accept an empty separator, and copy every byte value unchanged.
def main() -> i32 {
    var comma: Array<u8> = new Array<u8>(1)
    comma.Push(u8(44))
    var two: Array<Array<u8>> = new Array<Array<u8>>(2)
    two.Push(one(u8(65)))
    two.Push(one(u8(66)))
    var joined: Array<u8> = bytes.Join(two[Range(0, 2)], comma[Range(0, 1)])
    if joined.Len() != usize(3) {
        return 1
    }
    if joined.Get(0) != u8(65) {
        return 2
    }
    if joined.Get(1) != u8(44) {
        return 3
    }
    if joined.Get(2) != u8(66) {
        return 4
    }
    var three: Array<Array<u8>> = new Array<Array<u8>>(3)
    three.Push(one(u8(65)))
    three.Push(empty())
    three.Push(one(u8(66)))
    var gap: Array<u8> = bytes.Join(three[Range(0, 3)], comma[Range(0, 1)])
    if gap.Len() != usize(4) {
        return 5
    }
    if gap.Get(2) != u8(44) {
        return 6
    }
    var none: Array<u8> = bytes.Join(three[Range(0, 0)], comma[Range(0, 1)])
    if none.Len() != usize(0) {
        return 7
    }
    var single: Array<u8> = bytes.Join(two[Range(0, 1)], comma[Range(0, 1)])
    if single.Len() != usize(1) {
        return 8
    }
    if single.Get(0) != u8(65) {
        return 9
    }
    var bare: Array<u8> = bytes.Join(two[Range(0, 2)], comma[Range(0, 0)])
    if bare.Len() != usize(2) {
        return 10
    }
    if bare.Get(1) != u8(66) {
        return 11
    }
    var dashes: Array<u8> = new Array<u8>(2)
    dashes.Push(u8(45))
    dashes.Push(u8(45))
    var wide: Array<u8> = bytes.Join(two[Range(0, 2)], dashes[Range(0, 2)])
    if wide.Len() != usize(4) {
        return 12
    }
    if wide.Get(1) != u8(45) {
        return 13
    }
    if wide.Get(2) != u8(45) {
        return 14
    }
    var high: Array<Array<u8>> = new Array<Array<u8>>(2)
    high.Push(one(u8(251)))
    high.Push(one(u8(255)))
    var binary: Array<u8> = bytes.Join(high[Range(0, 2)], comma[Range(0, 1)])
    if binary.Len() != usize(3) {
        return 15
    }
    if binary.Get(0) != u8(251) {
        return 16
    }
    if binary.Get(2) != u8(255) {
        return 17
    }
    return 0
}
