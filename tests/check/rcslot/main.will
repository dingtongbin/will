struct C {
    n: i32
}

struct Box {
    f: rc<C>
}

func Use(b: rc<Box>) -> i32 {
    return 0
}

func Main() -> i32 {
    var box: rc<Box> = new rc<Box>(Box { f: new rc<C>(C { n: 1 }) })
    var c: rc<C> = new rc<C>(C { n: 2 })
    region {
        var task: Task<i32> = spawn Use(box)
        box.f = c
        _ = task
    }
    return 0
}
