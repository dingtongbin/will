struct C {
    n: i32
}

struct Box {
    f: rc<C>
}

def (mut b: Box) set(c: rc<C>) {
    b.f = c
}

def use(b: rc<Box>) -> i32 {
    return 0
}

def main() -> i32 {
    var box: rc<Box> = new rc<Box>(Box { f: new rc<C>(C { n: 1 }) })
    var c: rc<C> = new rc<C>(C { n: 2 })
    region {
        var task: Task<i32> = spawn use(box)
        box.set(c)
        _ = task
    }
    return 0
}
