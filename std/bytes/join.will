// Join returns the parts separated by sep. Every byte is copied once, so the
// total work is linear in the sum of the part lengths plus the separators; an
// empty part still takes its place between two separators.
def join(parts: []Array<u8>, sep: []u8) -> Array<u8> {
    var out: Array<u8> = new Array<u8>(0)
    var first: bool = true
    for p in parts {
        if !first {
            for b in sep {
                out.push(b)
            }
        }
        for b in p[Range(0, p.len())] {
            out.push(b)
        }
        first = false
    }
    return out
}
