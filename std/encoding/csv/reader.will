# Reader decodes CSV records from a byte stream. The separator is one byte the
# caller supplies, so a tab-separated file needs no second type. Fields are
# copied into str values, which lets a row outlive the read buffer.
import "std/errors"

struct Reader {
    src: byteReader
    sep: u8
    buf: Array<u8>
    pos: usize
    eof: bool
}

# init stores the source and separator. The first decode call performs the
# first read, so construction itself does not touch the stream.
def (r: mut Reader) init(src: byteReader, sep: u8) {
    r.src = src.clone()
    r.sep = sep
    r.buf = new Array<u8>(0)
    r.pos = 0usize
    r.eof = False
}

# Decode appends the records that are available and returns how many it
# appended. It parses every complete record the last read filled, and 0 means
# the stream has no more records.
async def (r: mut Reader) decode(rows: mut Array<Row>) -> Result<usize, Error> {
    var added: usize = 0usize
    while True {
        var record: Option<Array<str>> = r.read_record()?
        match record {
            Some(fields) => {
                rows.push(Row { fields: fields.clone() })
                added += 1usize
                if r.pos >= r.buf.len() {
                    break
                }
            }
            None => {
                break
            }
        }
    }
    return Ok(added)
}

# readRecord decodes one record. None means the stream ended before a field
# started; a record with one empty field is Some, not None.
def (r: mut Reader) read_record() -> Result<Option<Array<str>>, Error> {
    var first: i32 = r.peek_byte()?
    if first < 0 {
        return Ok(None)
    }
    var fields: Array<str> = new Array<str>(0)
    while True {
        var data: Array<u8> = new Array<u8>(0)
        var end: i32 = 0
        if first == i32(quoteByte) {
            end = r.read_quoted(data)?
        } else {
            end = r.read_unquoted(data)?
        }
        if not valid_utf8(data[Range(0, data.len())]) {
            return Err(errors.Invalid)
        }
        fields.push(str(data))
        if end == 0 {
            first = r.peek_byte()?
            continue
        }
        return Ok(Some(fields))
    }
}

# readUnquoted copies one field up to a separator, a line ending, or the end
# of the stream. A quote inside an unquoted field is rejected because RFC 4180
# requires such a field to be quoted.
def (r: mut Reader) read_unquoted(f: mut Array<u8>) -> Result<i32, Error> {
    while True {
        var c: i32 = r.peek_byte()?
        if c < 0 {
            return Ok(2)
        }
        var b: u8 = u8(c)
        if b == r.sep {
            r.pos += 1usize
            return Ok(0)
        }
        if b == lineFeed {
            r.pos += 1usize
            return Ok(1)
        }
        if b == carriageReturn {
            r.pos += 1usize
            if r.peek_byte()? == i32(lineFeed) {
                r.pos += 1usize
                return Ok(1)
            }
            return Err(errors.Invalid)
        }
        if b == quoteByte {
            return Err(errors.Invalid)
        }
        f.push(b)
        r.pos += 1usize
    }
}

# readQuoted copies one quoted field. A doubled quote is one quote byte; the
# closing quote must be followed by a separator, a line ending, or the end of
# the stream.
def (r: mut Reader) read_quoted(f: mut Array<u8>) -> Result<i32, Error> {
    r.pos += 1usize
    while True {
        var c: i32 = r.take_byte()?
        if c < 0 {
            return Err(errors.Invalid)
        }
        var b: u8 = u8(c)
        if b != quoteByte {
            f.push(b)
            continue
        }
        var next: i32 = r.peek_byte()?
        if next == i32(quoteByte) {
            f.push(quoteByte)
            r.pos += 1usize
            continue
        }
        return r.end_field(next)
    }
}

# endField consumes the byte after a closing quote and reports how the field
# ended: 0 for a separator, 1 for a line ending, 2 for the end of the stream.
def (r: mut Reader) end_field(next: i32) -> Result<i32, Error> {
    if next < 0 {
        return Ok(2)
    }
    var b: u8 = u8(next)
    if b == r.sep {
        r.pos += 1usize
        return Ok(0)
    }
    if b == lineFeed {
        r.pos += 1usize
        return Ok(1)
    }
    if b == carriageReturn {
        r.pos += 1usize
        if r.peek_byte()? == i32(lineFeed) {
            r.pos += 1usize
            return Ok(1)
        }
    }
    return Err(errors.Invalid)
}

# peekByte returns the next byte without consuming it, or -1 at the end of the
# stream. A consumed buffer is dropped before the next read so the pending
# bytes never grow across calls.
def (r: mut Reader) peek_byte() -> Result<i32, Error> {
    if r.pos >= r.buf.len() {
        r.buf.clear()
        r.pos = 0usize
        var more: bool = r.fill()?
        if not more {
            return Ok(-1)
        }
    }
    return Ok(i32(r.buf.get(r.pos)))
}

# takeByte consumes and returns the next byte, or -1 at the end of the stream.
def (r: mut Reader) take_byte() -> Result<i32, Error> {
    var c: i32 = r.peek_byte()?
    if c >= 0 {
        r.pos += 1usize
    }
    return Ok(c)
}

# fill reads one chunk and appends it to the pending bytes. False means the
# stream ended; the flag keeps later calls from reading it again.
def (r: mut Reader) fill() -> Result<bool, Error> {
    if r.eof {
        return Ok(False)
    }
    var chunk: Array<u8> = new Array<u8>(8192)
    var n: usize = r.src.read(chunk)?
    if n == 0usize {
        r.eof = True
        return Ok(False)
    }
    var i: usize = 0usize
    while True {
        if i >= n {
            break
        }
        r.buf.push(chunk.get(i))
        i += 1usize
    }
    return Ok(True)
}
