# Reader decodes CSV records from a byte stream. The separator is one byte the
# caller supplies, so a tab-separated file needs no second type. Fields are
# copied into str values, which lets a row outlive the read buffer.
import "std/errors"

struct Reader {
    src: byteReader
    sep: u8
    buf: list[u8]
    pos: usize
    eof: bool

    def init(self, src: byteReader, sep: u8) {
        self.src = src.clone()
        self.sep = sep
        self.buf = list[u8](0)
        self.pos = 0usize
        self.eof = False
    }

    async def decode(self, rows: list[Row]) -> Result<usize, Error> {
        var added: usize = 0usize
        while True {
            var record: Option<list[str]> = self.read_record()?
            match record {
                Some(fields) => {
                    rows.push(Row { fields: fields.clone() })
                    added += 1usize
                    if self.pos >= self.buf.len() {
                        break
                    }
                }
                None => {
                    break
                }
            }
        }
        return Ok(added)
    }

    def read_record(self) -> Result<Option<list[str]>, Error> {
        var first: i32 = self.peek_byte()?
        if first < 0 {
            return Ok(None)
        }
        var fields: list[str] = list[str](0)
        while True {
            var data: list[u8] = list[u8](0)
            var end: i32 = 0
            if first == i32(quoteByte) {
                end = self.read_quoted(data)?
            } else {
                end = self.read_unquoted(data)?
            }
            if not valid_utf8(data[Range(0, data.len())]) {
                return Err(errors.Invalid)
            }
            fields.push(str(data))
            if end == 0 {
                first = self.peek_byte()?
                continue
            }
            return Ok(Some(fields))
        }
    }

    def read_unquoted(self, f: list[u8]) -> Result<i32, Error> {
        while True {
            var c: i32 = self.peek_byte()?
            if c < 0 {
                return Ok(2)
            }
            var b: u8 = u8(c)
            if b == self.sep {
                self.pos += 1usize
                return Ok(0)
            }
            if b == lineFeed {
                self.pos += 1usize
                return Ok(1)
            }
            if b == carriageReturn {
                self.pos += 1usize
                if self.peek_byte()? == i32(lineFeed) {
                    self.pos += 1usize
                    return Ok(1)
                }
                return Err(errors.Invalid)
            }
            if b == quoteByte {
                return Err(errors.Invalid)
            }
            f.push(b)
            self.pos += 1usize
        }
    }

    def read_quoted(self, f: list[u8]) -> Result<i32, Error> {
        self.pos += 1usize
        while True {
            var c: i32 = self.take_byte()?
            if c < 0 {
                return Err(errors.Invalid)
            }
            var b: u8 = u8(c)
            if b != quoteByte {
                f.push(b)
                continue
            }
            var next: i32 = self.peek_byte()?
            if next == i32(quoteByte) {
                f.push(quoteByte)
                self.pos += 1usize
                continue
            }
            return self.end_field(next)
        }
    }

    def end_field(self, next: i32) -> Result<i32, Error> {
        if next < 0 {
            return Ok(2)
        }
        var b: u8 = u8(next)
        if b == self.sep {
            self.pos += 1usize
            return Ok(0)
        }
        if b == lineFeed {
            self.pos += 1usize
            return Ok(1)
        }
        if b == carriageReturn {
            self.pos += 1usize
            if self.peek_byte()? == i32(lineFeed) {
                self.pos += 1usize
                return Ok(1)
            }
        }
        return Err(errors.Invalid)
    }

    def peek_byte(self) -> Result<i32, Error> {
        if self.pos >= self.buf.len() {
            self.buf.clear()
            self.pos = 0usize
            var more: bool = self.fill()?
            if not more {
                return Ok(-1)
            }
        }
        return Ok(i32(self.buf.get(self.pos)))
    }

    def take_byte(self) -> Result<i32, Error> {
        var c: i32 = self.peek_byte()?
        if c >= 0 {
            self.pos += 1usize
        }
        return Ok(c)
    }

    def fill(self) -> Result<bool, Error> {
        if self.eof {
            return Ok(False)
        }
        var chunk: list[u8] = list[u8](8192)
        var n: usize = self.src.read(chunk)?
        if n == 0usize {
            self.eof = True
            return Ok(False)
        }
        var i: usize = 0usize
        while True {
            if i >= n {
                break
            }
            self.buf.push(chunk.get(i))
            i += 1usize
        }
        return Ok(True)
    }
}


















