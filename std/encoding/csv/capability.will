# The byte-stream capabilities the decoder and encoder accept. They mirror
# std/io.Reader and std/io.Writer structurally, so a concrete file, buffer, or
# test source satisfies them without an adapter. They are declared here
# instead of importing std/io because a struct named Reader or Writer in a
# package that imports io makes the current method lookup resolve to the io
# type.
interface byteReader {
    def read(buf: mut Array<u8>) -> Result<usize, Error>
}

interface byteWriter {
    def write(buf: []u8) -> Result<(), Error>
    def sync() -> Result<(), Error>
}
