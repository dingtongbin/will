# Writer encodes CSV records. It quotes a field only when the field contains a
# separator, a quote, or a line ending, and it always ends a record with LF so
# the same rows produce the same bytes on every platform.
struct Writer {
    dst: byteWriter
    sep: u8
}

# init stores the destination and separator. Construction itself writes
# nothing.
def (w: mut Writer) init(dst: byteWriter, sep: u8) {
    w.dst = dst.clone()
    w.sep = sep
}

# Encode writes every row to the destination. The write is one call so a
# Writer never sees a half-encoded record.
async def (w: mut Writer) encode(rows: []Row) -> Result<(), Error> {
    var out: Array<u8> = new Array<u8>(0)
    for row in rows {
        var first: bool = True
        for field in row.fields {
            if not first {
                out.push(w.sep)
            }
            append_field(out, field, w.sep)
            first = False
        }
        out.push(lineFeed)
    }
    if out.len() == 0usize {
        return Ok(())
    }
    return w.dst.write(out[Range(0, out.len())])
}

# Flush syncs the destination. Encode itself does not sync, so a caller
# that writes many batches pays for one flush.
async def (w: ref Writer) flush() -> Result<(), Error> {
    return w.dst.sync()
}

# appendField writes one field, quoting it when a syntax byte appears.
def append_field(out: mut Array<u8>, field: str, sep: u8) {
    var data: []u8 = field[Range(0, field.len())]
    if not needs_quote(data, sep) {
        for b in data {
            out.push(b)
        }
        return
    }
    out.push(quoteByte)
    for b in data {
        if b == quoteByte {
            out.push(quoteByte)
        }
        out.push(b)
    }
    out.push(quoteByte)
}

# needsQuote reports whether a field holds a separator, a quote, or a line
# ending. An empty field needs no quotes and stays an empty field.
def needs_quote(data: []u8, sep: u8) -> bool {
    for b in data {
        if b == sep or b == quoteByte or b == lineFeed or b == carriageReturn {
            return True
        }
    }
    return False
}
