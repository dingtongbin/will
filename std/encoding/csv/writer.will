// Writer encodes CSV records. It quotes a field only when the field contains a
// separator, a quote, or a line ending, and it always ends a record with LF so
// the same rows produce the same bytes on every platform.
struct Writer {
    dst: byteWriter
    sep: u8
}

// init stores the destination and separator. Construction itself writes
// nothing.
func (mut w: Writer) init(dst: byteWriter, sep: u8) {
    w.dst = dst.Clone()
    w.sep = sep
}

// AsyncEncode writes every row to the destination. The write is one call so a
// Writer never sees a half-encoded record.
async func (mut w: Writer) AsyncEncode(rows: []Row) -> Result<(), Error> {
    var out: Array<u8> = new Array<u8>(0)
    for row in rows {
        var first: bool = true
        for field in row.fields {
            if !first {
                out.Push(w.sep)
            }
            appendField(out, field, w.sep)
            first = false
        }
        out.Push(lineFeed)
    }
    if out.Len() == 0usize {
        return Ok(())
    }
    return w.dst.Write(out[Range(0, out.Len())])
}

// AsyncFlush syncs the destination. Encode itself does not sync, so a caller
// that writes many batches pays for one flush.
async func (w: Writer) AsyncFlush() -> Result<(), Error> {
    return w.dst.Sync()
}

// appendField writes one field, quoting it when a syntax byte appears.
func appendField(mut out: Array<u8>, field: str, sep: u8) {
    var data: []u8 = field[Range(0, field.Len())]
    if !needsQuote(data, sep) {
        for b in data {
            out.Push(b)
        }
        return
    }
    out.Push(quoteByte)
    for b in data {
        if b == quoteByte {
            out.Push(quoteByte)
        }
        out.Push(b)
    }
    out.Push(quoteByte)
}

// needsQuote reports whether a field holds a separator, a quote, or a line
// ending. An empty field needs no quotes and stays an empty field.
func needsQuote(data: []u8, sep: u8) -> bool {
    for b in data {
        if b == sep || b == quoteByte || b == lineFeed || b == carriageReturn {
            return true
        }
    }
    return false
}
