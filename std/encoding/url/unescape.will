// Unescape decodes percent-encoded text. Both hexadecimal cases are accepted;
// a percent sign that does not start a two-digit escape, or decoded bytes that
// are not valid UTF-8, are Invalid. A plus sign stays a plus: form encoding is
// not part of this package.
import "std/errors"

func Unescape(s: str) -> Result<str, Error> {
    var out: Array<u8> = new Array<u8>(0)
    var data: []u8 = s[Range(0, s.Len())]
    var i: usize = 0usize
    for {
        if i >= data.Len() {
            break
        }
        var b: u8 = data.Get(i)
        if b != 37u8 {
            out.Push(b)
            i += 1usize
            continue
        }
        if data.Len() - i < 3usize {
            return Err(errors.Invalid)
        }
        var high: i32 = hexValue(data.Get(i + 1usize))
        var low: i32 = hexValue(data.Get(i + 2usize))
        if high < 0 || low < 0 {
            return Err(errors.Invalid)
        }
        out.Push(u8(high * 16 + low))
        i += 3usize
    }
    if !validUtf8(out[Range(0, out.Len())]) {
        return Err(errors.Invalid)
    }
    return Ok(str(out))
}

// hexValue returns the value of one hexadecimal digit, or -1 when c is not a
// digit.
func hexValue(c: u8) -> i32 {
    if c >= 48u8 && c <= 57u8 {
        return i32(c - 48u8)
    }
    if c >= 65u8 && c <= 70u8 {
        return i32(c - 65u8) + 10
    }
    if c >= 97u8 && c <= 102u8 {
        return i32(c - 97u8) + 10
    }
    return -1
}
