// decodeError is the error value of rejected hexadecimal text. 2 is the stable
// status of Invalid, so a caller classifies it without knowing this type.
struct decodeError {
    message: str
}

def (e: decodeError) message() -> str {
    return e.message
}

def (e: decodeError) status() -> i32 {
    return 2
}

def fail(message: str) -> decodeError {
    return decodeError { message: message }
}

// Decode reads pairs of hexadecimal digits, upper or lower case. An odd number
// of digits is a rejected text, not a partial byte.
def decode(s: str) -> Result<Array<u8>, Error> {
    var out: Array<u8> = new Array<u8>(0)
    var high: i32 = -1
    for c in s {
        var v: i32 = digit_value(c)
        if v < 0 {
            return Err(fail("invalid character"))
        }
        if high < 0 {
            high = v
            continue
        }
        out.push(u8(high * 16 + v))
        high = -1
    }
    if high >= 0 {
        return Err(fail("odd length"))
    }
    return Ok(out)
}

// digitValue returns the value of one hexadecimal digit, or -1 when the
// character is not a digit.
def digit_value(c: u32) -> i32 {
    if c >= 48u32 && c <= 57u32 {   // '0' to '9'
        return i32(c - 48u32)
    }
    if c >= 97u32 && c <= 102u32 {  // 'a' to 'f'
        return i32(c - 97u32) + 10
    }
    if c >= 65u32 && c <= 70u32 {   // 'A' to 'F'
        return i32(c - 65u32) + 10
    }
    return -1
}
