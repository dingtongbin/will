// decodeError is the error value of rejected base64 text. 2 is the stable
// status of Invalid, so a caller classifies it without knowing this type.
struct decodeError {
    message: str
}

func (e: decodeError) Message() -> str {
    return e.message
}

func (e: decodeError) Status() -> i32 {
    return 2
}

func fail(message: str) -> decodeError {
    return decodeError { message: message }
}

// 61 is the ASCII code of the padding character '='.
const padScalar: u32 = 61

func Decode(s: str) -> Result<Array<u8>, Error> {
    return decode(s, false)
}

func DecodeUrl(s: str) -> Result<Array<u8>, Error> {
    return decode(s, true)
}

// decode reads one padded base64 text. Every group is four characters, the
// last two of which may be padding; text that is not a whole number of groups,
// has data after padding, or uses a character outside the alphabet is rejected.
// A padded group is emitted when the padding completes it, so the pad count
// decides how many bytes of that group are real.
func decode(s: str, url: bool) -> Result<Array<u8>, Error> {
    var out: Array<u8> = new Array<u8>(0)
    var q0: u32 = 0
    var q1: u32 = 0
    var q2: u32 = 0
    var q3: u32 = 0
    var inGroup: i32 = 0
    var pad: i32 = 0
    var ended: bool = false
    for c in s {
        if ended {
            return Err(fail("invalid padding"))
        }
        if c == padScalar {
            // Padding needs two data characters before it; three would be
            // more than one group can carry.
            if inGroup < 2 {
                return Err(fail("invalid padding"))
            }
            pad += 1
            if pad > 2 {
                return Err(fail("invalid padding"))
            }
        } else {
            if pad > 0 {
                return Err(fail("invalid padding"))
            }
            var v: u32 = alphabetValue(c, url)
            if v >= 64u32 {
                return Err(fail("invalid character"))
            }
            if inGroup == 0 {
                q0 = v
            } else if inGroup == 1 {
                q1 = v
            } else if inGroup == 2 {
                q2 = v
            } else {
                q3 = v
            }
        }
        inGroup += 1
        if inGroup == 4 {
            out.Push(u8((q0 << 2) | (q1 >> 4)))
            if pad < 2 {
                out.Push(u8(((q1 & 15u32) << 4) | (q2 >> 2)))
            }
            if pad < 1 {
                out.Push(u8(((q2 & 3u32) << 6) | q3))
            }
            inGroup = 0
            if pad > 0 {
                ended = true
            }
            pad = 0
        }
    }
    if inGroup != 0 {
        return Err(fail("invalid length"))
    }
    return Ok(out)
}

// alphabetValue maps one character to its six-bit value. 64 marks a character
// outside the selected alphabet, so it is above every value a group accepts.
func alphabetValue(c: u32, url: bool) -> u32 {
    if c >= 65u32 && c <= 90u32 {   // 'A' to 'Z'
        return c - 65u32
    }
    if c >= 97u32 && c <= 122u32 {  // 'a' to 'z'
        return c - 97u32 + 26u32
    }
    if c >= 48u32 && c <= 57u32 {   // '0' to '9'
        return c - 48u32 + 52u32
    }
    if url {
        if c == 45u32 {             // '-'
            return 62u32
        }
        if c == 95u32 {             // '_'
            return 63u32
        }
        return 64u32
    }
    if c == 43u32 {                 // '+'
        return 62u32
    }
    if c == 47u32 {                 // '/'
        return 63u32
    }
    return 64u32
}
