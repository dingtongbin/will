// Time zones and the host clock. A Timezone is either a fixed offset, a row of
// the compiled IANA table, or the host's own rules. The table is generated by
// std/time/tzgen and linked in as data, so Load never reads a tzfile.
import "std/errors"

import c "zone.h" {
    fast willtime_zone_find
    fast willtime_zone_offset
    fast willtime_local_zone
    fast willtime_local_offset
    fast willtime_wall_ns
}

// The three kinds of zone a Timezone can name. Fixed zones carry their offset;
// named and host zones look the offset up for the instant being formatted.
const zoneFixed: i32 = 0
const zoneNamed: i32 = 1
const zoneHost: i32 = 2

// Timezone is an offset rule, not an instant. A fixed zone answers every
// instant with the same offset; a named zone follows the compiled transitions.
struct Timezone {
    kind: i32
    id: i32
    offsetSec: i32
}

// Utc returns the zero offset.
func Utc() -> Timezone {
    return Fixed(0)
}

// Fixed returns a zone with the given offset from UTC in seconds. It has no
// daylight saving rule, so the offset applies to every instant.
func Fixed(offsetSec: i32) -> Timezone {
    return Timezone { kind: zoneFixed, id: -1, offsetSec: offsetSec }
}

// Local returns the host's zone. When the host names an IANA zone the compiled
// table is used; otherwise the host's own rule answers each instant.
func Local() -> Timezone {
    var id: i32 = c.willtime_local_zone()
    if id >= 0 {
        return Timezone { kind: zoneNamed, id: id, offsetSec: 0 }
    }
    if id == -2 {
        return Timezone { kind: zoneHost, id: -1, offsetSec: 0 }
    }
    return Utc()
}

// Load returns the IANA zone with this name. A name that is not in the
// compiled table is NotFound; the name is never resolved through the host.
func Load(name: str) -> Result<Timezone, Error> {
    var id: i32 = c.willtime_zone_find(raw(name), i64(name.Len()))
    if id < 0 {
        return Err(errors.NotFound)
    }
    return Ok(Timezone { kind: zoneNamed, id: id, offsetSec: 0 })
}

// offsetAt returns the offset of tz at one Unix second. The integer result is
// the presentation offset; it never shifts the instant itself.
func offsetAt(tz: Timezone, atSec: i64) -> i32 {
    if tz.kind == zoneFixed {
        return tz.offsetSec
    }
    if tz.kind == zoneNamed {
        return c.willtime_zone_offset(tz.id, atSec)
    }
    if tz.kind == zoneHost {
        return c.willtime_local_offset(atSec)
    }
    return 0
}

// wallNanos returns the host wall clock as Unix nanoseconds. It is separate
// from Stopwatch, which reads the monotonic clock.
func wallNanos() -> i64 {
    return c.willtime_wall_ns()
}
