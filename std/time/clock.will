import c "clock.h" {
    fast willrt_now_ns
    fast willrt_os_sleep_ns
    fast willrt_task_sleep_ns
    fast willrt_task_sleep_async
}

# Stopwatch measures elapsed monotonic time, so a wall-clock adjustment does
# not change its result.
struct clockError {
    message: str
}

def (e: clockError) message() -> str {
    return e.message.clone()
}

def (e: clockError) status() -> i32 {
    return 2
}

struct Stopwatch {
    start: i64
}

# init records the monotonic clock at construction.
def (mut s: Stopwatch) init() {
    s.start = c.willrt_now_ns()
}

# Elapsed returns the time since construction.
def (s: Stopwatch) elapsed() -> Duration {
    return Duration(c.willrt_now_ns() - s.start)
}

# Sleep suspends the current task for d. A synchronous caller reaches it
# through wait(...); a spawned caller awaits it inside the task.
async def sleep(d: Duration) -> Result<(), Error> {
    var ns: i64 = i64(d)
    var status: i32 = await c.willrt_task_sleep_async(ns)
    if status != 0 {
        return Err(clockError { message: "time: negative sleep"})
    }
    return Ok(())
}
