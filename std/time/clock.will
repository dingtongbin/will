import c "clock.h" {
    fast willrt_now_ns
    fast willrt_os_sleep_ns
    fast willrt_task_sleep_ns
    fast willrt_task_sleep_async
}

# Stopwatch measures elapsed monotonic time, so a wall-clock adjustment does
# not change its result.
struct clockError {
    message: str

    def message(self) -> str {
        return self.message.clone()
    }

    def status(self) -> i32 {
        return 2
    }
}

struct Stopwatch {
    start: i64

    # init records the monotonic clock at construction.
    def init(self) {
        self.start = c.willrt_now_ns()
    }

    # elapsed returns the time since construction.
    def elapsed(self) -> Duration {
        return Duration(c.willrt_now_ns() - self.start)
    }
}

# Sleep suspends the current task for d. Callers await it inside an async
# function or spawn it as a task.
async def sleep(d: Duration) -> Result<(), Error> {
    var ns: i64 = i64(d)
    var status: i32 = await c.willrt_task_sleep_async(ns)
    if status != 0 {
        return Err(clockError { message: "time: negative sleep"})
    }
    return Ok(())
}
