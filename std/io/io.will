// The IO capability interfaces. They name synchronous methods only: an async
// function cannot be dispatched through an interface without a future type, so
// asynchronous IO lives on concrete types such as fs.File and fs.AsyncReadFile.

interface Reader {
    def Read(mut buf: Array<u8>) -> Result<usize, Error>
}

interface Writer {
    def Write(buf: []u8) -> Result<(), Error>
    def Sync() -> Result<(), Error>
}

interface Seeker {
    def Seek(offset: i64, whence: i32) -> Result<i64, Error>
}

// ReadAll appends every byte from r until end of stream. It returns the number
// of bytes appended.
def ReadAll(r: Reader, mut buf: Array<u8>) -> Result<usize, Error> {
    var before: usize = buf.Len()
    var chunk: Array<u8> = new Array<u8>(32768)
    for {
        chunk.Clear()
        var n: usize = r.Read(chunk)?
        if n == 0usize {
            break
        }
        var i: usize = 0
        for {
            if i >= n {
                break
            }
            buf.Push(chunk.Get(i))
            i += 1
        }
    }
    return Ok(buf.Len() - before)
}

// Copy copies r to dst until end of stream and syncs dst.
def Copy(dst: Writer, src: Reader) -> Result<u64, Error> {
    var total: u64 = 0
    var chunk: Array<u8> = new Array<u8>(32768)
    for {
        chunk.Clear()
        var n: usize = src.Read(chunk)?
        if n == 0usize {
            break
        }
        _ = dst.Write(chunk[Range(0, n)])?
        total += u64(n)
    }
    _ = dst.Sync()?
    return Ok(total)
}
