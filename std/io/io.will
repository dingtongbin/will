# The IO capability interfaces. Every operation is an async method; an
# implementation returns a task result that the caller consumes with await.

interface Reader {
    async def read(buf: list[u8]) -> Result<usize, Error>
}

interface Writer {
    async def write(buf: []u8) -> Result<(), Error>
    async def sync() -> Result<(), Error>
}

interface Seeker {
    async def seek(offset: i64, whence: i32) -> Result<i64, Error>
}

# ReadAll appends every byte from r until end of stream. It returns the number
# of bytes appended.
async def read_all(r: Reader, buf: list[u8]) -> Result<usize, Error> {
    var before: usize = buf.len()
    var chunk: list[u8] = list[u8](32768)
    while True {
        chunk.clear()
        var n: usize = (await r.read(chunk))?
        if n == 0usize {
            break
        }
        var i: usize = 0
        while True {
            if i >= n {
                break
            }
            buf.push(chunk.get(i))
            i += 1
        }
    }
    return Ok(buf.len() - before)
}

# Copy copies r to dst until end of stream and syncs dst.
async def copy(dst: Writer, src: Reader) -> Result<u64, Error> {
    var total: u64 = 0
    var chunk: list[u8] = list[u8](32768)
    while True {
        chunk.clear()
        var n: usize = (await src.read(chunk))?
        if n == 0usize {
            break
        }
        _ = (await dst.write(chunk[Range(0, n)]))?
        total += u64(n)
    }
    _ = (await dst.sync())?
    return Ok(total)
}
