# WriterBuf collects writes and hands them to the wrapped Writer when the
# buffer fills or the caller flushes. A write at least as large as the buffer
# bypasses it. The receiver is mutable because the buffered length changes.

import "std/io"

struct WriterBuf {
    dst: io.Writer
    data: list[u8]
    limit: usize

    def init(self, w: io.Writer, size: usize) {
        self.dst = w.clone()
        self.data = list[u8](size)
        self.limit = size
    }

    async def write(self, bytes: []u8) -> Result<(), Error> {
        if self.limit == 0usize {
            return await self.dst.write(bytes)
        }
        if self.data.len() == 0usize and bytes.len() >= self.limit {
            return await self.dst.write(bytes)
        }
        if self.data.len() + bytes.len() > self.limit {
            _ = (await self.flush())?
        }
        if bytes.len() >= self.limit {
            return await self.dst.write(bytes)
        }
        self.data.append(bytes)
        if self.data.len() >= self.limit {
            _ = (await self.flush())?
        }
        return Ok(())
    }

    async def flush(self) -> Result<(), Error> {
        if self.data.len() != 0usize {
            var out: list[u8] = self.data.clone()
            var n: usize = out.len()
            self.data.clear()
            _ = (await self.dst.write(out[Range(0, n)]))?
        }
        return Ok(())
    }

    async def sync(self) -> Result<(), Error> {
        _ = (await self.flush())?
        return await self.dst.sync()
    }
}








