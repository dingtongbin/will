// In-memory buffers. A Buffer owns one Array and exposes stable views. The
// pooled form has the same surface as the ordinary form, so a caller can move
// to a lane-local pool without changing call sites.

struct Buffer {
    data: Array<u8>
}

struct PooledBuffer {
    data: Array<u8>
}

// NewBuffer returns an empty in-memory buffer.
func NewBuffer() -> Buffer {
    return Buffer { data: new Array<u8>(0) }
}

// Bytes returns a read-only view of the buffer contents.
func (b: Buffer) Bytes() -> []u8 {
    return b.data[Range(0, b.data.Len())]
}

// Len returns the number of live bytes.
func (b: Buffer) Len() -> usize {
    return b.data.Len()
}

// Clear drops every live byte without releasing the backing storage.
func (mut b: Buffer) Clear() {
    b.data.Clear()
}

// Pooled returns a buffer with room for size bytes. Its live length starts at
// zero because the caller receives an empty view, not an initialized byte range.
func Pooled(size: usize) -> PooledBuffer {
    return PooledBuffer { data: new Array<u8>(size) }
}

// Bytes returns a read-only view of the pooled contents.
func (p: PooledBuffer) Bytes() -> []u8 {
    return p.data[Range(0, p.data.Len())]
}

// Array returns the mutable backing array.
func (p: PooledBuffer) Array() -> Array<u8> {
    return p.data
}

// Len returns the number of live bytes.
func (p: PooledBuffer) Len() -> usize {
    return p.data.Len()
}

// Clear drops every live byte.
func (mut p: PooledBuffer) Clear() {
    p.data.Clear()
}

// Release marks the buffer available for reuse. The current implementation
// keeps the storage owned by the value; the call is safe to repeat.
func (mut p: PooledBuffer) Release() {
}
