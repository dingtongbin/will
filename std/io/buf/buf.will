// In-memory buffers. A Buffer owns one Array and exposes stable views. The
// pooled form has the same surface as the ordinary form, so a caller can move
// to a lane-local pool without changing call sites.

import "std/io"

struct Buffer {
    data: Array<u8>
}

struct PooledBuffer {
    data: Array<u8>
}

// NewBuffer returns an empty in-memory buffer.
func NewBuffer() -> Buffer {
    return Buffer { data: new Array<u8>(0) }
}

// Bytes returns a read-only view of the buffer contents.
func (b: Buffer) Bytes() -> []u8 {
    return b.data[Range(0, b.data.Len())]
}

// Len returns the number of live bytes.
func (b: Buffer) Len() -> usize {
    return b.data.Len()
}

// Clear drops every live byte without releasing the backing storage.
func (mut b: Buffer) Clear() {
    b.data.Clear()
}

// Pooled returns a buffer with room for size bytes. Its live length starts at
// zero because the caller receives an empty view, not an initialized byte range.
func Pooled(size: usize) -> PooledBuffer {
    return PooledBuffer { data: new Array<u8>(size) }
}

// Bytes returns a read-only view of the pooled contents.
func (p: PooledBuffer) Bytes() -> []u8 {
    return p.data[Range(0, p.data.Len())]
}

// Array returns the mutable backing array.
func (p: PooledBuffer) Array() -> Array<u8> {
    return p.data
}

// Len returns the number of live bytes.
func (p: PooledBuffer) Len() -> usize {
    return p.data.Len()
}

// Clear drops every live byte.
func (mut p: PooledBuffer) Clear() {
    p.data.Clear()
}

// Release marks the buffer available for reuse. The current implementation
// keeps the storage owned by the value; the call is safe to repeat.
func (mut p: PooledBuffer) Release() {
}

// WriterBuf collects writes and hands them to the wrapped Writer when the
// buffer fills or the caller flushes. A write at least as large as the buffer
// bypasses it. The receiver is mutable because the buffered length changes.
struct WriterBuf {
    dst: io.Writer
    data: Array<u8>
    limit: usize
}

// NewWriter wraps w in a buffer of size bytes. A size of zero passes every
// write straight through.
func NewWriter(w: io.Writer, size: usize) -> WriterBuf {
    return WriterBuf {
        dst: w,
        data: new Array<u8>(size),
        limit: size
    }
}

// Write appends bytes, flushing first when they would not fit.
func (mut b: WriterBuf) Write(bytes: []u8) -> Result<(), Error> {
    if b.limit == 0usize {
        return b.dst.Write(bytes)
    }
    if b.data.Len() == 0usize && bytes.Len() >= b.limit {
        return b.dst.Write(bytes)
    }
    if b.data.Len() + bytes.Len() > b.limit {
        _ = b.Flush()?
    }
    var i: usize = 0
    for {
        if i >= bytes.Len() {
            break
        }
        b.data.Push(bytes[i])
        i += 1
    }
    if b.data.Len() >= b.limit {
        _ = b.Flush()?
    }
    return Ok(())
}

// Flush writes the buffered bytes and syncs the wrapped Writer. The buffer is
// copied first so the write does not alias the array it clears.
func (mut b: WriterBuf) Flush() -> Result<(), Error> {
    if b.data.Len() != 0usize {
        var out: Array<u8> = b.data.Clone()
        var n: usize = out.Len()
        b.data.Clear()
        _ = b.dst.Write(out[Range(0, n)])?
    }
    return b.dst.Sync()
}
