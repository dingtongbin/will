# ReaderBuf reads one chunk from a Reader at a time and hands it to callers in
# smaller pieces. It never reads ahead when the wrapped Reader is at EOF.

import "std/io"

struct ReaderBuf {
    src: io.Reader
    data: list[u8]
    pos: usize
    limit: usize

    def init(self, r: io.Reader, size: usize) {
        self.src = r.clone()
        self.data = list[u8](size)
        self.pos = 0usize
        self.limit = size
    }

    async def read(self, out: list[u8]) -> Result<usize, Error> {
        if self.limit == 0usize {
            return await self.src.read(out)
        }
        if self.pos >= self.data.len() {
            self.data.clear()
            self.pos = 0usize
            var n: usize = (await self.src.read(self.data))?
            if n == 0usize {
                return Ok(0usize)
            }
        }
        var start: usize = self.pos
        var end: usize = self.data.len()
        self.pos = end
        out.append(self.data[Range(start, end)])
        return Ok(end - start)
    }
}




