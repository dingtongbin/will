# Buffer is an in-memory byte buffer. It owns its Array and exposes a stable
# read-only view, so a caller can fill it and hand the view to a Writer.

struct Buffer {
    data: Array<u8>
}

# init starts an empty buffer.
def (b: mut Buffer) init() {
    b.data = new Array<u8>(0)
}

# Bytes returns a read-only view of the buffer contents.
def (b: ref Buffer) bytes() -> []u8 {
    return b.data[Range(0, b.data.len())]
}

# Len returns the number of live bytes.
def (b: ref Buffer) len() -> usize {
    return b.data.len()
}

# Clear drops every live byte without releasing the backing storage.
def (b: mut Buffer) clear() {
    b.data.clear()
}
