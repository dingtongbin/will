# Concat returns the bytes of every part in order. Each part is copied as
# bytes, so a valid text is not decoded and encoded again; Push doubles the
# buffer when it is full, so the whole concatenation is linear.
def concat(parts: ...str) -> str {
    var out: list[u8] = list[u8](0)
    for p in parts {
        for b in p[Range(0, p.len())] {
            out.push(b)
        }
    }
    return str(out)
}

# FromBytes converts a byte array into immutable text. The formatter lives in
# its own package because fmt exports a function also named str, which shadows
# the conversion inside that package.
def from_bytes(data: []u8) -> str {
    return str(data)
}
