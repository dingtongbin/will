# parseError is the error value of a rejected text. 2 is the stable status of
# Invalid, so a caller classifies a parse failure without knowing this type.
struct parseError {
    message: str
}

def (e: ref parseError) message() -> str {
    return e.message.clone()
}

def (e: ref parseError) status() -> i32 {
    return 2
}

def fail(message: str) -> parseError {
    return parseError { message: message.clone() }
}
