# Join returns the parts separated by sep. Each part and separator is copied as
# bytes, so a valid text is not decoded and encoded again, and Push doubles the
# buffer when it is full, so the whole join is linear in the total length. An
# empty part still takes its place between two separators.
def join(parts: []str, sep: str) -> str {
    var out: list[u8] = list[u8](0)
    var first: bool = True
    for p in parts {
        if not first {
            for b in sep[Range(0, sep.len())] {
                out.push(b)
            }
        }
        for b in p[Range(0, p.len())] {
            out.push(b)
        }
        first = False
    }
    return str(out)
}
