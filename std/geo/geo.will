import "std/math"

// Point is a location on the Earth's surface in degrees: latitude positive to
// the north, longitude positive to the east.
struct Point {
    lat: f64
    lon: f64
}

// earthRadiusMeters is the IUGG mean radius. A great-circle distance is
// proportional to it, so every result carries this one model.
const earthRadiusMeters: f64 = 6371008.8

// radians converts degrees to radians, the unit std/math works in.
func radians(degrees: f64) -> f64 {
    return degrees * math.Pi / 180.0
}

// Distance returns the great-circle distance from p to other in meters.
func (p: Point) Distance(other: Point) -> f64 {
    var lat1: f64 = radians(p.lat)
    var lat2: f64 = radians(other.lat)
    var dLat: f64 = lat2 - lat1
    var dLon: f64 = radians(other.lon - p.lon)
    var sinLat: f64 = math.Sin(dLat / 2.0)
    var sinLon: f64 = math.Sin(dLon / 2.0)
    var a: f64 = sinLat * sinLat + math.Cos(lat1) * math.Cos(lat2) * sinLon * sinLon
    // Rounding can push a a little outside [0, 1] on nearly opposite points,
    // and the two roots below need that interval.
    if a < 0.0 {
        a = 0.0
    }
    if a > 1.0 {
        a = 1.0
    }
    var central: f64 = 2.0 * math.Atan2(math.Sqrt(a), math.Sqrt(1.0 - a))
    return earthRadiusMeters * central
}

// Bearing returns the initial bearing from p to other in degrees clockwise
// from north, in [0, 360).
func (p: Point) Bearing(other: Point) -> f64 {
    var lat1: f64 = radians(p.lat)
    var lat2: f64 = radians(other.lat)
    var dLon: f64 = radians(other.lon - p.lon)
    var y: f64 = math.Sin(dLon) * math.Cos(lat2)
    var x: f64 = math.Cos(lat1) * math.Sin(lat2) - math.Sin(lat1) * math.Cos(lat2) * math.Cos(dLon)
    var degrees: f64 = math.Atan2(y, x) * 180.0 / math.Pi
    if degrees < 0.0 {
        degrees += 360.0
    }
    return degrees
}
