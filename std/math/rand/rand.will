// Rand is a SplitMix64 stream. Every value owns its state, so two streams with
// the same seed produce the same sequence and no global state is involved.
struct Rand {
    state: u64
}

// New returns a stream that starts from seed.
func New(seed: u64) -> Rand {
    return Rand { state: seed}
}

// NextU64 advances the stream and returns the next 64 bits.
func (mut r: Rand) NextU64() -> u64 {
    r.state = addU64(r.state, 11400714819323198485u64)
    var z: u64 = r.state
    z = mulU64(z ^ (z >> 30), 13787848793156543929u64)
    z = mulU64(z ^ (z >> 27), 10723151780598845931u64)
    return z ^ (z >> 31)
}

// NextF64 returns a value in [0, 1). The top 53 bits fill the mantissa exactly,
// so the division is a shift in the exponent and cannot round up to 1.
func (mut r: Rand) NextF64() -> f64 {
    return f64(r.NextU64() >> 11) / 9007199254740992.0
}
