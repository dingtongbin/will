# Rand is a SplitMix64 stream. Every value owns its state, so two streams with
# the same seed produce the same sequence and no global state is involved.
struct Rand {
    state: u64

    def init(self, seed: u64) {
        self.state = seed
    }

    def next_u64(self) -> u64 {
        self.state = add_u64(self.state, 11400714819323198485u64)
        var z: u64 = self.state
        z = mul_u64(z ^ (z >> 30), 13787848793156543929u64)
        z = mul_u64(z ^ (z >> 27), 10723151780598845931u64)
        return z ^ (z >> 31)
    }

    def next_f64(self) -> f64 {
        return f64(self.next_u64() >> 11) / 9007199254740992.0
    }
}






