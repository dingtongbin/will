# addU64 returns a + b modulo 2^64. The language add is checked, so the sum is
# computed from the distance to the maximum instead of letting it overflow.
def add_u64(a: u64, b: u64) -> u64 {
    var max: u64 = 18446744073709551615u64
    if a > max - b {
        return a - (max - b) - 1u64
    }
    return a + b
}

# mulU64 returns a * b modulo 2^64. Sixteen-bit limbs keep every intermediate
# product below 2^32, so the checked multiply never trips. The limbs past the
# fourth are dropped, which is what modulo 2^64 means.
def mul_u64(a: u64, b: u64) -> u64 {
    var a0: u64 = a & 65535u64
    var a1: u64 = (a >> 16) & 65535u64
    var a2: u64 = (a >> 32) & 65535u64
    var a3: u64 = a >> 48
    var b0: u64 = b & 65535u64
    var b1: u64 = (b >> 16) & 65535u64
    var b2: u64 = (b >> 32) & 65535u64
    var b3: u64 = b >> 48
    var t: u64 = a0 * b0
    var r0: u64 = t & 65535u64
    var carry: u64 = t >> 16
    t = a0 * b1 + a1 * b0 + carry
    var r1: u64 = t & 65535u64
    carry = t >> 16
    t = a0 * b2 + a1 * b1 + a2 * b0 + carry
    var r2: u64 = t & 65535u64
    carry = t >> 16
    t = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + carry
    var r3: u64 = t & 65535u64
    return r0 | (r1 << 16) | (r2 << 32) | (r3 << 48)
}
