// AbsI64 returns the absolute value of x. The smallest i64 has no positive
// counterpart, so the checked negation panics there.
def abs_i64(x: i64) -> i64 {
    if x < 0 {
        return -x
    }
    return x
}

// AbsI32 returns the absolute value of x. The smallest i32 has no positive
// counterpart, so the checked negation panics there.
def abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x
    }
    return x
}

// MinI64 returns the smaller of a and b.
def min_i64(a: i64, b: i64) -> i64 {
    if a < b {
        return a
    }
    return b
}

// MaxI64 returns the larger of a and b.
def max_i64(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    return b
}

// MinU64 returns the smaller of a and b.
def min_u64(a: u64, b: u64) -> u64 {
    if a < b {
        return a
    }
    return b
}

// MaxU64 returns the larger of a and b.
def max_u64(a: u64, b: u64) -> u64 {
    if a > b {
        return a
    }
    return b
}

// ClampI64 limits x to the closed range [lo, hi]. The caller must pass lo <= hi.
def clamp_i64(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// SignI64 returns -1, 0, or 1.
def sign_i64(x: i64) -> i64 {
    if x > 0 {
        return 1i64
    }
    if x < 0 {
        return -1i64
    }
    return 0i64
}
