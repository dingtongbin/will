// twoPi is one full turn. The trigonometric series reduce an argument to one
// turn before they run, so the constant is the unit of that reduction.
const twoPi: f64 = 6.28318530717958647692

// halfPi is a quarter turn, the point where the sine series switches from the
// sine branch to the cosine branch.
const halfPi: f64 = 1.57079632679489661923

// nan is the value Sqrt and the angle functions return outside their domain.
// The language has no nan literal, so they build one by dividing zero by zero.
def nan() -> f64 {
    var zero: f64 = 0.0
    return zero / zero
}

// Sqrt returns the non-negative square root of x. A negative input gives nan,
// and an infinite input is returned unchanged.
def sqrt(x: f64) -> f64 {
    if x != x {
        return x
    }
    if x < 0.0 {
        return nan()
    }
    if x > F64Max {
        return x
    }
    if x == 0.0 {
        return 0.0
    }
    // Scaling by four keeps the Newton iteration on a value in [1, 4), where a
    // fixed number of steps converges; a tiny or huge input would otherwise
    // stall for hundreds of halvings.
    var scale: f64 = 1.0
    var y: f64 = x
    for {
        if y >= 1.0 {
            break
        }
        y *= 4.0
        scale *= 0.5
    }
    for {
        if y < 4.0 {
            break
        }
        y *= 0.25
        scale *= 2.0
    }
    var guess: f64 = y
    var step: i32 = 0
    for {
        if step >= 60 {
            break
        }
        var next: f64 = 0.5 * (guess + y / guess)
        var delta: f64 = next - guess
        if delta < 0.0 {
            delta = -delta
        }
        guess = next
        if delta <= 1.0e-16 * guess {
            break
        }
        step += 1
    }
    return guess * scale
}

// reduce brings x into [-Pi, Pi]. A turn count that does not fit an i64 also
// has no representable fraction in an f64, so such an argument gets nan.
def reduce(x: f64) -> f64 {
    var turns: f64 = x / twoPi
    if turns > 9.0e18 || turns < -9.0e18 {
        return nan()
    }
    var whole: i64 = i64(turns)
    var r: f64 = x - f64(whole) * twoPi
    if r > Pi {
        r -= twoPi
    }
    if r < -Pi {
        r += twoPi
    }
    return r
}

// Sin returns the sine of x, where x is in radians.
def sin(x: f64) -> f64 {
    if x != x {
        return x
    }
    var r: f64 = reduce(x)
    if r != r {
        return r
    }
    if r > halfPi {
        r = Pi - r
    } else if r < -halfPi {
        r = -Pi - r
    }
    var square: f64 = r * r
    var term: f64 = r
    var sum: f64 = r
    var k: i32 = 1
    for {
        if k > 12 {
            break
        }
        var denominator: f64 = f64((2 * k) * (2 * k + 1))
        term = -term * square / denominator
        sum += term
        var magnitude: f64 = term
        if magnitude < 0.0 {
            magnitude = -magnitude
        }
        if magnitude < 1.0e-18 {
            break
        }
        k += 1
    }
    return sum
}

// Cos returns the cosine of x, where x is in radians. A quarter turn turns the
// sine of the shifted angle into the cosine, so both share one series.
def cos(x: f64) -> f64 {
    if x != x {
        return x
    }
    var r: f64 = reduce(x)
    if r != r {
        return r
    }
    return sin(r + halfPi)
}

// atanSeries sums the Taylor series of atan for a small non-negative t. The
// caller has already reduced the argument below about 0.02, so terms past the
// first few are below the f64 resolution.
def atan_series(t: f64) -> f64 {
    var square: f64 = t * t
    var term: f64 = t
    var sum: f64 = t
    var k: i32 = 1
    for {
        if k > 24 {
            break
        }
        term = -term * square
        var add: f64 = term / f64(2 * k + 1)
        sum += add
        var magnitude: f64 = add
        if magnitude < 0.0 {
            magnitude = -magnitude
        }
        if magnitude < 1.0e-18 {
            break
        }
        k += 1
    }
    return sum
}

// atan returns the arc tangent of x in radians. Halving the angle six times
// moves the argument below 0.02, where the series converges quickly; each
// halving doubles the result back.
def atan(x: f64) -> f64 {
    var t: f64 = x
    var sign_factor: f64 = 1.0
    if t < 0.0 {
        t = -t
        sign_factor = -1.0
    }
    var inverted: bool = false
    if t > 1.0 {
        t = 1.0 / t
        inverted = true
    }
    var halvings: i32 = 0
    for {
        if halvings >= 6 {
            break
        }
        t = t / (1.0 + sqrt(1.0 + t * t))
        halvings += 1
    }
    var r: f64 = atan_series(t) * 64.0
    if inverted {
        r = halfPi - r
    }
    if sign_factor < 0.0 {
        r = -r
    }
    return r
}

// Atan2 returns the angle in radians of the vector (x, y), with the result in
// [-Pi, Pi]. It uses the signs of both arguments, so the quarter matters; a
// zero vector has angle zero.
def atan2(y: f64, x: f64) -> f64 {
    if y != y || x != x {
        return nan()
    }
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + Pi
        }
        return atan(y / x) - Pi
    }
    if y > 0.0 {
        return halfPi
    }
    if y < 0.0 {
        return -halfPi
    }
    return 0.0
}
