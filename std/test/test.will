// T is the handle a test function receives. It records failures and log lines
// and owns no global state, so one case cannot affect another.
struct TestState {
    failed: bool
    logs: Array<str>
}

struct T {
    name: str
    state: rc<TestState>
}

// B is the handle a benchmark function receives. The runner owns the timing
// loop; B only carries the iteration count and the byte count.
struct B {
    name: str
    n: u64
    bytes: u64
    logs: Array<str>
}

// Capture is a reserved hook for redirecting stdout. The portable runner does
// not expose per-case capture yet, so Text is empty and Release is a no-op.
struct Capture {
    owned: bool
}

// Case is one table entry: a name and the body that receives its T.
struct Case {
    name: str
    run: func(T)
}

// NewT returns a case handle with no failures and no log lines.
func NewT(name: str) -> T {
    return T { name: name, state: new rc<TestState>(TestState { failed: false, logs: new Array<str>(0)})}
}

// NewB returns a benchmark handle with one iteration by default.
func NewB(name: str) -> B {
    return B { name: name, n: 1u64, bytes: 0u64, logs: new Array<str>(0)}
}

// Name returns the test name.
func (t: T) Name() -> str {
    return t.name
}

// Log records one message. It is shown only when the case fails.
func (mut t: T) Log(msg: str) {
    t.state.logs.Push(msg)
}

// Fail marks the case as failed without stopping it.
func (mut t: T) Fail() {
    t.state.failed = true
}

// FailNow marks the case and ends it through the shared fatal path.
func (mut t: T) FailNow() {
    t.state.failed = true
    Fatal("test failed: " + t.name)
}

// Failed reports whether the case failed.
func (t: T) Failed() -> bool {
    return t.state.failed
}

// Parallel is accepted for source compatibility; this runner is serial.
func (mut t: T) Parallel() {
}

// Run runs one nested case. A failure in the child marks the parent.
func (mut t: T) Run(name: str, f: func(T)) {
    var child: T = NewT(t.name + "/" + name)
    f(child)
    if child.Failed() {
        t.Fail()
    }
}

// Bench runs one benchmark body once. The timing loop belongs to the runner.
func (mut t: T) Bench(name: str, f: func(B)) {
    var b: B = NewB(t.name + "/" + name)
    f(b)
}

// runCases runs the entries in source order.
func runCases(cases: []Case) {
    for c in cases {
        var t: T = NewT(c.name)
        c.run(t)
    }
}

// Table runs one case for every entry, in source order. The runner stays
// serial; Parallel below has the same effect until a scheduler exposes it.
func Table(cases: ...Case) {
    runCases(cases)
}

// Parallel is accepted for source compatibility and runs the cases serially.
func Parallel(cases: ...Case) {
    runCases(cases)
}

// Capture starts a reserved output-capture scope. The portable runtime has no
// per-case sink yet, so this returns an inactive handle.
func (mut t: T) Capture() -> Capture {
    return Capture { owned: false}
}

// Text returns the captured bytes. The portable runner has none.
func (c: Capture) Text() -> str {
    return ""
}

// Release restores direct output. It is a no-op for the inactive handle.
func (mut c: Capture) Release() {
    c.owned = false
}

// Name returns the benchmark name.
func (b: B) Name() -> str {
    return b.name
}

// N returns the iteration count the runner asked for.
func (b: B) N() -> u64 {
    return b.n
}

// SetBytes records the payload size for a throughput report.
func (mut b: B) SetBytes(n: u64) {
    b.bytes = n
}

// NsPerOp returns the last measured time. The portable runner does not time
// yet, so the value is zero rather than invented.
func (b: B) NsPerOp() -> f64 {
    return 0.0
}

// Run runs one benchmark body once. The runner owns repetition and timing, so
// this is the single measured execution the portable path can provide.
func (mut b: B) Run(f: func()) -> Result<(), Error> {
    f()
    return Ok(())
}

// Log records one benchmark message.
func (mut b: B) Log(msg: str) {
    b.logs.Push(msg)
}


