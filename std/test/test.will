import c "clock.h" {
    fast willtest_now_ns
}

# TestState is the mutable part of a case. It is a class, so a case can be
# moved into a task while the runner keeps a reference for the verdict.
class TestState {
    failed: bool
    parallelizable: bool
    logs: list[str]

    def init(self, failed: bool, parallelizable: bool, logs: list[str]) {
        self.failed = failed
        self.parallelizable = parallelizable
        self.logs = logs.clone()
    }
}

# T is the handle a test function receives.
struct T {
    name: str
    state: TestState

    def name(self) -> str {
        return self.name.clone()
    }

    def log(self, msg: str) {
        self.state.logs.push(msg)
        if self.state.failed {
            print(msg, "\n")
        }
    }

    def fail(self) {
        if not self.state.failed {
            self.state.failed = True
            for msg in self.state.logs {
                print(msg, "\n")
            }
        }
    }

    def fail_now(self) {
        self.fail()
        fatal("test failed: " + self.name)
    }

    def failed(self) -> bool {
        return self.state.failed
    }

    def allow_parallel(self) {
        self.state.parallelizable = True
    }

    def run(self, name: str, f: func(T)) {
        var child: T = new_t(self.name + "/" + name)
        f(child)
        if child.failed() {
            self.fail()
        }
    }

    def bench(self, name: str, f: func(B)) {
        var b: B = new_b(self.name + "/" + name)
        f(b)
    }
}

# B is the handle a benchmark function receives. The runner owns the timing
# loop; B carries the iteration count, the byte count, and the last result.
struct B {
    name: str
    n: u64
    bytes: u64
    nsPerOp: f64
    logs: list[str]

    def name(self) -> str {
        return self.name.clone()
    }

    def n(self) -> u64 {
        return self.n
    }

    def set_bytes(self, n: u64) {
        self.bytes = n
    }

    def ns_per_op(self) -> f64 {
        return self.nsPerOp
    }

    def run(self, f: func()) -> Result<(), Error> {
        var count: u64 = self.n
        if count == 0u64 {
            count = 1u64
        }
        var start: i64 = c.willtest_now_ns()
        var i: u64 = 0u64
        while True {
            if i >= count {
                break
            }
            f()
            i += 1u64
        }
        var elapsed: i64 = c.willtest_now_ns() - start
        self.nsPerOp = f64(elapsed) / f64(count)
        return Ok(())
    }

    def log(self, msg: str) {
        self.logs.push(msg)
    }
}

# Case is one table entry: a name and the body that receives its T.
struct Case {
    name: str
    run: func(T)
}

# caseResult carries one finished case back to its caller.
struct caseResult {
    name: str
    state: TestState
}

# NewT returns a case handle with no failures and no log lines.
def new_t(name: str) -> T {
    return T {
        name: name.clone(),
        state: TestState(False, False, list[str](0))
    }
}

# NewB returns a benchmark handle with one iteration by default.
def new_b(name: str) -> B {
    return B { name: name.clone(), n: 1u64, bytes: 0u64, nsPerOp: 0.0, logs: list[str](0)}
}

















# runCase runs one table entry and returns its name and final state.
def run_case(spec: Case) -> caseResult {
    var t: T = new_t(spec.name)
    var state: TestState = t.state
    spec.run(t)
    return caseResult { name: spec.name.clone(), state: state}
}

# Table runs one case for every spec, in source order.
def table(cases: ...Case) {
    for spec in cases {
        var result: caseResult = run_case(spec)
        if result.state.failed {
            print("FAIL ", result.name, "\n")
        }
    }
}

# charsOf returns the scalars of s so two names can be compared by code point
# without a str ordering operator.
def chars_of(s: str) -> list[u32] {
    var out: list[u32] = list[u32](0)
    for ch in s {
        out.push(ch)
    }
    return out
}

# nameLess reports whether a sorts before b by code point order.
def name_less(a: str, b: str) -> bool {
    var left: list[u32] = chars_of(a)
    var right: list[u32] = chars_of(b)
    var n: usize = left.len()
    if right.len() < n {
        n = right.len()
    }
    for i in Range(0, i32(n)) {
        var x: u32 = left.get(usize(i))
        var y: u32 = right.get(usize(i))
        if x < y {
            return True
        }
        if x > y {
            return False
        }
    }
    return left.len() < right.len()
}

# sortResults orders finished cases by name. Insertion sort keeps the helper
# independent of any container sort method the lowering does not provide yet.
def sort_results(results: list[caseResult]) {
    var i: usize = 1usize
    while True {
        if i >= results.len() {
            break
        }
        var item: caseResult = results.get(i).clone()
        var j: usize = i
        while True {
            if j == 0usize {
                break
            }
            var previous: caseResult = results.get(j - 1usize).clone()
            if not name_less(item.name, previous.name) {
                break
            }
            results.set(j, previous)
            j -= 1usize
        }
        results.set(j, item)
        i += 1usize
    }
}

# RunCases runs every entry in its own task and reports failures in name order,
# so scheduling never changes the output. Cases must not share mutable state.
async def run_cases(cases: ...Case) {
    var n: usize = cases.len()
    if n == 0usize {
        return
    }
    var results: list[caseResult] = list[caseResult](n)
    region {
        var tasks: list[Task<caseResult>] = list[Task<caseResult>](n)
        for i in Range(0, i32(n)) {
            var spec: Case = cases.get(usize(i))
            tasks.push(spawn run_case(spec))
        }
        for i in Range(0, i32(n)) {
            var task: Task<caseResult> = tasks.get(usize(i))
            var value: caseResult = await task!
            results.push(value)
        }
    }
    sort_results(results)
    for result in results {
        if result.state.failed {
            print("FAIL ", result.name, "\n")
        }
    }
}












