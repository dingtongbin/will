// Assertion helpers for the test package. Each one reports a failure by
// panicking with the caller's message, so the report carries the source
// position of the assertion.

def assert(cond: bool, message: str) {
    if !cond {
        panic(message)
    }
}

def assert_equal<V>(got: V, want: V, message: str) {
    if !(got == want) {
        panic(message)
    }
}

def fatal(message: str) {
    panic(message)
}
