import "std/math"

// Bits is a fixed-width bit set of n bits, stored in 64-bit words. Bit i is bit
// i%64 of word i/64, so the low bits of the first word are the first bits of
// the set and no bit outside [0, n) is ever stored.
struct Bits {
    words: Array<u64>
    n: usize
}

// init sizes the word array to ceil(n/64) zero words. The constructor is
// new Bits(n), because the language has no T.New form.
func (mut b: Bits) init(n: usize) {
    var count: usize = (n + 63) / 64
    var i: usize = 0
    for {
        if i >= count {
            break
        }
        b.words.Push(0u64)
        i += 1
    }
    b.n = n
}

// Len returns the number of bits the set holds.
func (b: Bits) Len() -> usize {
    return b.n
}

// Set turns bit i on.
func (mut b: Bits) Set(i: usize) {
    b.require(i)
    var w: usize = i / 64
    var bit: u64 = u64(i % 64)
    b.words.Set(w, b.words.Get(w) | (1u64 << bit))
}

// Clear turns bit i off. It clears one bit, not the whole set.
func (mut b: Bits) Clear(i: usize) {
    b.require(i)
    var w: usize = i / 64
    var bit: u64 = u64(i % 64)
    b.words.Set(w, b.words.Get(w) & (math.U64Max ^ (1u64 << bit)))
}

// Flip turns bit i to its opposite.
func (mut b: Bits) Flip(i: usize) {
    b.require(i)
    var w: usize = i / 64
    var bit: u64 = u64(i % 64)
    b.words.Set(w, b.words.Get(w) ^ (1u64 << bit))
}

// Has reports whether bit i is on.
func (b: Bits) Has(i: usize) -> bool {
    b.require(i)
    var w: usize = i / 64
    var bit: u64 = u64(i % 64)
    return ((b.words.Get(w) >> bit) & 1u64) == 1u64
}

// Count returns how many bits are on.
func (b: Bits) Count() -> usize {
    var total: usize = 0
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        total += usize(math.PopCount64(b.words.Get(i)))
        i += 1
    }
    return total
}

// And keeps the bits that are on in both sets, in place.
func (mut b: Bits) And(other: Bits) {
    b.requireSame(other)
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        b.words.Set(i, b.words.Get(i) & other.words.Get(i))
        i += 1
    }
}

// Or turns on every bit that is on in either set, in place.
func (mut b: Bits) Or(other: Bits) {
    b.requireSame(other)
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        b.words.Set(i, b.words.Get(i) | other.words.Get(i))
        i += 1
    }
}

// Xor keeps the bits that differ between the two sets, in place.
func (mut b: Bits) Xor(other: Bits) {
    b.requireSame(other)
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        b.words.Set(i, b.words.Get(i) ^ other.words.Get(i))
        i += 1
    }
}

// AndNot keeps the bits that are on in b and off in other, in place.
func (mut b: Bits) AndNot(other: Bits) {
    b.requireSame(other)
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        b.words.Set(i, b.words.Get(i) & (math.U64Max ^ other.words.Get(i)))
        i += 1
    }
}

// Shrink releases spare capacity in the word array while keeping the bits.
func (mut b: Bits) Shrink() {
    b.words.ShrinkToFit()
}

// Clone returns an independent copy of the set.
func (b: Bits) Clone() -> Bits {
    var words: Array<u64> = new Array<u64>(0)
    var i: usize = 0
    for {
        if i >= b.words.Len() {
            break
        }
        words.Push(b.words.Get(i))
        i += 1
    }
    return Bits { words: words, n: b.n }
}

// require panics for an index outside the set. Set states that rule; Clear,
// Flip, and Has follow it so no operation can reach a bit the set does not hold.
func (b: Bits) require(i: usize) {
    if i >= b.n {
        panic("index out of bounds")
    }
}

// requireSame panics when the two sets cover different numbers of bits, since a
// bitwise operation over two widths has no single meaning.
func (b: Bits) requireSame(other: Bits) {
    if b.n != other.n {
        panic("bit set length mismatch")
    }
}
