import "std/math"

# Bits is a fixed-width bit set of n bits, stored in 64-bit words. Bit i is bit
# i%64 of word i/64, so the low bits of the first word are the first bits of
# the set and no bit outside [0, n) is ever stored.
struct Bits {
    words: list[u64]
    n: usize

    # init sizes the word array to ceil(n/64) zero words. The constructor is
    # Bits(n), because the language has no T.New form.
    def init(self, n: usize) {
        var count: usize = (n + 63) / 64
        var i: usize = 0
        while True {
            if i >= count {
                break
            }
            self.words.push(0u64)
            i += 1
        }
        self.n = n
    }

    # len returns the number of bits the set holds.
    def len(self) -> usize {
        return self.n
    }

    # set turns bit i on.
    def set(self, i: usize) {
        self.require(i)
        var w: usize = i / 64
        var bit: u64 = u64(i % 64)
        self.words.set(w, self.words.get(w) | (1u64 << bit))
    }

    # clear turns bit i off. It clears one bit, not the whole set.
    def clear(self, i: usize) {
        self.require(i)
        var w: usize = i / 64
        var bit: u64 = u64(i % 64)
        self.words.set(w, self.words.get(w) & (math.U64Max ^ (1u64 << bit)))
    }

    # flip turns bit i to its opposite.
    def flip(self, i: usize) {
        self.require(i)
        var w: usize = i / 64
        var bit: u64 = u64(i % 64)
        self.words.set(w, self.words.get(w) ^ (1u64 << bit))
    }

    # has reports whether bit i is on.
    def has(self, i: usize) -> bool {
        self.require(i)
        var w: usize = i / 64
        var bit: u64 = u64(i % 64)
        return ((self.words.get(w) >> bit) & 1u64) == 1u64
    }

    # count returns how many bits are on.
    def count(self) -> usize {
        var total: usize = 0
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            total += usize(math.pop_count64(self.words.get(i)))
            i += 1
        }
        return total
    }

    # intersect keeps the bits that are on in both sets, in place.
    def intersect(self, other: Bits) {
        self.require_same(other)
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            self.words.set(i, self.words.get(i) & other.words.get(i))
            i += 1
        }
    }

    # union turns on every bit that is on in either set, in place.
    def union(self, other: Bits) {
        self.require_same(other)
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            self.words.set(i, self.words.get(i) | other.words.get(i))
            i += 1
        }
    }

    # symmetric_difference keeps the bits that differ between the two sets, in place.
    def symmetric_difference(self, other: Bits) {
        self.require_same(other)
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            self.words.set(i, self.words.get(i) ^ other.words.get(i))
            i += 1
        }
    }

    # difference keeps the bits that are on in self and off in other, in place.
    def difference(self, other: Bits) {
        self.require_same(other)
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            self.words.set(i, self.words.get(i) & (math.U64Max ^ other.words.get(i)))
            i += 1
        }
    }

    # shrink releases spare capacity in the word array while keeping the bits.
    def shrink(self) {
        self.words.shrink_to_fit()
    }

    # clone returns an independent copy of the set.
    def clone(self) -> Bits {
        var words: list[u64] = list[u64](0)
        var i: usize = 0
        while True {
            if i >= self.words.len() {
                break
            }
            words.push(self.words.get(i))
            i += 1
        }
        return Bits { words: words, n: self.n }
    }

    # require panics for an index outside the set. set states that rule; clear,
    # flip, and has follow it so no operation can reach a bit the set does not
    # hold.
    def require(self, i: usize) {
        if i >= self.n {
            panic("index out of bounds")
        }
    }

    # require_same panics when the two sets cover different numbers of bits,
    # since a bitwise operation over two widths has no single meaning.
    def require_same(self, other: Bits) {
        if self.n != other.n {
            panic("bit set length mismatch")
        }
    }
}
