// FieldValue is one typed field value. The set of variants is closed, so a
// sink can render every field without reflection.
enum FieldValue {
    Str(str)
    Int(i64)
    Uint(u64)
    Float(f64)
    Bool(bool)
    Err(Error)
}

// Field is one structured key and value. It is a plain value with no lifetime,
// so it can be stored in an Array and handed to a sink.
struct Field {
    key: str
    value: FieldValue
}

// The constructors name the variant they build, so a caller writes
// log.Str("path") instead of log.FieldValue.Str("path").
func Str(key: str, value: str) -> Field {
    return Field { key: key, value: FieldValue.Str(value) }
}

func Int(key: str, value: i64) -> Field {
    return Field { key: key, value: FieldValue.Int(value) }
}

func Uint(key: str, value: u64) -> Field {
    return Field { key: key, value: FieldValue.Uint(value) }
}

func Float(key: str, value: f64) -> Field {
    return Field { key: key, value: FieldValue.Float(value) }
}

func Bool(key: str, value: bool) -> Field {
    return Field { key: key, value: FieldValue.Bool(value) }
}

// Err stores the error's message as the field value; a sink never gets a live
// error handle.
func Err(key: str, value: Error) -> Field {
    return Field { key: key, value: FieldValue.Err(value) }
}
