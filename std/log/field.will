// FieldValue is one typed field value. The set of variants is closed, so a
// sink can render every field without reflection.
enum FieldValue {
    Str(str)
    Int(i64)
    Uint(u64)
    Float(f64)
    Bool(bool)
}

// Field is one structured key and value. It is a plain value with no lifetime,
// so it can be stored in an Array and handed to a sink.
struct Field {
    key: str
    value: FieldValue
}

// The constructors name the variant they build, so a caller writes
// log.Str("path") instead of log.FieldValue.Str("path").
func Str(value: str) -> FieldValue {
    return FieldValue.Str(value)
}

func Int(value: i64) -> FieldValue {
    return FieldValue.Int(value)
}

func Uint(value: u64) -> FieldValue {
    return FieldValue.Uint(value)
}

func Float(value: f64) -> FieldValue {
    return FieldValue.Float(value)
}

func Bool(value: bool) -> FieldValue {
    return FieldValue.Bool(value)
}
