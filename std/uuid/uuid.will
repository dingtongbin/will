// Uuid is a 128-bit identifier. The two halves keep the byte order of the
// canonical text, so the first sixteen hexadecimal digits are the high half.
import "std/math/rand"
import c "entropy.h" {
    fast willrt_random_bytes
}

struct Uuid {
    high: u64
    low: u64
}

// uuidError is the error value of rejected text. 2 is the stable status of
// Invalid, so a caller classifies it without knowing this type.
struct uuidError {
    message: str
}

func (e: uuidError) Message() -> str {
    return e.message
}

func (e: uuidError) Status() -> i32 {
    return 2
}

func fail(message: str) -> uuidError {
    return uuidError { message: message}
}

// dashByte is the separator in the canonical 8-4-4-4-12 text.
const dashByte: u8 = 45

// hexValue returns the value of one hexadecimal digit, or -1 when the scalar
// is not a digit. Both cases of a letter are accepted, as RFC 4122 does.
func hexValue(ch: u32) -> i32 {
    if ch >= 48u32 && ch <= 57u32 {
        return i32(ch - 48u32)
    }
    if ch >= 97u32 && ch <= 102u32 {
        return i32(ch - 97u32) + 10
    }
    if ch >= 65u32 && ch <= 70u32 {
        return i32(ch - 65u32) + 10
    }
    return -1
}

// hexChar returns the lowercase hexadecimal digit of a value in 0..15.
func hexChar(v: u32) -> u8 {
    if v < 10u32 {
        return u8(48u32 + v)
    }
    return u8(87u32 + v)
}

// appendGroup appends four hexadecimal digits of value starting at shift.
func appendGroup(mut out: Array<u8>, value: u64, shift: i32) {
    var i: i32 = 0
    for {
        if i >= 4 {
            break
        }
        var digit: u64 = (value >> u64(shift - 4 * i)) & 15u64
        out.Push(hexChar(u32(digit)))
        i += 1
    }
}

// appendDash appends the separator between two groups.
func appendDash(mut out: Array<u8>) {
    out.Push(dashByte)
}

// versioned sets the RFC 4122 version 4 and variant 10 bits in the two halves
// of the identifier.
func versioned(high: u64, low: u64) -> Uuid {
    return Uuid {
        high: (high & 0xffffffffffff0fffu64) | 0x0000000000004000u64,
        low: (low & 0x3fffffffffffffffu64) | 0x8000000000000000u64,
    }
}

// New builds one v4 identifier from the caller's random stream. The caller
// owns the seed, so a test can reproduce the result.
func New(mut r: rand.Rand) -> Uuid {
    var high: u64 = r.NextU64()
    var low: u64 = r.NextU64()
    return versioned(high, low)
}

// NewRandom builds one v4 identifier from the system entropy source. A
// platform without a usable source returns Err instead of a predictable id.
func NewRandom() -> Result<Uuid, Error> {
    var high: u64 = 0
    var low: u64 = 0
    if c.willrt_random_bytes(raw(high), 8usize) != 0 {
        return Err(fail("uuid: the system entropy source is not available"))
    }
    if c.willrt_random_bytes(raw(low), 8usize) != 0 {
        return Err(fail("uuid: the system entropy source is not available"))
    }
    return Ok(versioned(high, low))
}

// Parse reads the canonical 8-4-4-4-12 hexadecimal text of a UUID. The
// hyphens are mandatory and the digits may be either case; any other text is a
// parse failure.
func Parse(s: str) -> Result<Uuid, Error> {
    if s.Len() != 36usize {
        return Err(fail("uuid: text is not 36 bytes"))
    }
    var high: u64 = 0
    var low: u64 = 0
    var digits: i32 = 0
    for i, ch in s {
        if i == 8usize || i == 13usize || i == 18usize || i == 23usize {
            if ch != u32(dashByte) {
                return Err(fail("uuid: a separator is in the wrong place"))
            }
            continue
        }
        var d: i32 = hexValue(ch)
        if d < 0 {
            return Err(fail("uuid: text has a non-hexadecimal digit"))
        }
        if digits < 16 {
            high = high * 16u64 + u64(d)
        } else {
            low = low * 16u64 + u64(d)
        }
        digits += 1
    }
    return Ok(Uuid { high: high, low: low})
}

// byteAt returns one byte of a 64-bit half after shifting it down.
func byteAt(value: u64, shift: u64) -> u8 {
    return u8((value >> shift) & 255u64)
}

// Bytes returns the sixteen bytes in network order: the high half first, then
// the low half, each most significant byte first.
func (u: Uuid) Bytes() -> [16]u8 {
    var out: [16]u8
    out[0] = byteAt(u.high, 56u64)
    out[1] = byteAt(u.high, 48u64)
    out[2] = byteAt(u.high, 40u64)
    out[3] = byteAt(u.high, 32u64)
    out[4] = byteAt(u.high, 24u64)
    out[5] = byteAt(u.high, 16u64)
    out[6] = byteAt(u.high, 8u64)
    out[7] = byteAt(u.high, 0u64)
    out[8] = byteAt(u.low, 56u64)
    out[9] = byteAt(u.low, 48u64)
    out[10] = byteAt(u.low, 40u64)
    out[11] = byteAt(u.low, 32u64)
    out[12] = byteAt(u.low, 24u64)
    out[13] = byteAt(u.low, 16u64)
    out[14] = byteAt(u.low, 8u64)
    out[15] = byteAt(u.low, 0u64)
    return out
}

// String returns the canonical lowercase 8-4-4-4-12 text of u.
func (u: Uuid) String() -> str {
    var out: Array<u8> = new Array<u8>(0)
    appendGroup(out, u.high, 60)
    appendGroup(out, u.high, 44)
    appendDash(out)
    appendGroup(out, u.high, 28)
    appendDash(out)
    appendGroup(out, u.high, 12)
    appendDash(out)
    appendGroup(out, u.low, 60)
    appendDash(out)
    appendGroup(out, u.low, 44)
    appendGroup(out, u.low, 28)
    appendGroup(out, u.low, 12)
    return str(out)
}
