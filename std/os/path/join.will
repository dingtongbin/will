// Join joins the non-empty parts with the portable separator and cleans the
// result. Empty parts contribute nothing, so Join("a", "") is "a", and a call
// with no non-empty part is "" rather than ".".
func Join(parts: ...str) -> str {
    var out: Array<u8> = new Array<u8>(0)
    var any: bool = false
    for p in parts {
        if p.Len() == 0usize {
            continue
        }
        if any {
            out.Push(u8(47))
        }
        for byte in p[Range(0, p.Len())] {
            out.Push(byte)
        }
        any = true
    }
    if !any {
        return ""
    }
    var joined: str = str(out)
    return Clean(joined)
}
