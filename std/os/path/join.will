# Join joins the non-empty parts with the platform separator and cleans the
# result. Empty parts contribute nothing, so Join("a", "") is "a", and a call
# with no non-empty part is "" rather than ".".
def join(parts: ...str) -> str {
    var sep: u8 = separator()
    var out: Array<u8> = new Array<u8>(0)
    var any: bool = False
    for p in parts {
        if p.len() == 0usize {
            continue
        }
        if any {
            out.push(sep)
        }
        out.append(p[Range(0, p.len())])
        any = True
    }
    if not any {
        return ""
    }
    var joined: str = str(out)
    return clean(joined)
}
