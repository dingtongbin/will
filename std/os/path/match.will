# __starScalar is the ASCII code of the wildcard '*'.
const __starScalar: u32 = 42

# __questionScalar is the ASCII code of the wildcard '?'.
const __questionScalar: u32 = 63

# charsOf returns the Unicode scalars of s, so the matcher compares characters
# rather than bytes and a wildcard can never split one.
def __chars_of(s: str) -> Array<u32> {
    var out: Array<u32> = new Array<u32>(0)
    for c in s {
        out.push(c)
    }
    return out
}

# Glob reports whether name matches pattern as a whole. The volume fixes the
# signature but not the grammar; this implementation supports '*' for any run
# of non-separator scalars and '?' for one non-separator scalar, and every
# other scalar matches itself. Neither wildcard matches the separator, so one
# wildcard never spans a directory boundary.
def glob(pattern: str, name: str) -> bool {
    var pat: Array<u32> = __chars_of(pattern)
    var text: Array<u32> = __chars_of(name)
    var pi: usize = 0
    var si: usize = 0
    var star: usize = 0
    var mark: usize = 0
    var hasStar: bool = False
    while True {
        if si >= text.len() {
            break
        }
        if pi < pat.len() {
            var pc: u32 = pat.get(pi)
            if pc == __starScalar {
                # Remember where the star starts and let the next pattern
                # scalar try to match at once, which is the zero-length case.
                star = pi + 1usize
                mark = si
                hasStar = True
                pi += 1usize
                continue
            }
            var tc: u32 = text.get(si)
            var matched: bool = False
            if pc == __questionScalar {
                matched = not __is_slash(tc)
            } else {
                matched = pc == tc
            }
            if matched {
                pi += 1usize
                si += 1usize
                continue
            }
        }
        if not hasStar {
            return False
        }
        # The star takes one more scalar and the rest of the pattern is retried
        # from the saved position, so a failure never needs a recursive frame.
        var extend: u32 = text.get(mark)
        if __is_slash(extend) {
            return False
        }
        mark += 1usize
        si = mark
        pi = star
    }
    while True {
        if pi >= pat.len() {
            break
        }
        var pc: u32 = pat.get(pi)
        if pc != __starScalar {
            return False
        }
        pi += 1usize
    }
    return True
}
