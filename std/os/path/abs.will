# Abs resolves a relative path against the process working directory. A path
# that is already rooted is only cleaned; the working directory is read once
# through std/os for every relative call.
import "std/os"

def abs(p: str) -> Result<str, Error> {
    if p.len() != 0usize {
        var s: str = p.clone()
        if is_separator(s[0]) or is_drive_abs(s) {
            return Ok(clean(p))
        }
    }
    var cwd: str = os.cwd()?
    return Ok(clean(join(cwd, p)))
}
