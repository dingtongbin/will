# Ext returns the suffix of the last element that starts at its final dot, or
# "" when the element has no dot. A leading dot names a dotfile, so Ext(".txt")
# is ".txt"; a dot before the last separator does not count, so Ext("a.b/c")
# is "".
def ext(p: str) -> str {
    var at: usize = 0usize
    var found: bool = False
    for i, c in p {
        if is_separator(c) {
            found = False
        } else if is_dot(c) {
            at = i
            found = True
        }
    }
    if not found {
        return ""
    }
    var suffix: str = str(p[Range(at, p.len())])
    return suffix
}
