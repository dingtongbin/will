// IsAbs reports whether the path is rooted. On Windows that includes a drive
// root such as "C:\"; on every target a leading separator is rooted.
func IsAbs(p: str) -> bool {
    if p.Len() == 0usize {
        return false
    }
    var s: str = p.Clone()
    var first: u32 = s[0]
    if isSeparator(first) {
        return true
    }
    return isDriveAbs(s)
}
