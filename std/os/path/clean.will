// isDotElement reports whether p[a:b] is the single-dot element.
func isDotElement(p: str, a: usize, b: usize) -> bool {
    if b - a != 1usize {
        return false
    }
    var s: str = p.Clone()
    var c: u32 = s[a]
    return isDot(c)
}

// isDotDotElement reports whether p[a:b] is the two-dot element.
func isDotDotElement(p: str, a: usize, b: usize) -> bool {
    if b - a != 2usize {
        return false
    }
    var second: usize = a + 1usize
    var s: str = p.Clone()
    var firstChar: u32 = s[a]
    var secondChar: u32 = s[second]
    return isDot(firstChar) && isDot(secondChar)
}

// pushElement adds one element to the cleaned path or resolves a dot-dot. It
// returns the new element count; a dot-dot removes the previous element unless
// that would leave a relative path, in which case the dot-dot itself is kept.
func pushElement(p: str, a: usize, b: usize, rooted: bool, starts: Array<usize>, ends: Array<usize>, count: usize) -> usize {
    if isDotElement(p, a, b) {
        return count
    }
    if isDotDotElement(p, a, b) {
        if rooted {
            if count > 0usize {
                return count - 1usize
            }
            return count
        }
        if count > 0usize {
            var top: usize = count - 1usize
            var topA: usize = starts.Get(top)
            var topB: usize = ends.Get(top)
            if !isDotDotElement(p, topA, topB) {
                return count - 1usize
            }
        }
    }
    if starts.Len() > count {
        starts.Set(count, a)
    } else {
        starts.Push(a)
    }
    if ends.Len() > count {
        ends.Set(count, b)
    } else {
        ends.Push(b)
    }
    return count + 1usize
}

// Clean returns the shortest path that names the same location: it removes
// empty elements, single dots, and every element followed by dot-dot, and it
// resolves leading dot-dot against a rooted path or a drive root. The result is
// "." when nothing is left of a relative path, and the platform root when
// nothing is left of a rooted one.
func Clean(p: str) -> str {
    var s: str = p.Clone()
    var n: usize = s.Len()
    var volumeEnd: usize = 0usize
    var scan: usize = 0usize
    var rooted: bool = false
    if hasDrive(s) {
        volumeEnd = 2usize
        scan = 2usize
        var third: u32 = 0u32
        if n > 2usize {
            third = s[2]
        }
        if isSeparator(third) {
            rooted = true
            scan = 3usize
        }
    } else if n > 0usize {
        var first: u32 = s[0]
        if isSeparator(first) {
            rooted = true
        }
    }
    var starts: Array<usize> = new Array<usize>(0)
    var ends: Array<usize> = new Array<usize>(0)
    var count: usize = 0usize
    var start: usize = 0usize
    var inElement: bool = false
    for i, c in s {
        if i < scan {
            continue
        }
        if isSeparator(c) {
            if inElement {
                count = pushElement(s, start, i, rooted, starts, ends, count)
                inElement = false
            }
        } else if !inElement {
            start = i
            inElement = true
        }
    }
    if inElement {
        count = pushElement(s, start, n, rooted, starts, ends, count)
    }
    var sep: u8 = Separator()
    var out: Array<u8> = new Array<u8>(0)
    if volumeEnd > 0usize {
        var driveLetter: u32 = s[0]
        var driveColon: u32 = s[1]
        out.Push(u8(driveLetter))
        out.Push(u8(driveColon))
    }
    if rooted {
        out.Push(sep)
    }
    var k: usize = 0usize
    for {
        if k >= count {
            break
        }
        if k > 0usize {
            out.Push(sep)
        }
        var a: usize = starts.Get(k)
        var b: usize = ends.Get(k)
        out.Append(s[Range(a, b)])
        k += 1usize
    }
    if count == 0usize {
        if volumeEnd > 0usize && !rooted {
            return str(out) + "."
        }
        if out.Len() == 0usize {
            return "."
        }
    }
    return str(out)
}
