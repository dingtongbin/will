// File paths and handles for std/os/fs. The plain names are the blocking
// spellings; the Async names are suspension points lowered to task frames.
import "std/errors"

import c "fs.c" {
    fast willrt_fs_read_file
    fast willrt_fs_write_file
    fast willrt_fs_append_file
    fast willrt_fs_open
    fast willrt_fs_create
    fast willrt_fs_file_read
    fast willrt_fs_file_write
    fast willrt_fs_file_seek
    fast willrt_fs_file_sync
    fast willrt_fs_file_close
    fast willrt_fs_file_stat
    fast willrt_fs_stat
    fast willrt_fs_read_dir
    fast willrt_fs_rename
    fast willrt_fs_remove
    fast willrt_fs_temp_file
    fast willrt_fs_mkdir
    fast willrt_fs_mkdir_all
    fast willrt_fs_remove_all
    fast willrt_fs_symlink
    fast willrt_fs_temp_dir
    fast willrt_fs_async_read_file
    fast willrt_fs_async_write_file
    fast willrt_fs_async_append
    fast willrt_fs_async_open
    fast willrt_fs_async_create
    fast willrt_fs_async_file_read
    fast willrt_fs_async_file_write
    fast willrt_fs_async_file_seek
    fast willrt_fs_async_file_sync
    fast willrt_fs_async_file_stat
    fast willrt_fs_async_stat
    fast willrt_fs_async_read_dir
    fast willrt_fs_async_rename
    fast willrt_fs_async_remove
    fast willrt_fs_async_temp_file
    fast willrt_fs_async_mkdir
    fast willrt_fs_async_mkdir_all
    fast willrt_fs_async_remove_all
    fast willrt_fs_async_symlink
    fast willrt_fs_async_temp_dir
}

// OpenFlags selects the access mode for Open.
struct OpenFlags {
    read: bool
    write: bool
    create: bool
    append: bool
    truncate: bool
    exclusive: bool
}

// File is one open file handle. Close releases it.
struct File {
    handle: raw
}

// StatInfo is the metadata of one path. mtime is seconds since the Unix epoch.
// The type and the Stat function need distinct names in will's package
// namespace.
struct StatInfo {
    size: i64
    mode: u32
    mtime: i64
    isDir: bool
    isSymlink: bool
}

// DirEntry is one name returned by ReadDir.
struct DirEntry {
    name: str
    isDir: bool
    size: i64
}

struct fsError {
    message: str
}

func (e: fsError) Message() -> str {
    return e.message
}

func (e: fsError) Status() -> i32 {
    return 7
}

// ReadFile returns every byte of path.
func ReadFile(path: str) -> Result<Array<u8>, Error> {
    var out: Array<u8> = new Array<u8>(0)
    var status: i32 = c.willrt_fs_read_file(raw(path), raw(out))
    if status != 0 {
        return Err(fsError { message: "fs: cannot read file"})
    }
    return Ok(out)
}

// WriteFile replaces path with data.
func WriteFile(path: str, data: []u8) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_write_file(raw(path), raw(data))
    if status != 0 {
        return Err(fsError { message: "fs: cannot write file"})
    }
    return Ok(())
}

// Append writes data at the end of path.
func Append(path: str, data: []u8) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_append_file(raw(path), raw(data))
    if status != 0 {
        return Err(fsError { message: "fs: cannot append file"})
    }
    return Ok(())
}

// Open opens path with flags.
func Open(path: str, flags: OpenFlags) -> Result<File, Error> {
    var file: File
    var status: i32 = c.willrt_fs_open(raw(path), raw(flags), raw(file))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(file)
}

// Create truncates or creates path and opens it for reading and writing.
func Create(path: str, mode: u32) -> Result<File, Error> {
    var file: File
    var status: i32 = c.willrt_fs_create(raw(path), mode, raw(file))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(file)
}

// Read appends bytes into buf. It returns the number read; zero means EOF.
func (f: File) Read(mut buf: Array<u8>) -> Result<usize, Error> {
    var count: usize = 0
    var status: i32 = c.willrt_fs_file_read(raw(f), raw(count), raw(buf))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(count)
}

// Write writes every byte of buf.
func (f: File) Write(buf: []u8) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_file_write(raw(f), raw(buf))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// Seek moves the file position and returns the new offset.
func (f: File) Seek(offset: i64, whence: i32) -> Result<i64, Error> {
    var at: i64 = 0
    var status: i32 = c.willrt_fs_file_seek(raw(f), offset, whence, raw(at))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(at)
}

// AsyncRead is the async spelling of Read. A call parks its task frame until
// the blocking pool finishes the host read.
async func (f: File) AsyncRead(mut buf: Array<u8>) -> Result<usize, Error> {
    var count: usize = 0
    var status: i32 = await c.willrt_fs_async_file_read(raw(f), raw(count), raw(buf))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(count)
}

// AsyncWrite is the async spelling of Write.
async func (f: File) AsyncWrite(buf: []u8) -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_file_write(raw(f), raw(buf))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// AsyncSeek is the async spelling of Seek.
async func (f: File) AsyncSeek(offset: i64, whence: i32) -> Result<i64, Error> {
    var at: i64 = 0
    var status: i32 = await c.willrt_fs_async_file_seek(raw(f), offset, whence, raw(at))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(at)
}

// AsyncSync is the async spelling of Sync.
async func (f: File) AsyncSync() -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_file_sync(raw(f))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// AsyncStat returns the metadata of the open file.
async func (f: File) AsyncStat() -> Result<StatInfo, Error> {
    var stat: StatInfo
    var status: i32 = await c.willrt_fs_async_file_stat(raw(f), raw(stat))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(stat)
}

// Sync flushes buffered writes to the host.
func (f: File) Sync() -> Result<(), Error> {
    var status: i32 = c.willrt_fs_file_sync(raw(f))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// Close releases the file handle. A closed handle is safe to close again.
func (mut f: File) Close() -> Result<(), Error> {
    var status: i32 = c.willrt_fs_file_close(raw(f))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// Stat returns the metadata of path.
func Stat(path: str) -> Result<StatInfo, Error> {
    var stat: StatInfo
    var status: i32 = c.willrt_fs_stat(raw(path), raw(stat))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(stat)
}

// ReadDir returns the directory entries sorted by name.
func ReadDir(path: str) -> Result<Array<DirEntry>, Error> {
    var entries: Array<DirEntry>
    var status: i32 = c.willrt_fs_read_dir(raw(path), raw(entries))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(entries)
}

// Rename moves old to new.
func Rename(old: str, new: str) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_rename(raw(old), raw(new))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// Remove deletes one file or empty directory.
func Remove(path: str) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_remove(raw(path))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// TempFile creates a temporary file under dir. The handle is open for reading
// and writing.
func TempFile(dir: str, pattern: str) -> Result<File, Error> {
    var file: File
    var status: i32 = c.willrt_fs_temp_file(raw(dir), raw(pattern), raw(file))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(file)
}

// Mkdir creates one directory.
func Mkdir(path: str, mode: u32) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_mkdir(raw(path), mode)
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// MkdirAll creates path and every missing parent.
func MkdirAll(path: str, mode: u32) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_mkdir_all(raw(path), mode)
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// RemoveAll removes path and everything below it.
func RemoveAll(path: str) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_remove_all(raw(path))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// Symlink creates a symbolic link at link that names target.
func Symlink(target: str, link: str) -> Result<(), Error> {
    var status: i32 = c.willrt_fs_symlink(raw(target), raw(link))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// TempDir creates a directory under dir and returns its path.
func TempDir(dir: str, pattern: str) -> Result<str, Error> {
    var out: str = ""
    var status: i32 = c.willrt_fs_temp_dir(raw(dir), raw(pattern), raw(out))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(out)
}

// AsyncMkdir is the async spelling of Mkdir.
async func AsyncMkdir(path: str, mode: u32) -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_mkdir(raw(path), mode)
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// AsyncMkdirAll is the async spelling of MkdirAll.
async func AsyncMkdirAll(path: str, mode: u32) -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_mkdir_all(raw(path), mode)
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// AsyncRemoveAll is the async spelling of RemoveAll.
async func AsyncRemoveAll(path: str) -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_remove_all(raw(path))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

// AsyncSymlink is the async spelling of Symlink.
async func AsyncSymlink(target: str, link: str) -> Result<(), Error> {
    var status: i32 = await c.willrt_fs_async_symlink(raw(target), raw(link))
    if status != 0 {
        return Err(errors.Io)
    }
    return Ok(())
}

