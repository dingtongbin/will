# ExitStatus is the result of a process that has ended. signaled distinguishes
# a code the process returned from a signal that stopped it.
struct ExitStatus {
    code: i32
    signaled: bool
}

# Output holds everything a finished process wrote. It is the whole-stream
# result; a caller that cannot hold the output reads a pipe instead.
struct Output {
    stdout: Array<u8>
    stderr: Array<u8>
    status: ExitStatus
}
