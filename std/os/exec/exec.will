# Process execution. The shim launches the explicit path and argument vector
# through the host shell and returns the exit status; Output captures stdout
# and stderr in separate arrays.
import c "exec.c" {
    fast willrt_exec_run_async
    fast willrt_exec_output_async
}

struct execError {
    message: str

    def message(self) -> str {
        return self.message.clone()
    }

    def status(self) -> i32 {
        return 7
    }
}

# AsyncRun runs c and returns its exit status.
async def (cmd: ref Cmd) run() -> Result<ExitStatus, Error> {
    var envpairs: Array<str> = new Array<str>(0)
    var keys: list[str] = cmd.env.keys()
    var values: list[str] = cmd.env.values()
    var i: usize = 0
    while i < len(keys) {
        envpairs.push(keys.get(i))
        envpairs.push(values.get(i))
        i += 1
    }
    var status: ExitStatus
    var code: i32 = await c.willrt_exec_run_async(raw(cmd.path), raw(cmd.args), raw(envpairs),
                                             raw(cmd.dir), raw(status))
    if code != 0 {
        return Err(execError { message: "exec: cannot run" })
    }
    return Ok(status)
}

# AsyncOutput runs c and captures both output streams.
async def (cmd: ref Cmd) output() -> Result<Output, Error> {
    var envpairs: Array<str> = new Array<str>(0)
    var keys: list[str] = cmd.env.keys()
    var values: list[str] = cmd.env.values()
    var i: usize = 0
    while i < len(keys) {
        envpairs.push(keys.get(i))
        envpairs.push(values.get(i))
        i += 1
    }
    var out: Array<u8>
    var err: Array<u8>
    var status: ExitStatus
    var code: i32 = await c.willrt_exec_output_async(raw(cmd.path), raw(cmd.args), raw(envpairs),
                                                raw(cmd.dir), raw(out), raw(err),
                                                raw(status))
    if code != 0 {
        return Err(execError { message: "exec: cannot capture output" })
    }
    return Ok(Output { stdout: out, stderr: err, status: status })
}
