// Process execution. The shim launches the explicit path and argument vector
// through the host shell and returns the exit status; Output captures stdout
// and stderr in separate arrays.
import c "exec.c" {
    fast willrt_exec_run
    fast willrt_exec_output
    fast willrt_exec_run_async
    fast willrt_exec_output_async
}

struct execError {
    message: str
}

func (e: execError) Message() -> str {
    return e.message
}

func (e: execError) Status() -> i32 {
    return 7
}

// AsyncRun runs c and returns its exit status.
func (cmd: Cmd) AsyncRun() -> Result<ExitStatus, Error> {
    var envpairs: Array<str> = new Array<str>(0)
    for key, value in cmd.env {
        envpairs.Push(key)
        envpairs.Push(value)
    }
    var status: ExitStatus
    var code: i32 = c.willrt_exec_run_async(raw(cmd.path), raw(cmd.args), raw(envpairs),
                                             raw(cmd.dir), raw(status))
    if code != 0 {
        return Err(execError { message: "exec: cannot run" })
    }
    return Ok(status)
}

// AsyncOutput runs c and captures both output streams.
func (cmd: Cmd) AsyncOutput() -> Result<Output, Error> {
    var envpairs: Array<str> = new Array<str>(0)
    for key, value in cmd.env {
        envpairs.Push(key)
        envpairs.Push(value)
    }
    var out: Array<u8>
    var err: Array<u8>
    var status: ExitStatus
    var code: i32 = c.willrt_exec_output_async(raw(cmd.path), raw(cmd.args), raw(envpairs),
                                                raw(cmd.dir), raw(out), raw(err),
                                                raw(status))
    if code != 0 {
        return Err(execError { message: "exec: cannot capture output" })
    }
    return Ok(Output { stdout: out, stderr: err, status: status })
}
