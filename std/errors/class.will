enum ErrorClass {
    NotFound
    Deadline
    Canceled
    Busy
    Upstream
    Bug
}

interface Classified {
    def class() -> ErrorClass
}

// ClassOf maps the stable status code to a class. Only the statuses that name
// a class of their own have one: 1 is NotFound, 3 is Busy, 5 is Upstream,
// 8 is Canceled, and 9 is Deadline. Every other status, including 0, is a Bug,
// so a caller that retries on Busy or Upstream never retries an unknown
// failure.
// The Classified interface is the narrower shape a caller uses directly when
// it holds a concrete type; ClassOf itself reads Status(), which every Error
// provides.
def class_of(e: Error) -> ErrorClass {
    return class_of_status(e.status())
}

def class_of_status(status: i32) -> ErrorClass {
    var c: ErrorClass = ErrorClass.Bug()
    match status {
        1 => {
            c = ErrorClass.NotFound()
        }
        3 => {
            c = ErrorClass.Busy()
        }
        5 => {
            c = ErrorClass.Upstream()
        }
        8 => {
            c = ErrorClass.Canceled()
        }
        9 => {
            c = ErrorClass.Deadline()
        }
        _ => {
            c = ErrorClass.Bug()
        }
    }
    return c
}
