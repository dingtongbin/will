# Fault is the concrete error value shared by the standard library: a stable
# message for people and a stable status code for classification.
struct Fault {
    message: str
    status: i32

    def init(self, message: str, status: i32) {
        self.message = message.clone()
        self.status = status
    }

    def message(self) -> str {
        return self.message.clone()
    }

    def status(self) -> i32 {
        return self.status
    }

    def error_class(self) -> ErrorClass {
        return class_of_status(self.status)
    }
}
