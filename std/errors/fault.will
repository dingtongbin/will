// Fault is the concrete error value shared by the standard library: a stable
// message for people and a stable status code for classification.
struct Fault {
    message: str
    status: i32
}

def (mut f: Fault) init(message: str, status: i32) {
    f.message = message.Clone()
    f.status = status
}

def (f: Fault) Message() -> str {
    return f.message.Clone()
}

def (f: Fault) Status() -> i32 {
    return f.status
}

def (f: Fault) Class() -> ErrorClass {
    return classOfStatus(f.status)
}
