# Format holds one value together with the precision, base, width, and fill
# byte its constructor was given. The fields are private so a value can only
# come from Int, Uint, Float, Hex, or Pad; Show is the only reader.
struct Format {
    kind: i32
    value: u64
    negative: bool
    base: u32
    width: i32
    pad: u8
    left: bool
    text: str

    # Show renders the field. A number is right aligned: the sign, then the
    # fill bytes, then the digits. Text follows the side Pad was given.
    def show(self) -> str {
        if self.kind == formatText {
            return pad_text(self.text, self.width, self.pad, self.left)
        }
        if self.kind == formatFloat {
            return signed_text(self.negative, self.text, self.width, self.pad)
        }
        return self.number_text()
    }

    def number_text(self) -> str {
        return signed_text(self.negative, digits_of(self.value, self.base), self.width, self.pad)
    }
}

# formatText marks a text field that was handed to Pad. It is zero so the zero
# Format renders an empty text instead of touching an unset base.
const formatText: i32 = 0
const formatNumber: i32 = 1
const formatFloat: i32 = 2

