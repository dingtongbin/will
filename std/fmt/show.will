// textOf joins the shown text of parts. It appends into one byte array so the
// result costs linear time even when many parts are joined. Str and the
// printers share it because a variadic argument cannot be forwarded as one
// part.
def textOf(parts: []Show) -> str {
    var out: Array<u8> = new Array<u8>(0)
    var n: i32 = i32(parts.Len())
    for i in Range(0, n) {
        var text: str = parts[i].Show()
        out.Append(text[Range(0, text.Len())])
    }
    return str(out)
}

// Str joins the shown text of its parts. It builds the result in memory and
// never writes to standard output; Println is the writer.
def Str(parts: ...Show) -> str {
    return textOf(parts)
}
