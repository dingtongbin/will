# Printing to standard output and to a Writer.

import "std/io"

# Println writes the shown parts and a newline to standard output. The write
# reaches the runtime directly, so the call does not wait on a task frame.
def println(parts: ...Show) {
    print(text_of(parts))
    print("\n")
}

# Printf writes the shown parts to w and reports the first write error.
async def printf(w: io.Writer, parts: ...Show) -> Result<(), Error> {
    var text: str = text_of(parts)
    var n: usize = text.len()
    return await w.write(text[Range(0, n)])
}
