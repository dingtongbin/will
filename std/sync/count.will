# Count waits for a counter to reach zero. Workers decrement it when they
# finish, so the shutdown path waits on one value instead of joining each task.
import "std/errors"

import c "sync.h" {
    fast willrt_sync_count_new
    fast willrt_sync_count_add
    fast willrt_sync_count_load
    fast willrt_sync_count_wait_async
    fast willrt_sync_count_wait_blocking
}

struct Count {
    handle: raw

    def init(self, n: i64) {
        self.handle = c.willrt_sync_count_new(n)
    }

    def add(self, d: i64) {
        c.willrt_sync_count_add(self.handle, d)
    }

    async def wait(self) -> Result<(), Error> {
        var status: i32 = await c.willrt_sync_count_wait_async(self.handle)
        if status == 0 {
            return Ok(())
        }
        if status == -5 {
            return Err(Canceled)
        }
        if status == -6 {
            return Err(Deadline)
        }
        return Err(errors.Io)
    }

    def wait_blocking(self) -> Result<(), Error> {
        var status: i32 = c.willrt_sync_count_wait_blocking(self.handle)
        if status == 0 {
            return Ok(())
        }
        if status == -5 {
            return Err(Canceled)
        }
        if status == -6 {
            return Err(Deadline)
        }
        return Err(errors.Io)
    }

    def load(self) -> i64 {
        return c.willrt_sync_count_load(self.handle)
    }
}










