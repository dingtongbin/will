# Semaphore caps how many holders may pass at the same time. A release moves
# the permit to the next waiter directly, so a canceled waiter never spends a
# permit it did not get.
import "std/errors"

import c "sync.h" {
    fast willrt_sync_sema_new
    fast willrt_sync_sema_acquire_async
    fast willrt_sync_sema_acquire_blocking
    fast willrt_sync_sema_try_acquire
    fast willrt_sync_sema_release
}

# Permit is one held permit. Release returns it to the semaphore.
struct Permit {
    handle: raw

    def release(self) {
        _ = c.willrt_sync_sema_release(self.handle)
    }
}



struct Semaphore {
    handle: raw

    def init(self, permits: i64) {
        self.handle = c.willrt_sync_sema_new(permits)
    }

    async def acquire(self) -> Result<Permit, Error> {
        var status: i32 = await c.willrt_sync_sema_acquire_async(self.handle)
        if status == 0 {
            return Ok(Permit { handle: self.handle })
        }
        if status == -5 {
            return Err(Canceled)
        }
        if status == -6 {
            return Err(Deadline)
        }
        return Err(errors.Io)
    }

    def acquire_blocking(self) -> Result<Permit, Error> {
        var status: i32 = c.willrt_sync_sema_acquire_blocking(self.handle)
        if status == 0 {
            return Ok(Permit { handle: self.handle })
        }
        if status == -5 {
            return Err(Canceled)
        }
        if status == -6 {
            return Err(Deadline)
        }
        return Err(errors.Io)
    }

    def try_acquire(self) -> Option<Permit> {
        if c.willrt_sync_sema_try_acquire(self.handle) == 1 {
            return Some(Permit { handle: self.handle })
        }
        return None
    }
}










