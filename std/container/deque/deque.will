# Deque is a double-ended queue with indexed access.
class Deque<T> {
    items: list[T]

    def init(self, capacity: usize) {
        self.items = list[T](capacity)
    }

    def push_front(self, v: T) {
        self.items.insert(0usize, v)
    }

    def push_back(self, v: T) {
        self.items.push(v)
    }

    def pop_front(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        return Some(self.items.remove(0usize))
    }

    def pop_back(self) -> Option<T> {
        return self.items.pop()
    }

    def get(self, i: usize) -> T {
        return self.items.get(i)
    }

    def set(self, i: usize, v: T) {
        self.items.set(i, v)
    }

    def len(self) -> usize {
        return self.items.len()
    }

    def clear(self) {
        self.items.clear()
    }
}
