# Pair is the ordered key/value pair exposed by std/container.
struct Pair<A, B> {
    first: A
    second: B
}

# Tree is an ordered map. Keys are kept sorted by Ord; iteration order is
# deterministic.
class Tree<K: Ord, V> {
    keys_list: list[K]
    values_list: list[V]

    def init(self) {
        self.keys_list = list[K](0usize)
        self.values_list = list[V](0usize)
    }

    def get(self, k: K) -> Option<V> {
        var i: usize = 0usize
        while i < self.keys_list.len() {
            var current: K = self.keys_list.get(i)
            if current < k {
                i += 1usize
                continue
            }
            if k < current {
                return None
            }
            return Some(self.values_list.get(i))
        }
        return None
    }

    def set(self, k: K, v: V) -> Option<V> {
        var i: usize = 0usize
        while i < self.keys_list.len() {
            var current: K = self.keys_list.get(i)
            if current < k {
                i += 1usize
                continue
            }
            if k < current {
                break
            }
            var old: V = self.values_list.get(i)
            self.values_list.set(i, v.clone())
            return Some(old)
        }
        self.keys_list.insert(i, k.clone())
        self.values_list.insert(i, v.clone())
        return None
    }

    def delete(self, k: K) -> Option<V> {
        var i: usize = 0usize
        while i < self.keys_list.len() {
            var current: K = self.keys_list.get(i)
            if current < k {
                i += 1usize
                continue
            }
            if k < current {
                return None
            }
            var old: V = self.values_list.get(i)
            self.keys_list.remove(i)
            self.values_list.remove(i)
            return Some(old)
        }
        return None
    }

    def len(self) -> usize {
        return self.keys_list.len()
    }

    def clear(self) {
        self.keys_list.clear()
        self.values_list.clear()
    }

    def keys(self) -> list[K] {
        return self.keys_list.clone()
    }

    def values(self) -> list[V] {
        return self.values_list.clone()
    }
}
