# Stack is a LIFO container backed by a growable list.
class Stack<T> {
    items: list[T]

    def init(self, capacity: usize) {
        self.items = list[T](capacity)
    }

    def push(self, v: T) {
        self.items.push(v)
    }

    def pop(self) -> Option<T> {
        return self.items.pop()
    }

    def peek(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        return Some(self.items.get(self.items.len() - 1usize))
    }

    def len(self) -> usize {
        return self.items.len()
    }

    def clear(self) {
        self.items.clear()
    }

    def clone(self) -> Stack<T> {
        var out: Stack<T> = Stack<T>(0usize)
        out.items = self.items.clone()
        return out
    }
}
