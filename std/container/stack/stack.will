# Stack is an explicit work stack. Push, Pop, Peek, and Len are constant time;
# Reserve and Clone copy the live elements once.
struct Stack<T> {
    items: list[T]

    def init(self) {
        self.items = list[T](0)
    }

    def push(self, v: T) {
        self.items.push(v)
    }

    def pop(self) -> Option<T> {
        return self.items.pop()
    }

    def peek(self) -> Option<T> {
        var n: usize = self.items.len()
        if n == 0 {
            return None
        }
        return Some(self.items.get(n - 1))
    }

    def len(self) -> usize {
        return self.items.len()
    }

    def clear(self) {
        self.items.clear()
    }

    def reserve(self, n: usize) {
        self.items.reserve(n)
    }

    def clone(self) -> Stack<T> {
        var out: Stack<T>
        out.items = self.items.clone()
        return out
    }
}
















