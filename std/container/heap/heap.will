# Heap is a max heap over an Ord element type.
class Heap<T: Ord> {
    items: list[T]

    def init(self, capacity: usize) {
        self.items = list[T](capacity)
    }

    def push(self, v: T) {
        self.items.push(v)
        var i: usize = self.items.len() - 1usize
        while i > 0usize {
            var parent: usize = (i - 1usize) / 2usize
            if self.items.get(parent) >= self.items.get(i) {
                break
            }
            var tmp: T = self.items.get(parent)
            self.items.set(parent, self.items.get(i))
            self.items.set(i, tmp)
            i = parent
        }
    }

    def pop(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        var root: T = self.items.get(0usize)
        var last: T = self.items.pop()!
        if self.items.len() > 0usize {
            self.items.set(0usize, last)
            var i: usize = 0usize
            while True {
                var left: usize = i * 2usize + 1usize
                if left >= self.items.len() {
                    break
                }
                var best: usize = left
                var right: usize = left + 1usize
                if right < self.items.len() {
                    if self.items.get(right) > self.items.get(left) {
                        best = right
                    }
                }
                if self.items.get(i) >= self.items.get(best) {
                    break
                }
                var tmp: T = self.items.get(i)
                self.items.set(i, self.items.get(best))
                self.items.set(best, tmp)
                i = best
            }
        }
        return Some(root)
    }

    def peek(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        return Some(self.items.get(0usize))
    }

    def len(self) -> usize {
        return self.items.len()
    }

    def clear(self) {
        self.items.clear()
    }
}
