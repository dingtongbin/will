# Heap is a binary min-heap. The comparison function decides the order, so the
# same structure serves integer, text, and user-defined priorities.
struct Heap<T> {
    items: list[T]
    less: func(T, T) -> bool

    def init(self, less: func(T, T) -> bool) {
        self.items = list[T](0)
        self.less = less
    }

    def push(self, v: T) {
        self.items.push(v)
        var cmp: func(T, T) -> bool = self.less
        var i: usize = self.items.len() - 1usize
        while True {
            if i == 0usize {
                break
            }
            var parent: usize = (i - 1usize) / 2usize
            var childValue: T = self.items.get(i)
            var parentValue: T = self.items.get(parent)
            if not cmp(childValue, parentValue) {
                break
            }
            self.items.set(i, parentValue)
            self.items.set(parent, childValue)
            i = parent
        }
    }

    def pop(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        var cmp: func(T, T) -> bool = self.less
        var top: T = self.items.get(0usize)
        match self.items.pop() {
            Some(last) => {
                if self.items.len() > 0usize {
                    self.items.set(0usize, last)
                    var i: usize = 0usize
                    while True {
                        var left: usize = i * 2usize + 1usize
                        if left >= self.items.len() {
                            break
                        }
                        var smallest: usize = left
                        var right: usize = left + 1usize
                        if right < self.items.len() {
                            var leftValue: T = self.items.get(left)
                            var rightValue: T = self.items.get(right)
                            if cmp(rightValue, leftValue) {
                                smallest = right
                            }
                        }
                        var smallValue: T = self.items.get(smallest)
                        var current: T = self.items.get(i)
                        if not cmp(smallValue, current) {
                            break
                        }
                        self.items.set(i, smallValue)
                        self.items.set(smallest, current)
                        i = smallest
                    }
                }
            }
            None => {
            }
        }
        return Some(top)
    }

    def peek(self) -> Option<T> {
        if self.items.len() == 0usize {
            return None
        }
        return Some(self.items.get(0usize))
    }

    def len(self) -> usize {
        return self.items.len()
    }
}










