# Ring is a fixed-capacity FIFO. A full ring overwrites its oldest value and
# returns that value to the caller.
class Ring<T> {
    front: list[T]
    back: list[T]
    cap: usize

    def init(self, capacity: usize) {
        self.front = list[T](0)
        self.back = list[T](0)
        self.cap = capacity
    }

    def push(self, v: T) -> Option<T> {
        if self.cap == 0usize {
            return Some(v)
        }
        var evicted: Option<T> = None
        if self.len() >= self.cap {
            evicted = self.pop()
        }
        self.back.push(v)
        return evicted
    }

    def pop(self) -> Option<T> {
        if self.front.len() > 0 {
            return self.front.pop()
        }
        if self.back.len() == 0 {
            return None
        }
        while True {
            if self.back.len() == 0 {
                break
            }
            match self.back.pop() {
                Some(v) => {
                    self.front.push(v)
                }
                None => {
                    break
                }
            }
        }
        return self.front.pop()
    }

    def peek(self) -> Option<T> {
        if self.front.len() > 0 {
            return Some(self.front.get(self.front.len() - 1))
        }
        if self.back.len() == 0 {
            return None
        }
        return Some(self.back.get(0))
    }

    def len(self) -> usize {
        return self.front.len() + self.back.len()
    }

    def clear(self) {
        self.front.clear()
        self.back.clear()
    }
}
