# ringError is the concrete Error returned by a zero-capacity constructor.
struct ringError {
    message: str
}

def (e: ringError) message() -> str {
    return e.message
}

def (e: ringError) status() -> i32 {
    return 2
}

# Ring is a fixed-capacity FIFO. A full ring rejects the value instead of
# overwriting the oldest one, so the caller decides which policy to use.
struct Ring<T> {
    front: Array<T>
    back: Array<T>
    cap: usize
}

# init reserves the two stacks used by the ring. A zero capacity is invalid.
def (mut r: Ring<T>) init(cap: usize) -> Result<(), Error> {
    if cap == 0usize {
        return Err(ringError { message: "ring capacity must be positive" })
    }
    r.front = new Array<T>(0)
    r.back = new Array<T>(0)
    r.cap = cap
    return Ok(())
}

# Push adds one value at the back. It returns false when the ring is full.
def (mut r: Ring<T>) push(v: T) -> bool {
    if r.len() >= r.cap {
        return False
    }
    r.back.push(v)
    return True
}

# Pop removes and returns the front value, or None when the ring is empty.
def (mut r: Ring<T>) pop() -> Option<T> {
    if r.front.len() > 0 {
        return r.front.pop()
    }
    if r.back.len() == 0 {
        return None
    }
    while True {
        if r.back.len() == 0 {
            break
        }
        match r.back.pop() {
            Some(v) => {
                r.front.push(v)
            }
            None => {
                break
            }
        }
    }
    return r.front.pop()
}

# Peek returns a copy of the front value without removing it.
def (r: Ring<T>) peek() -> Option<T> {
    if r.front.len() > 0 {
        return Some(r.front.get(r.front.len() - 1))
    }
    if r.back.len() == 0 {
        return None
    }
    return Some(r.back.get(0))
}

# Len reports the number of stored values.
def (r: Ring<T>) len() -> usize {
    return r.front.len() + r.back.len()
}

# Full reports whether no more values fit.
def (r: Ring<T>) full() -> bool {
    return r.len() >= r.cap
}

# Clear releases every value and keeps the capacity setting.
def (mut r: Ring<T>) clear() {
    r.front.clear()
    r.back.clear()
}
