# Queue is a FIFO backed by two stacks. Push and Pop are amortized constant
# time; Peek copies the front value without removing it.
struct Queue<T> {
    front: list[T]
    back: list[T]

    def init(self) {
        self.front = list[T](0)
        self.back = list[T](0)
    }

    def push(self, v: T) {
        self.back.push(v)
    }

    def pop(self) -> Option<T> {
        if self.front.len() > 0 {
            return self.front.pop()
        }
        if self.back.len() == 0 {
            return None
        }
        while True {
            if self.back.len() == 0 {
                break
            }
            match self.back.pop() {
                Some(v) => {
                    self.front.push(v)
                }
                None => {
                    break
                }
            }
        }
        return self.front.pop()
    }

    def peek(self) -> Option<T> {
        if self.front.len() > 0 {
            return Some(self.front.get(self.front.len() - 1))
        }
        if self.back.len() == 0 {
            return None
        }
        return Some(self.back.get(0))
    }

    def len(self) -> usize {
        return self.front.len() + self.back.len()
    }

    def clear(self) {
        self.front.clear()
        self.back.clear()
    }
}












