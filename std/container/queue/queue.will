// Queue is a FIFO backed by two stacks. Push and Pop are amortized constant
// time; Peek copies the front value without removing it.
struct Queue<T> {
    front: Array<T>
    back: Array<T>
}

// init starts both stacks empty. A later Push grows the back stack.
func (mut q: Queue<T>) init() {
    q.front = new Array<T>(0)
    q.back = new Array<T>(0)
}

// Push adds one value at the back.
func (mut q: Queue<T>) Push(v: T) {
    q.back.Push(v)
}

// Pop removes and returns the front value, or None when the queue is empty.
func (mut q: Queue<T>) Pop() -> Option<T> {
    if q.front.Len() > 0 {
        return q.front.Pop()
    }
    if q.back.Len() == 0 {
        return None
    }
    for {
        if q.back.Len() == 0 {
            break
        }
        match q.back.Pop() {
            Some(v) => {
                q.front.Push(v)
            }
            None => {
                break
            }
        }
    }
    return q.front.Pop()
}

// Peek returns a copy of the front value without removing it.
func (q: Queue<T>) Peek() -> Option<T> {
    if q.front.Len() > 0 {
        return Some(q.front.Get(q.front.Len() - 1))
    }
    if q.back.Len() == 0 {
        return None
    }
    return Some(q.back.Get(0))
}

// Len reports the number of stored values.
func (q: Queue<T>) Len() -> usize {
    return q.front.Len() + q.back.Len()
}

// Clear releases every value.
func (mut q: Queue<T>) Clear() {
    q.front.Clear()
    q.back.Clear()
}
