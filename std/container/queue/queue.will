# Queue is a FIFO container. The front list is drained first; pushing after a
# partial drain still appends behind the older values.
class Queue<T> {
    front: list[T]
    back: list[T]

    def init(self, capacity: usize) {
        self.front = list[T](capacity)
        self.back = list[T](capacity)
    }

    def push(self, v: T) {
        self.back.push(v)
    }

    def pop(self) -> Option<T> {
        if self.front.len() == 0usize {
            while self.back.len() > 0usize {
                match self.back.pop() {
                    Some(v) => {
                        self.front.push(v)
                    }
                    None => {
                        break
                    }
                }
            }
        }
        return self.front.pop()
    }

    def peek(self) -> Option<T> {
        if self.front.len() > 0usize {
            return Some(self.front.get(self.front.len() - 1usize))
        }
        if self.back.len() == 0usize {
            return None
        }
        return Some(self.back.get(0usize))
    }

    def len(self) -> usize {
        return self.front.len() + self.back.len()
    }

    def clear(self) {
        self.front.clear()
        self.back.clear()
    }
}
